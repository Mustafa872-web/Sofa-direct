        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "t:settings_schema.typography.settings.body_scale.label",
        "default": 100
      },
      {
        "type": "header",
        "content": "Display / Hero Font"
      },
      {
        "type": "text",
        "id": "sd_font_display",
        "label": "Display font name",
        "default": "Playfair Display",
        "info": "Enter a font-family name exactly as it appears in CSS. Default: 'Playfair Display'. Upload 'Recoleta' to theme assets and enter 'Recoleta' for the Figma design font."
      }
    ]
  },
  {
    "name": "Third-party Apps (Performance)",
    "settings": [
      {
        "type": "paragraph",
        "content": "Toggle which third-party chat / messaging apps load on the storefront. Turning them OFF blocks their scripts from running and improves PageSpeed (TBT / LCP). Turn back ON when you want the widget available to shoppers."
      },
      {
        "type": "checkbox",
        "id": "sd_enable_gorgias",
        "label": "Enable Gorgias Live Chat",
        "default": false,
        "info": "When OFF, the Gorgias chat widget is blocked from loading on every page. Default: OFF."
      },
      {
        "type": "checkbox",
        "id": "sd_enable_shopify_inbox",
        "label": "Enable Shopify Inbox (Messaging)",
        "default": false,
        "info": "When OFF, the Shopify Inbox chat bubble is blocked from loading. Default: OFF (avoids duplicate chat widget when Gorgias is enabled)."
      },
      {
        "type": "checkbox",
        "id": "sd_enable_klaviyo",
        "label": "Enable Klaviyo (Email + Tracking)",
        "default": true,
        "info": "Klaviyo collects emails, fires tracking events and shows popups. Default: ON. Turn OFF only if you want to suppress all Klaviyo scripts (~50KB and analytics requests) on the storefront."
      },
      {
        "type": "checkbox",
        "id": "sd_enable_cookease",
        "label": "Enable Cookease (Cookie Consent banner)",
        "default": true,
        "info": "Cookease shows the cookie-consent banner. Default: ON (required for GDPR/EU compliance). Turn OFF only if you switch to a different consent solution or do not need consent for your market."
      },
      {
        "type": "checkbox",
        "id": "sd_enable_kbite",
        "label": "Enable Kbite Back-in-Stock notifier",
        "default": true,
        "info": "Kbite adds a 'notify me when in stock' form to sold-out variants. Default: ON. Turning OFF blocks the script everywhere, but the form is only useful on product pages with sold-out variants."
      }
    ]
  },
  {
    "name": "Display Font (Recoleta)",
    "settings": [
      {
        "type": "paragraph",
        "content": "Toggle the Recoleta display font on/off. ⚠ The Recoleta files currently in /assets are Fontspring DEMO trial files which embed a 'DEMO' watermark in the glyphs. When ON, that watermark may appear in headings. Turn OFF to fall back to Playfair Display (Google Fonts, fully licensed) until licensed Recoleta files are uploaded."
      },
      {
        "type": "checkbox",
        "id": "sd_enable_recoleta",
        "label": "Enable Recoleta display font",
        "default": false,
        "info": "OFF by default because the Recoleta files currently in /assets are Fontspring DEMO trial fonts that embed a 'DEMO' watermark inside glyphs. Headings fall through to Playfair Display (Google Fonts, fully licensed). Turn ON once you upload a licensed Recoleta to /assets."
      }
    ]
  },
