      "blocks": {
        "h1": {
          "type": "heading",
          "settings": {
            "text": "Start with your sofa’s dimensions"
          }
        },
        "r1": {
          "type": "richtext",
          "settings": {
            "body": "<p>Measure <strong>width × height × depth</strong> — everything else depends on these.</p><p><strong>Width:</strong> Left to right (facing the sofa)<br/><strong>Height:</strong> Floor to the highest point (including cushions)<br/><strong>Depth:</strong> Front to back<br/></p>"
          }
        },
        "richtext_nh9frG": {
          "type": "richtext",
          "settings": {
            "body": "<p><strong>Tip:</strong> Measure the actual sofa — not the packaging. Packaging can add 2–4 inches per side.</p><p>Also note anything that reduces usable space:</p><ul><li>Radiators</li><li>Plug sockets</li><li>Window ledges</li><li>Skirting or protrusions</li></ul>"
          }
        },
        "h2": {
          "type": "heading",
          "settings": {
            "text": "Check the front door first"
          }
        },
        "r2": {
          "type": "richtext",
          "settings": {
            "body": "<p>Most delivery issues start here.</p><p>Measure:</p><ul><li><strong>Door width:</strong> Inner frame edge to edge</li><li><strong>Door height:</strong> Floor to top of frame</li><li><strong>Side clearance:</strong> Space near hinges for turning</li><li><strong>Front clearance:</strong> Room outside the door to manoeuvre<br/></li></ul>"
          }
        },
        "q1": {
          "type": "pullquote",
          "settings": {
            "text": "If it won’t fit through the door, it won’t fit in the room. Always check this first."
          }
        },
        "h3": {
          "type": "heading",
          "settings": {
            "text": "Then check every access point"
          }
        },
        "r3": {
          "type": "richtext",
          "settings": {
            "body": "<p>Work through the full route your sofa will take.</p>"
          }
        },
        "h4": {
          "type": "heading",
          "settings": {
            "text": "Hallways & internal doors"
          }
        },
        "r4": {
          "type": "richtext",
          "settings": {
            "body": "<ul><li>Measure the <strong>narrowest point</strong>, not the widest</li><li>Watch for tight turns and sharp angles</li></ul>"
          }
        },
        "heading_h3dd6T": {
          "type": "heading",
          "settings": {
            "text": "Staircases"
          }
        },
        "richtext_PLqJtT": {
          "type": "richtext",
          "settings": {
            "body": "<ul><li>Staircase width (tightest point)</li><li>Ceiling height/headroom</li><li>Landing space for turning</li><li>Number of turns</li></ul>"
          }
        },
        "richtext_YCEJ4V": {
          "type": "richtext",
          "settings": {
            "body": "<p><strong>Tip:</strong> If a landing is shallower than your sofa’s depth, it won’t pivot.</p>"
          }
        }
      },
