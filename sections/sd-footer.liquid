<link rel="stylesheet" href="{{ 'sd-footer.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'sd-footer.css' | asset_url | stylesheet_tag }}</noscript>

{%- liquid
  assign shop_blocks    = section.blocks | where: 'type', 'shop_link'
  assign support_blocks = section.blocks | where: 'type', 'support_link'
  assign company_blocks = section.blocks | where: 'type', 'company_link'
  assign legal_blocks   = section.blocks | where: 'type', 'legal_link'
  assign col5_blocks    = section.blocks | where: 'type', 'col5_link'
-%}

<footer class="sd-footer" role="contentinfo" aria-label="Site footer">

  {%- comment -%} Top gold accent strip {%- endcomment -%}
  <span class="sd-footer__top-accent" aria-hidden="true"></span>

  {%- comment -%} ── Main row: brand + nav ── {%- endcomment -%}
  <div class="sd-footer__main">

    {%- comment -%} Brand column {%- endcomment -%}
    <div class="sd-footer__brand">
      {%- if section.settings.logo != blank -%}
        <a href="{{ routes.root_url }}" class="sd-footer__logo-img-link" style="max-width: {{ section.settings.logo_width | default: 180 }}px" aria-label="{{ section.settings.brand_name | default: 'Home' | escape }}">
          {{ section.settings.logo | image_url: width: 480 | image_tag: class: 'sd-footer__logo-img', widths: '120,180,240,360,480', alt: section.settings.brand_name }}
        </a>
      {%- endif -%}
      {%- if section.settings.brand_name != blank -%}
        <a href="{{ routes.root_url }}" class="sd-footer__logo">
          {{- section.settings.brand_name -}}
        </a>
      {%- endif -%}
      {%- if section.settings.tagline != blank -%}
        <p class="sd-footer__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}

      {%- comment -%} Social icons row — uses theme-level settings {%- endcomment -%}
      {%- assign has_socials = false -%}
      {%- if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_twitter_link != blank or settings.social_pinterest_link != blank or settings.social_youtube_link != blank or settings.social_tiktok_link != blank -%}
        {%- assign has_socials = true -%}
      {%- endif -%}
      {%- if has_socials -%}
        <ul class="sd-footer__socials" role="list" aria-label="Follow us">
          {%- if settings.social_facebook_link != blank -%}
            <li><a href="{{ settings.social_facebook_link }}" class="sd-footer__social sd-footer__social--brand" target="_blank" rel="noopener" aria-label="Facebook">
              <svg width="100%" height="100%" viewBox="0 0 982 982" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect width="982" height="982" rx="491" fill="#C0B09F"/>
                <path d="M511.658 318.731C511.658 296.039 531.927 287.887 554.619 287.887C577.311 287.887 601.545 294.938 601.545 294.938L616.086 208.575C616.086 208.575 585.242 198 511.658 198C466.494 198 440.277 215.184 421.109 240.52C403.044 264.534 402.383 303.089 402.383 327.984V384.605H344V468.984H402.383V762H511.658V468.984H598.241L604.63 384.605H511.658V318.731Z" fill="white"/>
              </svg>
            </a></li>
          {%- endif -%}
          {%- if settings.social_instagram_link != blank -%}
            <li><a href="{{ settings.social_instagram_link }}" class="sd-footer__social sd-footer__social--brand" target="_blank" rel="noopener" aria-label="Instagram">
              <svg width="100%" height="100%" viewBox="0 0 982 982" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect width="982" height="982" rx="491" fill="#C0B09F"/>
                <path d="M636.295 315.725C617.845 315.725 604.008 329.563 604.008 348.013C604.008 366.463 617.845 380.3 636.295 380.3C654.745 380.3 668.583 366.463 668.583 348.013C668.583 329.563 654.745 315.725 636.295 315.725Z" fill="white"/>
                <path d="M490.998 357.237C414.892 357.237 354.93 419.506 354.93 493.306C354.93 567.106 417.198 629.375 490.998 629.375C564.798 629.375 627.067 567.106 627.067 493.306C627.067 419.506 567.105 357.237 490.998 357.237ZM490.998 580.944C442.567 580.944 403.361 541.737 403.361 493.306C403.361 444.875 442.567 405.669 490.998 405.669C539.43 405.669 578.636 444.875 578.636 493.306C578.636 541.737 539.43 580.944 490.998 580.944Z" fill="white"/>
                <path d="M601.7 214.25H382.606C288.05 214.25 214.25 288.05 214.25 380.3V599.394C214.25 691.644 288.05 765.444 380.3 765.444H599.394C691.644 765.444 765.444 691.644 765.444 599.394V380.3C767.75 288.05 693.95 214.25 601.7 214.25ZM714.706 601.7C714.706 663.969 663.969 717.012 599.394 717.012H380.3C318.031 717.012 264.987 666.275 264.987 601.7V382.606C264.987 320.338 315.725 267.294 380.3 267.294H599.394C661.663 267.294 714.706 318.031 714.706 382.606V601.7Z" fill="white"/>
              </svg>
            </a></li>
          {%- endif -%}
          {%- if settings.social_twitter_link != blank -%}
            <li><a href="{{ settings.social_twitter_link }}" class="sd-footer__social" target="_blank" rel="noopener" aria-label="X / Twitter">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a></li>
          {%- endif -%}
          {%- if settings.social_pinterest_link != blank -%}
            <li><a href="{{ settings.social_pinterest_link }}" class="sd-footer__social" target="_blank" rel="noopener" aria-label="Pinterest">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0a12 12 0 00-4.37 23.17c-.1-.94-.2-2.43.04-3.48.22-.95 1.4-6.04 1.4-6.04s-.36-.72-.36-1.78c0-1.67.97-2.92 2.18-2.92 1.03 0 1.52.77 1.52 1.7 0 1.03-.66 2.58-1 4.01-.29 1.2.6 2.18 1.79 2.18 2.15 0 3.8-2.27 3.8-5.54 0-2.9-2.08-4.92-5.06-4.92-3.44 0-5.46 2.58-5.46 5.25 0 1.04.4 2.16.9 2.77.1.12.11.22.08.34l-.33 1.34c-.05.22-.17.27-.4.16-1.5-.7-2.42-2.88-2.42-4.64 0-3.78 2.74-7.25 7.9-7.25 4.15 0 7.37 2.96 7.37 6.91 0 4.12-2.6 7.44-6.21 7.44-1.21 0-2.35-.63-2.74-1.37l-.75 2.85c-.27 1.04-1 2.35-1.49 3.15A12 12 0 1012 0z"/></svg>
            </a></li>
          {%- endif -%}
          {%- if settings.social_youtube_link != blank -%}
            <li><a href="{{ settings.social_youtube_link }}" class="sd-footer__social" target="_blank" rel="noopener" aria-label="YouTube">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 00-2.12-2.13C19.55 3.5 12 3.5 12 3.5s-7.55 0-9.38.57A3 3 0 00.5 6.2 31 31 0 000 12a31 31 0 00.5 5.8 3 3 0 002.12 2.13c1.83.57 9.38.57 9.38.57s7.55 0 9.38-.57a3 3 0 002.12-2.13A31 31 0 0024 12a31 31 0 00-.5-5.8zM9.6 15.6V8.4l6.27 3.6z"/></svg>
            </a></li>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <li><a href="{{ settings.social_tiktok_link }}" class="sd-footer__social sd-footer__social--brand" target="_blank" rel="noopener" aria-label="TikTok">
              <svg width="100%" height="100%" viewBox="0 0 982 982" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect width="982" height="982" rx="491" fill="#C0B09F"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M504.033 225.258C533.2 224.812 562.144 225.035 591.088 224.812C592.869 258.879 605.115 293.613 630.05 317.659C654.987 342.374 690.166 353.729 724.453 357.514V447.243C692.392 446.13 660.108 439.45 630.941 425.646C618.25 419.857 606.45 412.509 594.872 404.939C594.65 469.954 595.096 534.969 594.428 599.761C592.646 630.932 582.404 661.882 564.37 687.486C535.204 730.236 484.663 758.067 432.786 758.958C400.948 760.739 369.109 752.056 341.946 736.025C296.972 709.529 265.356 660.991 260.68 608.89C260.235 597.757 260.012 586.624 260.457 575.715C264.465 533.41 285.394 492.887 317.901 465.278C354.859 433.216 406.513 417.853 454.828 426.982C455.273 459.935 453.938 492.887 453.938 525.84C431.895 518.715 406.068 520.719 386.698 534.078C372.671 543.207 361.985 557.234 356.418 573.043C351.743 584.398 353.079 596.866 353.301 608.89C358.645 645.405 393.823 676.131 431.228 672.791C456.164 672.569 479.987 658.096 492.901 636.944C497.131 629.596 501.806 622.026 502.029 613.343C504.256 573.488 503.365 533.856 503.588 494.001C503.81 404.271 503.365 314.765 504.033 225.258Z" fill="white"/>
              </svg>
            </a></li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>

    {%- comment -%} ── Nav columns — each column is hidden when it has no links ── {%- endcomment -%}
    <nav class="sd-footer__nav" aria-label="Footer">

      {%- comment -%} SHOP {%- endcomment -%}
      {%- assign col1_menu = linklists[section.settings.col1_menu] -%}
      {%- if col1_menu.links.size > 0 or shop_blocks.size > 0 -%}
        <div class="sd-footer__col">
          <p class="sd-footer__col-heading">{{ section.settings.col1_heading | default: 'Shop' }}</p>
          <ul class="sd-footer__links">
            {%- if col1_menu.links.size > 0 -%}
              {%- for link in col1_menu.links -%}
                <li><a href="{{ link.url }}" class="sd-footer__link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              {%- for block in shop_blocks -%}
                <li><a href="{{ block.settings.url }}" class="sd-footer__link" {{ block.shopify_attributes }}>{{ block.settings.label }}</a></li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}

      {%- comment -%} SUPPORT {%- endcomment -%}
      {%- assign col2_menu = linklists[section.settings.col2_menu] -%}
      {%- if col2_menu.links.size > 0 or support_blocks.size > 0 -%}
        <div class="sd-footer__col">
          <p class="sd-footer__col-heading">{{ section.settings.col2_heading | default: 'Support' }}</p>
          <ul class="sd-footer__links">
            {%- if col2_menu.links.size > 0 -%}
              {%- for link in col2_menu.links -%}
                <li><a href="{{ link.url }}" class="sd-footer__link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              {%- for block in support_blocks -%}
                <li><a href="{{ block.settings.url }}" class="sd-footer__link" {{ block.shopify_attributes }}>{{ block.settings.label }}</a></li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}

      {%- comment -%} COMPANY {%- endcomment -%}
      {%- assign col3_menu = linklists[section.settings.col3_menu] -%}
      {%- if col3_menu.links.size > 0 or company_blocks.size > 0 -%}
        <div class="sd-footer__col">
          <p class="sd-footer__col-heading">{{ section.settings.col3_heading | default: 'Company' }}</p>
          <ul class="sd-footer__links">
            {%- if col3_menu.links.size > 0 -%}
              {%- for link in col3_menu.links -%}
                <li><a href="{{ link.url }}" class="sd-footer__link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              {%- for block in company_blocks -%}
                <li><a href="{{ block.settings.url }}" class="sd-footer__link" {{ block.shopify_attributes }}>{{ block.settings.label }}</a></li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}

      {%- comment -%} LEGAL {%- endcomment -%}
      {%- assign col4_menu = linklists[section.settings.col4_menu] -%}
      {%- if col4_menu.links.size > 0 or legal_blocks.size > 0 -%}
        <div class="sd-footer__col">
          <p class="sd-footer__col-heading">{{ section.settings.col4_heading | default: 'Legal' }}</p>
          <ul class="sd-footer__links">
            {%- if col4_menu.links.size > 0 -%}
              {%- for link in col4_menu.links -%}
                <li><a href="{{ link.url }}" class="sd-footer__link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              {%- for block in legal_blocks -%}
                <li><a href="{{ block.settings.url }}" class="sd-footer__link" {{ block.shopify_attributes }}>{{ block.settings.label }}</a></li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}

      {%- comment -%} COLUMN 5 {%- endcomment -%}
      {%- assign col5_menu = linklists[section.settings.col5_menu] -%}
      {%- if col5_menu.links.size > 0 or col5_blocks.size > 0 -%}
        <div class="sd-footer__col">
          <p class="sd-footer__col-heading">{{ section.settings.col5_heading | default: 'More' }}</p>
          <ul class="sd-footer__links">
            {%- if col5_menu.links.size > 0 -%}
              {%- for link in col5_menu.links -%}
                <li><a href="{{ link.url }}" class="sd-footer__link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              {%- for block in col5_blocks -%}
                <li><a href="{{ block.settings.url }}" class="sd-footer__link" {{ block.shopify_attributes }}>{{ block.settings.label }}</a></li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}

    </nav>

    {%- comment -%} ── Newsletter (right side) ── {%- endcomment -%}
    {%- if section.settings.show_newsletter -%}
      <div class="sd-footer__newsletter">
        <p class="sd-footer__col-heading sd-footer__news-heading">{{ section.settings.newsletter_heading | default: 'Join our newsletter' }}</p>
        {%- if section.settings.newsletter_text != blank -%}
          <p class="sd-footer__news-text">{{ section.settings.newsletter_text }}</p>
        {%- endif -%}
        {%- form 'customer', class: 'sd-footer__news-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="sd-footer__news-field">
            <input
              type="email"
              name="contact[email]"
              class="sd-footer__news-input"
              placeholder="{{ section.settings.newsletter_placeholder | default: 'Email address' }}"
              aria-label="Email address"
              autocorrect="off"
              autocapitalize="off"
              required>
            <button type="submit" class="sd-footer__news-btn" aria-label="Subscribe">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="sd-footer__news-note sd-footer__news-note--ok">Thanks for subscribing.</p>
          {%- elsif form.errors -%}
            <p class="sd-footer__news-note sd-footer__news-note--err">{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

  </div>

  {%- comment -%} ── Bottom bar ── {%- endcomment -%}
  <div class="sd-footer__bottom">
    <p class="sd-footer__copy">
      &copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'Sofa Direct' }}. All rights reserved.
    </p>

    {%- comment -%} Payment method icons — desktop only via CSS {%- endcomment -%}
    {%- if section.settings.show_payments -%}
      <ul class="sd-footer__payments" role="list" aria-label="Accepted payment methods">
        <li class="sd-footer__pay" title="Visa"><svg viewBox="0 0 38 24" width="38" height="24" aria-hidden="true"><rect width="38" height="24" rx="4" fill="#fff"/><path d="M15.5 16h-2l1.3-8h2L15.5 16zm6.4-7.8c-.4-.2-1.1-.4-1.9-.4-2.1 0-3.6 1.1-3.6 2.7 0 1.2 1.1 1.8 2 2.2.9.4 1.2.6 1.2.95 0 .5-.6.7-1.2.7-.8 0-1.2-.1-1.8-.4l-.3-.1-.3 1.8c.5.2 1.3.4 2.2.4 2.3 0 3.7-1.1 3.7-2.8 0-.9-.6-1.6-1.8-2.2-.8-.4-1.3-.6-1.3-1 0-.3.4-.7 1.2-.7.7 0 1.2.1 1.5.3l.2.1.4-1.5zM27 8h-1.6c-.5 0-.9.1-1.1.7L21.5 16h2.3l.5-1.3h2.7l.3 1.3h2L27 8zm-3 6 .9-2.5c0 0 .2-.5.3-.8l.2.8.5 2.5h-1.9zM12 8l-2.2 5.4-.2-1.2c-.4-1.4-1.7-3-3.1-3.7L8.4 16h2.3l3.4-8H12z" fill="#1A1F71"/></svg></li>
        <li class="sd-footer__pay" title="Mastercard"><svg viewBox="0 0 38 24" width="38" height="24" aria-hidden="true"><rect width="38" height="24" rx="4" fill="#fff"/><circle cx="15" cy="12" r="6" fill="#EB001B"/><circle cx="23" cy="12" r="6" fill="#F79E1B"/><path d="M19 7a6 6 0 010 10 6 6 0 010-10z" fill="#FF5F00"/></svg></li>
        <li class="sd-footer__pay" title="American Express"><svg viewBox="0 0 38 24" width="38" height="24" aria-hidden="true"><rect width="38" height="24" rx="4" fill="#006FCF"/><text x="19" y="15" text-anchor="middle" fill="#fff" font-family="Arial,sans-serif" font-size="6" font-weight="900" letter-spacing="0.4">AMEX</text></svg></li>
        <li class="sd-footer__pay" title="PayPal"><svg viewBox="0 0 38 24" width="38" height="24" aria-hidden="true"><rect width="38" height="24" rx="4" fill="#fff"/><path d="M12 6h4.5c2.3 0 3.4 1.4 3 3.5-.4 2.3-2.1 3.5-4.4 3.5h-1.5l-.6 4H10.5L12 6zm1.5 5h1.3c1.1 0 1.8-.5 2-1.5.2-1-.3-1.5-1.4-1.5h-1.3L13.5 11z" fill="#003087"/><path d="M19 8h4.5c2.3 0 3.4 1.4 3 3.5-.4 2.3-2.1 3.5-4.4 3.5h-1.5l-.6 4h-2.5L19 8zm1.5 5h1.3c1.1 0 1.8-.5 2-1.5.2-1-.3-1.5-1.4-1.5h-1.3l-.6 3z" fill="#009CDE"/></svg></li>
        <li class="sd-footer__pay" title="Apple Pay"><svg viewBox="0 0 38 24" width="38" height="24" aria-hidden="true"><rect width="38" height="24" rx="4" fill="#000"/><path d="M11.5 8.5c.3-.4.5-1 .4-1.5-.5 0-1 .3-1.4.7-.3.4-.5.9-.4 1.4.5 0 1.1-.3 1.4-.6zm.4.7c-.7 0-1.3.4-1.6.4-.3 0-.9-.4-1.5-.4-.8 0-1.5.5-1.9 1.2-.8 1.4-.2 3.5.6 4.6.4.5.9 1.2 1.5 1.2.6 0 .8-.4 1.5-.4s.9.4 1.5.4c.6 0 1-.5 1.4-1.1.4-.6.6-1.2.6-1.2s-1.2-.4-1.2-1.8c0-1.2 1-1.8 1-1.8s-.6-1.1-1.9-1.1zM18 8h3.5c1.8 0 3 1.2 3 2.9 0 1.8-1.2 3-3 3H20l-.4 2.1H18L18 8zm1.8 3.5h1.2c.9 0 1.4-.5 1.4-1.3 0-.7-.5-1.2-1.4-1.2h-1.2v2.5zM27 14.5c-.4 0-.8-.2-.8-.6 0-.4.4-.6 1.1-.6h1v.6c0 .3-.5.6-1.3.6zM27.5 10c-1.6 0-2.5.8-2.6 2.1h1.4c.1-.5.5-.8 1.2-.8.7 0 1.1.3 1.1.9v.4h-1.4c-1.5 0-2.4.6-2.4 1.7 0 1.1.9 1.8 2 1.8.8 0 1.4-.4 1.7-.9h.1v.9h1.4v-3.8c0-1.4-.9-2.3-2.5-2.3z" fill="#fff"/></svg></li>
        <li class="sd-footer__pay" title="Klarna"><svg viewBox="0 0 38 24" width="38" height="24" aria-hidden="true"><rect width="38" height="24" rx="4" fill="#FFA8CD"/><text x="19" y="15.5" text-anchor="middle" fill="#000" font-family="Arial,sans-serif" font-size="6.5" font-weight="800">Klarna.</text></svg></li>
      </ul>
    {%- endif -%}

    {%- if section.settings.registration_text != blank -%}
      <p class="sd-footer__reg">{{ section.settings.registration_text }}</p>
    {%- endif -%}
  </div>

</footer>

{% schema %}
{
  "name": "SD Footer",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Optional. Shown above the brand name."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 180
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Sofa Direct"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Quality sofas for everyday living. Designed for UK homes, delivered direct to your door."
    },
    {
      "type": "header",
      "content": "Column Headings"
    },
    {
      "type": "text",
      "id": "col1_heading",
      "label": "Column 1 heading",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "col2_heading",
      "label": "Column 2 heading",
      "default": "Support"
    },
    {
      "type": "text",
      "id": "col3_heading",
