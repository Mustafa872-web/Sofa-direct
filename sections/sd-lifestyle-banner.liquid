<link rel="stylesheet" href="{{ 'sd-lifestyle-banner.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'sd-lifestyle-banner.css' | asset_url | stylesheet_tag }}</noscript>

{%- liquid
  assign overlay_alpha = section.settings.overlay_opacity | default: 60 | divided_by: 100.0
-%}

<section
  id="sd-lbanner-{{ section.id }}"
  class="sd-lbanner"
  style="--lbanner-height: {{ section.settings.min_height | default: 50 }}vh; position:relative; overflow:hidden; min-height:var(--lbanner-height,50vh);"
  aria-label="{{ section.settings.heading | strip_html | escape }}"
>

  {%- comment -%} ── Background image (desktop + mobile via <picture>) ── {%- endcomment -%}
  <div class="sd-lbanner__bg" aria-hidden="true" style="position:absolute;inset:0;z-index:0;overflow:hidden;">
    {%- liquid
      assign has_desktop = false
      assign has_mobile  = false
      if section.settings.image != blank or section.settings.asset_image != blank
        assign has_desktop = true
      endif
      if section.settings.mobile_image != blank or section.settings.mobile_asset_image != blank
        assign has_mobile = true
      endif
    -%}

    {%- if has_desktop or has_mobile -%}
      <picture>
        {%- if has_mobile -%}
          {%- if section.settings.mobile_image != blank -%}
            <source media="(max-width: 749px)"
              srcset="{{ section.settings.mobile_image | image_url: width: 440 }} 440w,
                      {{ section.settings.mobile_image | image_url: width: 750 }} 750w,
                      {{ section.settings.mobile_image | image_url: width: 990 }} 990w"
              sizes="100vw">
          {%- else -%}
            <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_asset_image | asset_url }}">
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.image != blank -%}
          {%- assign bg_alt = section.settings.image.alt | default: '' | escape -%}
          <img
            src="{{ section.settings.image | image_url: width: 1920 }}"
            srcset="{{ section.settings.image | image_url: width: 750 }} 750w,
                    {{ section.settings.image | image_url: width: 990 }} 990w,
                    {{ section.settings.image | image_url: width: 1200 }} 1200w,
                    {{ section.settings.image | image_url: width: 1500 }} 1500w,
                    {{ section.settings.image | image_url: width: 1920 }} 1920w"
            sizes="100vw"
            class="sd-lbanner__bg-img"
            alt="{{ bg_alt }}"
            loading="lazy"
            fetchpriority="low"
            width="1920" height="1080">
        {%- elsif section.settings.asset_image != blank -%}
          <img src="{{ section.settings.asset_image | asset_url }}" class="sd-lbanner__bg-img" alt="" loading="lazy" width="1920" height="1080">
        {%- elsif has_mobile -%}
          {%- comment -%} mobile-only: reuse mobile as fallback for desktop slot {%- endcomment -%}
          {%- if section.settings.mobile_image != blank -%}
            <img src="{{ section.settings.mobile_image | image_url: width: 1200 }}" class="sd-lbanner__bg-img" alt="" loading="lazy" width="1200" height="800">
          {%- else -%}
            <img src="{{ section.settings.mobile_asset_image | asset_url }}" class="sd-lbanner__bg-img" alt="" loading="lazy" width="1200" height="800">
          {%- endif -%}
        {%- endif -%}
      </picture>
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'sd-lbanner__bg-img sd-lbanner__placeholder' }}
    {%- endif -%}

    {%- comment -%}
      Overlay: --overlay-alpha controls the END stop of the gradient directly.
      This preserves the Figma gradient shape (transparent → dark) at any opacity,
      unlike setting element opacity which collapses the whole gradient uniformly.
    {%- endcomment -%}
    <div
      class="sd-lbanner__overlay"
      style="--overlay-alpha: {{ overlay_alpha }};"
      aria-hidden="true"
    ></div>
  </div>

  {%- comment -%} ── Content ── {%- endcomment -%}
  <div class="sd-lbanner__content">

    <div class="sd-lbanner__left">

      {%- if section.settings.heading != blank -%}
        <h2 class="sd-lbanner__heading">
          {{- section.settings.heading | newline_to_br -}}
        </h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank or section.settings.body_text != blank -%}
        <div class="sd-lbanner__text-block">
          {%- if section.settings.subheading != blank -%}
            <p class="sd-lbanner__subheading">{{ section.settings.subheading }}</p>
          {%- endif -%}
          {%- if section.settings.body_text != blank -%}
            <p class="sd-lbanner__body">{{ section.settings.body_text }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>

    {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
      <div class="sd-lbanner__right">
        <a
          href="{{ section.settings.cta_url }}"
          class="sd-lbanner__cta"
          aria-label="{{ section.settings.cta_label | escape }}"
        >
          {{- section.settings.cta_label -}}
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    {%- endif -%}

  </div>

</section>

<script>
(function () {
  var section = document.getElementById('sd-lbanner-{{ section.id }}');
  if (!section) return;

  function activate() {
    section.classList.add('is-visible');
  }

  if ('IntersectionObserver' in window) {
    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            activate();
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08 }
    );
    observer.observe(section);
  } else {
    activate();
  }
})();
</script>

{% schema %}
{
  "name": "SD Lifestyle Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Image & Overlay"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop background image (Shopify media — overrides asset image)"
    },
    {
      "type": "text",
      "id": "asset_image",
      "label": "Desktop background image filename (assets folder)",
      "info": "Upload image to theme assets folder and enter filename e.g. sd-lifestyle-relax.jpg — works on local dev without re-uploading"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile background image (Shopify media — shown on ≤749px)"
    },
    {
      "type": "text",
      "id": "mobile_asset_image",
      "label": "Mobile background image filename (assets folder)",
      "info": "Used on mobile only (≤749px). If empty, desktop image is used on all viewports."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 60,
      "unit": "%",
      "label": "Overlay darkness (Figma: 60%)"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 30,
      "max": 100,
      "step": 5,
      "default": 50,
      "unit": "vh",
      "label": "Section height"
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading (one word per line for stacked look)",
      "default": "Relax\nScroll\nUnwind"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub-heading (bold, below heading)",
      "default": "Made to Lounge Longer"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body paragraph (below sub-heading)",
      "default": "Sink into soft fabric seating made for laid-back evenings, lazy weekends and everything in between."
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop Comfy Collection"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "SD Lifestyle Banner",
      "settings": {
        "heading": "Relax\nScroll\nUnwind",
        "subheading": "Made to Lounge Longer",
        "body_text": "Sink into soft fabric seating made for laid-back evenings, lazy weekends and everything in between.",
        "cta_label": "Shop Comfy Collection",
        "overlay_opacity": 60,
        "min_height": 50
      }
    }
  ]
}
{% endschema %}
