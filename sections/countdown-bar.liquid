nnouncement__subline{font-size:10px;font-weight:500;letter-spacing:0}.countdown-announcement__timer{width:calc(50% - 79px)}.countdown-announcement__headline{font-size:11px;line-height:14px;letter-spacing:-.4px}.countdown-announcement__inner{padding:8px 6px;row-gap:2px;column-gap:5px;justify-content:space-between}}@media (max-width:350px){.countdown-announcement__timer{width:calc(50% - 64px)}.countdown-announcement__headline{font-size:9px;line-height:14px;letter-spacing:-.4px}.countdown-announcement__subline{font-size:8px;font-weight:500;letter-spacing:0}.countdown-announcement__text{width:140px}.countdown-announcement__timer{width:110px}}</style>

<style>
  /* CLS-proof — fixed (not min) heights so font swap cannot grow the bar */
  #shopify-section-{{ section.id }}{display:block;height:73.5px;contain:layout size}
  #shopify-section-{{ section.id }} .countdown-announcement{
    height:73.5px;display:flex;align-items:center;justify-content:center;
    box-sizing:border-box;overflow:hidden;contain:layout
  }
  #shopify-section-{{ section.id }} .countdown-announcement__inner{height:73.5px;overflow:hidden}
  #shopify-section-{{ section.id }} .countdown-announcement__text{
    overflow:hidden;line-height:1.2;
    font-family:var(--font-heading-family),system-ui,Arial,sans-serif;
    font-size-adjust:0.5;
  }
  #shopify-section-{{ section.id }} .countdown-announcement__headline,
  #shopify-section-{{ section.id }} .countdown-announcement__subline{
    line-height:1.2;height:1.2em;overflow:hidden
  }
  @media(max-width:749px){
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} .countdown-announcement,
    #shopify-section-{{ section.id }} .countdown-announcement__inner{height:80px}
  }
  @media(max-width:680px){
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} .countdown-announcement,
    #shopify-section-{{ section.id }} .countdown-announcement__inner{height:45px}
  }
  @media(min-width:681px){
    .countdown-announcement__subline.mobile-text{display:none}
  }
  @media(max-width:680px){
    .countdown-announcement__subline.desktop-txt{display:none}
    .countdown-announcement{min-height:45px}
  }
  @media(max-width:380px){
    .countdown-announcement__subline{font-size:9px}
  }
</style>
<script src="{{ 'component-countdown-announcement.js' | asset_url }}" defer="defer"></script>

{%- if section.settings.enabled -%}
  <div
    class="countdown-announcement"
    data-end-datetime="{{ section.settings.end_datetime }}"
    data-daily-mode="{{ section.settings.daily_mode }}"
    data-daily-start-hour="{{ section.settings.daily_start_hour }}"
    data-daily-end-hour="{{ section.settings.daily_end_hour }}"
    data-daily-subline="{{ section.settings.daily_subline }}"
    data-timezone="{{ section.settings.timezone | default: 'Europe/London' }}"
    data-dismiss-key="countdown-announcement-{{ section.id }}"
    style="
      --countdown-bg: {{ section.settings.background_color }};
      --countdown-text: {{ section.settings.text_color }};
      --countdown-button-bg: {{ section.settings.button_bg_color }};
      --countdown-button-text: {{ section.settings.button_text_color }};
    "
  >
    <div class="page-width countdown-announcement__inner">
      <div class="countdown-announcement__text">
        <div class="countdown-announcement__headline">
          {{ section.settings.headline | escape }}
        </div>
        <div class="countdown-announcement__subline desktop-txt">
          {{ section.settings.subline | escape }}
        </div>
        <div class="countdown-announcement__subline mobile-text">
          {{ section.settings.sublinem | escape }}
        </div>
      </div>

      <div class="countdown-announcement__timer" aria-live="polite">
        <div class="countdown-announcement__segment">
          <div class="countdown-announcement__value" data-part="days">00</div>
          <div class="countdown-announcement__label">days</div>
        </div>
        <div class="countdown-announcement__separator">:</div>
        <div class="countdown-announcement__segment">
          <div class="countdown-announcement__value" data-part="hours">00</div>
          <div class="countdown-announcement__label">hours</div>
        </div>
        <div class="countdown-announcement__separator">:</div>
        <div class="countdown-announcement__segment">
          <div class="countdown-announcement__value" data-part="mins">00</div>
          <div class="countdown-announcement__label">mins</div>
        </div>
        <div class="countdown-announcement__separator">:</div>
        <div class="countdown-announcement__segment">
          <div class="countdown-announcement__value" data-part="secs">00</div>
          <div class="countdown-announcement__label">secs</div>
        </div>
      </div>

      {%- liquid
        assign cta_link = section.settings.button_link
        if cta_link == blank and product and product.url != blank
          assign cta_link = product.url
        endif
      -%}

      {%- if section.settings.button_label != blank and cta_link != blank -%}
        <a class="countdown-announcement__cta" href="{{ cta_link }}">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.show_close -%}
      <button
        class="countdown-announcement__close"
        type="button"
        aria-label="Close"
      >
        &times;
      </button>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Countdown bar",
  "class": "countdown-announcement-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable",
      "default": true
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "NEW YEAR SALE, ALL STOCK MUST GO"
    },
    {
      "type": "text",
      "id": "subline",
      "label": "Subline",
      "default": "SAVE AN EXTRA 5% WITH CODE BF5"
    },
    {
      "type": "text",
      "id": "sublinem",
      "label": "Subline for mobile",
      "default": "SAVE AN EXTRA 5% WITH CODE BF5"
    },
    {
      "type": "text",
      "id": "end_datetime",
      "label": "End datetime (YYYY-MM-DD HH:MM:SS)",
      "default": "2026-12-31 23:59:59"
    },
    {
      "type": "checkbox",
      "id": "daily_mode",
      "label": "Use daily schedule",
      "default": true
    },
    {
      "type": "number",
      "id": "daily_start_hour",
      "label": "Daily start hour (0-24)",
      "default": 1
    },
    {
      "type": "number",
      "id": "daily_end_hour",
      "label": "Daily end hour (0-24, use 24 for midnight)",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "daily_subline",
      "label": "Show hours remaining in subline",
      "default": true
    },
    {
      "type": "text",
      "id": "timezone",
      "label": "Time zone (IANA)",
      "default": "Europe/London"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "Show close button",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#b11616"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "Countdown bar"
    }
  ]
}
{% endschema %}
