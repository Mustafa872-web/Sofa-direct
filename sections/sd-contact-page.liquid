<link rel="stylesheet" href="{{ 'sd-contact-page.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'sd-contact-page.css' | asset_url | stylesheet_tag }}</noscript>

{%- liquid
  assign hero_heading = section.settings.hero_heading
  if hero_heading == blank
    assign hero_heading = page.title | default: 'Contact Us'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="sd-contact section-{{ section.id }}-padding">
  <div class="sd-contact__shape sd-contact__shape--one" aria-hidden="true"></div>
  <div class="sd-contact__shape sd-contact__shape--two" aria-hidden="true"></div>

  <div class="sd-contact__container page-width">
    <div class="sd-contact__hero">
      <div class="sd-contact__hero-copy">
        {%- if section.settings.hero_badge != blank -%}
          <span class="sd-contact__badge">{{ section.settings.hero_badge }}</span>
        {%- endif -%}

        <h1 class="sd-contact__title">{{ hero_heading }}</h1>

        {%- if section.settings.hero_body != blank -%}
          <p class="sd-contact__subtitle">{{ section.settings.hero_body }}</p>
        {%- endif -%}

        {%- if page.content != blank -%}
          <div class="sd-contact__page-content rte">
            {{ page.content }}
          </div>
        {%- endif -%}
      </div>

      <div class="sd-contact__hero-media{% if section.settings.hero_image_mobile != blank %} sd-contact__hero-media--has-mobile{% endif %}">
        {%- if section.settings.hero_image != blank -%}
          {{
            section.settings.hero_image
            | image_url: width: 1200
            | image_tag:
              class: 'sd-contact__hero-image sd-contact__hero-image--desktop',
              widths: '600,900,1200',
              sizes: '(min-width: 990px) 38vw, 100vw',
              alt: section.settings.hero_image.alt | default: 'Contact Sofa Direct',
              loading: 'lazy'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'sd-contact__hero-image sd-contact__hero-image--desktop' }}
        {%- endif -%}

        {%- if section.settings.hero_image_mobile != blank -%}
          {{
            section.settings.hero_image_mobile
            | image_url: width: 900
            | image_tag:
              class: 'sd-contact__hero-image sd-contact__hero-image--mobile',
              widths: '375,550,750,900',
              sizes: '100vw',
              alt: section.settings.hero_image_mobile.alt | default: 'Contact Sofa Direct',
              loading: 'lazy'
          }}
        {%- endif -%}
      </div>
    </div>

    <div class="sd-contact__layout">
      <aside class="sd-contact__info">
        <h2 class="sd-contact__panel-title">{{ section.settings.methods_heading }}</h2>

        <div class="sd-contact__methods">
          {%- for block in section.blocks -%}
            {%- if block.type == 'method' -%}
              <article class="sd-contact__method-card" {{ block.shopify_attributes }}>
                <span class="sd-contact__method-icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'phone' -%}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.7 19.7 0 0 1-8.6-3.1 19.3 19.3 0 0 1-6-6A19.7 19.7 0 0 1 2.1 4.1 2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1.8.3 1.5.6 2.2a2 2 0 0 1-.4 2.1L8 9.2a16 16 0 0 0 6.8 6.8l1.2-1.2a2 2 0 0 1 2.1-.4c.7.3 1.4.5 2.2.6A2 2 0 0 1 22 16.9Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {%- when 'email' -%}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.8"/><path d="m22 7-10 7L2 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {%- when 'location' -%}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M21 10c0 6-9 12-9 12S3 16 3 10a9 9 0 1 1 18 0Z" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="1.8"/></svg>
                    {%- when 'chat' -%}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M12 8v4M12 16h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                  {%- endcase -%}
                </span>

                <div class="sd-contact__method-copy">
                  {%- if block.settings.title != blank -%}
                    <h3 class="sd-contact__method-title">{{ block.settings.title }}</h3>
                  {%- endif -%}

                  {%- if block.settings.value != blank -%}
                    {%- if block.settings.url != blank -%}
                      <a href="{{ block.settings.url }}" class="sd-contact__method-value">{{ block.settings.value }}</a>
                    {%- else -%}
                      <p class="sd-contact__method-value">{{ block.settings.value }}</p>
                    {%- endif -%}
                  {%- endif -%}

                  {%- if block.settings.detail != blank -%}
                    <p class="sd-contact__method-detail">{{ block.settings.detail }}</p>
                  {%- endif -%}
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="sd-contact__quick-help">
          <h3 class="sd-contact__quick-help-title">{{ section.settings.quick_help_heading }}</h3>
          <div class="sd-contact__quick-help-links">
            {%- for block in section.blocks -%}
              {%- if block.type == 'quick_help' -%}
                <a href="{{ block.settings.url | default: '#' }}" class="sd-contact__quick-help-link" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </aside>

      <div class="sd-contact__form-panel">
        <h2 class="sd-contact__panel-title">{{ section.settings.form_heading }}</h2>

        {%- if section.settings.form_text != blank -%}
          <p class="sd-contact__form-intro">{{ section.settings.form_text }}</p>
        {%- endif -%}

        {%- form 'contact', id: 'SDContactForm', class: 'sd-contact__form' -%}
          {%- if form.posted_successfully? -%}
            <p class="sd-contact__form-status sd-contact__form-status--success" tabindex="-1" autofocus>
              Thanks, we received your message and will reply shortly.
            </p>
          {%- elsif form.errors -%}
            <p class="sd-contact__form-status sd-contact__form-status--error" role="alert" tabindex="-1" autofocus>
              Please check your details and try again.
            </p>
          {%- endif -%}

          <div class="sd-contact__field-row">
            <div class="sd-contact__field-wrap">
              <label class="sd-contact__label" for="SDContact-name">Full name</label>
              <input
                id="SDContact-name"
                class="sd-contact__input"
                type="text"
                name="contact[name]"
                autocomplete="name"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="Your name"
              >
            </div>

            <div class="sd-contact__field-wrap">
              <label class="sd-contact__label" for="SDContact-email">Email address</label>
              <input
                id="SDContact-email"
                class="sd-contact__input"
                type="email"
                name="contact[email]"
                autocomplete="email"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                placeholder="you@example.com"
                required
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="SDContact-email-error"
                {% endif %}
              >
              {%- if form.errors contains 'email' -%}
                <small id="SDContact-email-error" class="sd-contact__field-error">
                  {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                </small>
              {%- endif -%}
            </div>
          </div>

          <div class="sd-contact__field-row">
            <div class="sd-contact__field-wrap">
              <label class="sd-contact__label" for="SDContact-phone">Phone (optional)</label>
              <input
                id="SDContact-phone"
                class="sd-contact__input"
                type="tel"
                name="contact[phone]"
                autocomplete="tel"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                placeholder="+44 ..."
              >
            </div>

            <div class="sd-contact__field-wrap">
              <label class="sd-contact__label" for="SDContact-subject">Reason</label>
              <select id="SDContact-subject" class="sd-contact__select" name="contact[Subject]">
                <option value="General enquiry">General enquiry</option>
                <option value="Order support">Order support</option>
                <option value="Delivery update">Delivery update</option>
                <option value="Returns and refunds">Returns and refunds</option>
              </select>
            </div>
          </div>

          <div class="sd-contact__field-wrap">
            <label class="sd-contact__label" for="SDContact-message">Message</label>
            <textarea
              id="SDContact-message"
              class="sd-contact__textarea"
              name="contact[body]"
              rows="6"
              placeholder="Tell us how we can help..."
            >{{- form.body -}}</textarea>
          </div>

          <button type="submit" class="sd-contact__submit">
            {{ section.settings.submit_label }}
            <span aria-hidden="true">-></span>
          </button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SD Contact Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "hero_badge",
      "label": "Hero badge",
      "default": "Contact Sofa Direct"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "We're Here To Help You Find The Right Sofa"
    },
    {
      "type": "textarea",
      "id": "hero_body",
      "label": "Hero text",
      "default": "Questions about styles, delivery, financing, or care tips? Reach out and our team will guide you with clear answers and no pressure."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Hero image (mobile)"
    },
    {
      "type": "text",
      "id": "methods_heading",
      "label": "Contact methods heading",
      "default": "Ways To Reach Us"
    },
    {
      "type": "text",
      "id": "quick_help_heading",
      "label": "Quick help heading",
      "default": "Quick Help"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Send Us A Message"
    },
    {
      "type": "textarea",
      "id": "form_text",
      "label": "Form text",
      "default": "We usually respond within one business day."
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit label",
      "default": "Send message"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "method",
      "name": "Contact method",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "phone",
          "options": [
            { "value": "phone", "label": "Phone" },
            { "value": "email", "label": "Email" },
            { "value": "location", "label": "Location" },
            { "value": "chat", "label": "Chat" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Phone"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "+44 20 1234 5678"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail",
          "default": "Mon-Sat, 9:00 AM - 6:00 PM"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link (optional)"
        }
      ]
    },
    {
      "type": "quick_help",
      "name": "Quick help link",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Delivery information"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "SD Contact Page",
      "blocks": [
        {
          "type": "method",
          "settings": {
            "icon": "phone",
            "title": "Call us",
            "value": "+44 20 1234 5678",
            "detail": "Mon-Sat, 9:00 AM - 6:00 PM"
          }
        },
        {
          "type": "method",
          "settings": {
            "icon": "email",
            "title": "Email us",
            "value": "sales@sofa-direct.co.uk",
            "detail": "We reply within one business day"
          }
        },
        {
          "type": "method",
          "settings": {
            "icon": "location",
            "title": "Visit showroom",
            "value": "221B Baker Street, London",
            "detail": "By appointment and walk-ins"
          }
        },
        {
          "type": "quick_help",
          "settings": {
            "text": "Delivery information"
          }
        },
        {
          "type": "quick_help",
          "settings": {
            "text": "Returns and refunds"
          }
        },
        {
          "type": "quick_help",
          "settings": {
            "text": "Finance options"
          }
        }
      ]
    }
  ]
}
{% endschema %}
