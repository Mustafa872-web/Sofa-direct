{%- comment -%}
  Product-page Add-ons section — dynamic by collection.

  Layout: always renders exactly 3 add-on cards:
    1. Addon 1            — fixed product (e.g. Premier Delivery Service)
    2. Care Plan (slot)   — collection-matched product (selected via blocks)
    3. Addon 3            — fixed product (e.g. Sofa Removal)

  How the Care Plan slot is resolved:
    - Each "Care plan rule" block in this section has a collection + a product.
    - If the current product belongs to a block's collection, that block's
      product is shown in slot 2.
    - First matching block wins. If no block matches, the section's
      "Default care plan" product is used.

  Hidden everywhere else: products tagged "none sale item" are filtered out
  of collection grids, search, related lists, and recently viewed.
{%- endcomment -%}

<link rel="stylesheet" href="{{ 'sd-product-addons.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'sd-product-addons.css' | asset_url | stylesheet_tag }}</noscript>

{%- comment -%} ── Resolve the Care Plan product for the current sofa ── {%- endcomment -%}
{%- assign care_plan_product = blank -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'care_plan_rule' and care_plan_product == blank -%}
    {%- assign rule_coll = block.settings.rule_collection -%}
    {%- assign rule_prod = block.settings.rule_product -%}
    {%- if rule_coll != blank and rule_prod != blank -%}
      {%- for c in product.collections -%}
        {%- if c.handle == rule_coll.handle -%}
          {%- assign care_plan_product = rule_prod -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- if care_plan_product == blank -%}
  {%- assign care_plan_product = section.settings.addon_2_default -%}
{%- endif -%}

{%- comment -%}
  product/collection settings return OBJECTS in Liquid, not handles. Use them
  directly. Fallback: if a setting ever yields a handle string (.id is blank),
  resolve it via all_products so the section keeps working either way.
{%- endcomment -%}
{%- assign addon_1 = section.settings.addon_1_product -%}
{%- if addon_1 != blank and addon_1.id == blank -%}{%- assign addon_1 = all_products[addon_1] -%}{%- endif -%}

{%- assign addon_2 = care_plan_product -%}
{%- if addon_2 != blank and addon_2.id == blank -%}{%- assign addon_2 = all_products[addon_2] -%}{%- endif -%}

{%- assign addon_3 = section.settings.addon_3_product -%}
{%- if addon_3 != blank and addon_3.id == blank -%}{%- assign addon_3 = all_products[addon_3] -%}{%- endif -%}

{%- assign has_any = false -%}
{%- if addon_1 != blank or addon_2 != blank or addon_3 != blank -%}{%- assign has_any = true -%}{%- endif -%}

{%- if has_any -%}
  <section
    class="sd-addons"
    data-section-id="{{ section.id }}"
    style="padding-top:{{ section.settings.padding_top }}px; padding-bottom:{{ section.settings.padding_bottom }}px;"
  >
    <div class="sd-addons__inner">
      {%- if section.settings.eyebrow != blank -%}
        <span class="sd-addons__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="sd-addons__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="sd-addons__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <div class="sd-addons__grid">
        {%- assign addons = '' | split: ',' -%}
        {%- assign addons = addons | concat: addon_1 | default: addons -%}
        {%- comment -%} Liquid can't easily build product arrays — render each slot inline {%- endcomment -%}

        {%- for slot_idx in (1..3) -%}
          {%- case slot_idx -%}
            {%- when 1 -%}{%- assign p = addon_1 -%}
            {%- when 2 -%}{%- assign p = addon_2 -%}
            {%- when 3 -%}{%- assign p = addon_3 -%}
          {%- endcase -%}

          {%- if p != blank -%}
            {%- assign v = p.selected_or_first_available_variant -%}
            {%- assign has_options = false -%}
            {%- if p.has_only_default_variant == false -%}{%- assign has_options = true -%}{%- endif -%}

            <article class="sd-addons__card">
              <a class="sd-addons__media-link" href="{{ p.url }}" aria-label="{{ p.title | escape }}">
                {%- if p.featured_image -%}
                  {{- p.featured_image
                      | image_url: width: 400
                      | image_tag:
                          loading: 'lazy',
                          widths: '200,300,400',
                          sizes: '(min-width:990px) 18vw, 45vw',
                          alt: p.title,
                          class: 'sd-addons__img' -}}
                {%- endif -%}
              </a>
              <div class="sd-addons__body">
                <a class="sd-addons__name" href="{{ p.url }}">{{ p.title }}</a>
                {%- if p.metafields.custom.short_description != blank -%}
                  <p class="sd-addons__desc">{{ p.metafields.custom.short_description }}</p>
                {%- endif -%}
                <div class="sd-addons__row">
                  <span class="sd-addons__price">{{ v.price | money }}</span>
                  <button
                    type="button"
                    class="sd-addons__btn"
                    data-addon-add
                    data-variant-id="{{ v.id }}"
                    data-product-url="{{ p.url }}"
                    {% unless v.available %}disabled{% endunless %}
                    {% if has_options %}data-needs-options="1"{% endif %}
                  >
                    {%- if v.available == false -%}Sold out
                    {%- elsif has_options -%}Choose options
                    {%- else -%}+ Add
                    {%- endif -%}
                  </button>
                </div>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <script>
  (function(){
    var root = document.querySelector('.sd-addons[data-section-id="{{ section.id }}"]');
    if (!root) return;
    var shopRoot = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) ? window.Shopify.routes.root : '/';

    root.querySelectorAll('[data-addon-add]').forEach(function(btn){
      btn.addEventListener('click', function(e){
        e.preventDefault();
        if (btn.dataset.needsOptions === '1') {
          window.location.href = btn.dataset.productUrl;
          return;
        }
        var id = btn.dataset.variantId;
        if (!id || btn.dataset.loading === '1') return;
        btn.dataset.loading = '1';
        var orig = btn.textContent;
        btn.textContent = 'Adding…';
        btn.disabled = true;

        var fd = new FormData();
        fd.append('id', id);
        fd.append('quantity', '1');

        var cartContainer = document.querySelector('cart-drawer') || document.querySelector('cart-notification');
        if (cartContainer && typeof cartContainer.getSectionsToRender === 'function') {
          var ids = cartContainer.getSectionsToRender().map(function(s){ return s.id; }).join(',');
          fd.append('sections', ids);
          fd.append('sections_url', window.location.pathname);
        }

        fetch(shopRoot + 'cart/add.js', {
          method: 'POST',
          headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
          body: fd
        })
        .then(function(r){ return r.text().then(function(t){
          var d = {}; try { d = JSON.parse(t); } catch(e){}
          return { ok: r.ok, data: d };
        });})
        .then(function(res){
          btn.dataset.loading = '0';
          btn.disabled = false;
          if (!res.ok) {
            btn.textContent = 'Try again';
            setTimeout(function(){ btn.textContent = orig; }, 2000);
            return;
          }
          btn.textContent = 'Added ✓';
          fetch(shopRoot + 'cart.js', { headers: { 'Accept': 'application/json' } })
            .then(function(r){ return r.json(); })
            .then(function(cart){
              document.querySelectorAll('[data-cart-count], .cart-count-bubble span[aria-hidden="true"]').forEach(function(el){
                el.textContent = cart.item_count;
              });
            }).catch(function(){});
          if (cartContainer) {
            try {
              if (res.data.sections && typeof cartContainer.renderContents === 'function') {
                cartContainer.renderContents(res.data);
              }
              if (typeof cartContainer.open === 'function') cartContainer.open();
            } catch(e){}
          }
          setTimeout(function(){ btn.textContent = orig; }, 2000);
        })
        .catch(function(){
          btn.dataset.loading = '0';
          btn.disabled = false;
          btn.textContent = 'Try again';
          setTimeout(function(){ btn.textContent = orig; }, 2000);
        });
      });
    });
  })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Product Add-ons",
  "tag": "section",
  "class": "sd-addons-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Three add-on cards: slots 1 and 3 are fixed products. Slot 2 (the Care Plan) is matched to the current product's collection via the rule blocks below."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Complete your order"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Add-ons"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Fixed add-ons (shown on every product)"
    },
    {
      "type": "product",
      "id": "addon_1_product",
      "label": "Slot 1 product (e.g. Premier Delivery Service)"
    },
    {
      "type": "product",
      "id": "addon_3_product",
      "label": "Slot 3 product (e.g. Sofa Removal)"
    },
    {
      "type": "header",
      "content": "Care Plan — default"
    },
    {
      "type": "paragraph",
      "content": "Used in slot 2 when the current product does not match any of the Care plan rule blocks below."
    },
    {
      "type": "product",
      "id": "addon_2_default",
      "label": "Default care plan product"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "care_plan_rule",
      "name": "Care plan rule",
      "settings": [
        {
          "type": "paragraph",
          "content": "If the current product belongs to the chosen collection, the chosen care-plan product is shown in slot 2. First matching block wins."
        },
        {
          "type": "collection",
          "id": "rule_collection",
          "label": "Match this collection"
        },
        {
          "type": "product",
          "id": "rule_product",
          "label": "Care plan product to show"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Add-ons",
      "blocks": [
        { "type": "care_plan_rule" },
        { "type": "care_plan_rule" },
        { "type": "care_plan_rule" }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
