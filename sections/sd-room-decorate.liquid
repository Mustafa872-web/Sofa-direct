function applyLightMode() {
  const presets = {
    day:     { amb: [0xFFE8D0, 0.50], hemi: [0xFFF5E6, 0x8B7355, 0.40], dir: [0xFFF0D8, 1.80], fill: [0xE0E8F0, 0.30], bg: 0xF5F0E8 },
    evening: { amb: [0xFFD0A0, 0.32], hemi: [0xFFB888, 0x6B5440, 0.25], dir: [0xFFA060, 0.85], fill: [0xC0A878, 0.18], bg: 0xE8D4B8 },
    night:   { amb: [0x4A5878, 0.18], hemi: [0x3A4860, 0x1A2030, 0.18], dir: [0x6878A0, 0.20], fill: [0x4A5070, 0.10], bg: 0x1F2838 }
  };
  const p = presets[lightMode] || presets.day;
  ambientLight.color.setHex(p.amb[0]); ambientLight.intensity = p.amb[1];
  hemiLight.color.setHex(p.hemi[0]); hemiLight.groundColor.setHex(p.hemi[1]); hemiLight.intensity = p.hemi[2];
  dirLight.color.setHex(p.dir[0]);   dirLight.intensity = p.dir[1];
  fillLight.color.setHex(p.fill[0]); fillLight.intensity = p.fill[1];
  scene.background = new THREE.Color(p.bg);
  // Ceiling lights — much brighter, dramatically brighter at night
  ceilingLights.forEach(l => {
    l.intensity = ceilingOn ? (lightMode === 'night' ? 2.6 : lightMode === 'evening' ? 1.8 : 1.2) : 0;
  });
}

function makeFloorTexture(style) {
  const c = document.createElement('canvas'); c.width = 512; c.height = 512;
  const ctx = c.getContext('2d');
  let base, streak, plankW = 64, repeat = roomW / 2;

  if (style === 'wood-dark') {
    base = '#4A2E18'; streak = 'rgba(20,10,5,';
  } else if (style === 'wood-natural') {
    base = '#C8A578'; streak = 'rgba(80,55,30,';
  } else if (style === 'wood-walnut') {
    base = '#5E3A1E'; streak = 'rgba(28,15,8,';
  } else if (style === 'wood-mahogany') {
    base = '#6A2818'; streak = 'rgba(45,15,8,';
  } else if (style === 'whitewashed') {
    base = '#E0D6C2'; streak = 'rgba(180,160,135,';
  } else if (style === 'oak') {
    base = '#B89668'; streak = 'rgba(70,45,20,';
  } else if (style === 'herringbone') {
    ctx.fillStyle = '#B89668'; ctx.fillRect(0, 0, 512, 512);
    const bw = 128, bh = 32;
    let offset = 0;
    for (let y = 0; y < 512; y += bh) {
      for (let x = -bw; x < 512 + bw; x += bw) {
        ctx.save();
        ctx.translate(x + offset, y + bh/2);
        ctx.rotate((Math.floor(offset/bw + y/bh)%2 === 0) ? Math.PI/4 : -Math.PI/4);
        const grain = Math.random()*20 - 10;
        ctx.fillStyle = `rgb(${184+grain|0},${150+grain|0},${104+grain|0})`;
        ctx.fillRect(-bw/2, -bh/2, bw, bh);
        ctx.strokeStyle = 'rgba(40,25,10,0.3)';
        ctx.strokeRect(-bw/2, -bh/2, bw, bh);
        ctx.restore();
      }
      offset += bw/2;
    }
    const t = new THREE.CanvasTexture(c); t.wrapS = t.wrapT = THREE.RepeatWrapping;
    t.repeat.set(roomW / 3, roomD / 3); return t;
  } else if (style === 'marble-dark') {
    ctx.fillStyle = '#1A1A20'; ctx.fillRect(0, 0, 512, 512);
    for (let i = 0; i < 30; i++) {
      ctx.strokeStyle = `rgba(220,220,230,${Math.random()*0.45+0.1})`;
      ctx.lineWidth = Math.random()*1.5 + 0.3;
      ctx.beginPath();
      let x = Math.random()*512, y = Math.random()*512;
      ctx.moveTo(x, y);
      for (let s = 0; s < 30; s++) { x += (Math.random()-.5)*40; y += (Math.random()-.5)*40; ctx.lineTo(x, y); }
      ctx.stroke();
    }
    const t = new THREE.CanvasTexture(c); t.wrapS = t.wrapT = THREE.RepeatWrapping;
    t.repeat.set(roomW / 3, roomD / 3); return t;
  } else if (style === 'tile-cream') {
    ctx.fillStyle = '#D8CCB0'; ctx.fillRect(0, 0, 512, 512);
    const tile = 128;
    for (let y = 0; y < 512; y += tile) for (let x = 0; x < 512; x += tile) {
      ctx.fillStyle = `rgba(${230+Math.random()*15|0},${220+Math.random()*15|0},${198+Math.random()*15|0},1)`;
      ctx.fillRect(x+3, y+3, tile-6, tile-6);
    }
    const t = new THREE.CanvasTexture(c); t.wrapS = t.wrapT = THREE.RepeatWrapping;
    t.repeat.set(roomW, roomD); return t;
  } else if (style === 'carpet-cream') {
    ctx.fillStyle = '#EADCC0'; ctx.fillRect(0, 0, 512, 512);
    for (let i = 0; i < 3000; i++) {
      const tone = Math.random()*40+200;
      ctx.fillStyle = `rgba(${tone|0},${(tone-12)|0},${(tone-35)|0},0.4)`;
      ctx.fillRect(Math.random()*512, Math.random()*512, 1.5, 1.5);
    }
    const t = new THREE.CanvasTexture(c); t.wrapS = t.wrapT = THREE.RepeatWrapping;
    t.repeat.set(roomW * 1.5, roomD * 1.5); return t;
  } else if (style === 'terracotta') {
    ctx.fillStyle = '#B8623A'; ctx.fillRect(0, 0, 512, 512);
    const tile = 96;
    for (let y = 0; y < 512; y += tile) for (let x = 0; x < 512; x += tile) {
      const offsetX = (Math.floor(y/tile) % 2) * tile/2;
      const tone = Math.random()*30 - 10;
      ctx.fillStyle = `rgb(${200+tone|0},${108+tone|0},${64+tone|0})`;
      ctx.fillRect(x + offsetX + 2, y + 2, tile - 4, tile - 4);
      ctx.strokeStyle = 'rgba(80,30,15,0.4)';
      ctx.strokeRect(x + offsetX + 2, y + 2, tile - 4, tile - 4);
    }
    const t = new THREE.CanvasTexture(c); t.wrapS = t.wrapT = THREE.RepeatWrapping;
    t.repeat.set(roomW / 1.5, roomD / 1.5); return t;
  } else if (style === 'marble') {
    ctx.fillStyle = '#F2EDE3'; ctx.fillRect(0, 0, 512, 512);
    for (let i = 0; i < 25; i++) {
      ctx.strokeStyle = `rgba(170,160,145,${Math.random()*0.35+0.05})`;
      ctx.lineWidth = Math.random() * 1.5 + 0.3;
      ctx.beginPath();
      let x = Math.random()*512, y = Math.random()*512;
      ctx.moveTo(x, y);
      for (let s = 0; s < 30; s++) { x += (Math.random()-.5)*40; y += (Math.random()-.5)*40; ctx.lineTo(x, y); }
      ctx.stroke();
    }
    const t = new THREE.CanvasTexture(c); t.wrapS = t.wrapT = THREE.RepeatWrapping;
    t.repeat.set(roomW / 3, roomD / 3); return t;
  } else if (style === 'tile-gray') {
    ctx.fillStyle = '#7A7468'; ctx.fillRect(0, 0, 512, 512);
    const tile = 128;
    for (let y = 0; y < 512; y += tile) for (let x = 0; x < 512; x += tile) {
      ctx.fillStyle = `rgba(${110+Math.random()*20|0},${104+Math.random()*20|0},${96+Math.random()*20|0},1)`;
      ctx.fillRect(x+2, y+2, tile-4, tile-4);
    }
    const t = new THREE.CanvasTexture(c); t.wrapS = t.wrapT = THREE.RepeatWrapping;
    t.repeat.set(roomW, roomD); return t;
  } else if (style === 'carpet-beige' || style === 'carpet-gray') {
    const isBeige = style === 'carpet-beige';
    ctx.fillStyle = isBeige ? '#D8C8A8' : '#A8A29A'; ctx.fillRect(0, 0, 512, 512);
    for (let i = 0; i < 3000; i++) {
      const tone = isBeige ? Math.random()*40+170 : Math.random()*30+130;
      ctx.fillStyle = `rgba(${tone|0},${(tone-15)|0},${(tone-35)|0},0.4)`;
      ctx.fillRect(Math.random()*512, Math.random()*512, 1.5, 1.5);
    }
    const t = new THREE.CanvasTexture(c); t.wrapS = t.wrapT = THREE.RepeatWrapping;
    t.repeat.set(roomW * 1.5, roomD * 1.5); return t;
  } else if (style === 'concrete') {
    ctx.fillStyle = '#A8A39C'; ctx.fillRect(0, 0, 512, 512);
    for (let i = 0; i < 8000; i++) {
      const a = Math.random()*0.3;
      ctx.fillStyle = `rgba(${100+Math.random()*60|0},${100+Math.random()*55|0},${95+Math.random()*55|0},${a})`;
      ctx.fillRect(Math.random()*512, Math.random()*512, 2, 2);
    }
    const t = new THREE.CanvasTexture(c); t.wrapS = t.wrapT = THREE.RepeatWrapping;
    t.repeat.set(roomW / 2, roomD / 2); return t;
  } else {
    base = '#B8956A'; streak = 'rgba(90,60,30,';
  }

  ctx.fillStyle = base; ctx.fillRect(0, 0, 512, 512);
  for (let i = 0; i < 60; i++) {
    const y = Math.random() * 512;
    ctx.strokeStyle = streak + (Math.random()*0.14) + ')';
    ctx.lineWidth = Math.random() * 2 + 0.5;
    ctx.beginPath(); ctx.moveTo(0, y);
    for (let x = 0; x < 512; x += 15) ctx.lineTo(x, y + Math.sin(x * 0.015 + i) * 4);
    ctx.stroke();
  }
  for (let x = 0; x < 512; x += plankW) {
    ctx.strokeStyle = `rgba(40,25,12,0.22)`; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, 512); ctx.stroke();
  }
  const t = new THREE.CanvasTexture(c);
  t.wrapS = t.wrapT = THREE.RepeatWrapping;
  t.repeat.set(repeat, roomD / 2);
  return t;
}

function makeDoor(width, height) {
  const g = new THREE.Group();
  // Wood texture for door
  const doorTex = (() => {
    const c = document.createElement('canvas'); c.width = 256; c.height = 512;
    const ctx = c.getContext('2d');
    ctx.fillStyle = '#5C3A1E'; ctx.fillRect(0,0,256,512);
    for (let i = 0; i < 80; i++) {
      ctx.strokeStyle = `rgba(30,15,5,${Math.random()*0.18})`;
      ctx.lineWidth = Math.random()*1.2 + 0.3;
      ctx.beginPath(); const y = Math.random()*512;
      ctx.moveTo(0, y);
      for (let x = 0; x < 256; x += 8) ctx.lineTo(x, y + Math.sin(x*0.02 + i)*3);
      ctx.stroke();
    }
    return new THREE.CanvasTexture(c);
  })();
  const doorMat = new THREE.MeshStandardMaterial({ map: doorTex, color: 0x6B4828, roughness: 0.6, metalness: 0.05 });
  // Door slab
  const door = new THREE.Mesh(new THREE.BoxGeometry(width, height, 0.05), doorMat);
  door.position.y = height/2; door.castShadow = true; g.add(door);
  // Recessed panels (4 panels — classic interior door style)
  const panelMat = new THREE.MeshStandardMaterial({ map: doorTex, color: 0x55381E, roughness: 0.7 });
  const pW = width * 0.72, pH = height * 0.18;
  const panelPositions = [
    [0, height * 0.82],   // top
    [0, height * 0.62],   // upper-mid
    [0, height * 0.38],   // lower-mid
    [0, height * 0.18],   // bottom (taller)
  ];
  panelPositions.forEach((p, i) => {
    const ph = i === 3 ? pH * 1.6 : pH;
    const panel = new THREE.Mesh(new THREE.BoxGeometry(pW, ph, 0.005), panelMat);
    panel.position.set(p[0], p[1], 0.028); g.add(panel);
    // Inner border (recessed lip)
    const border = new THREE.Mesh(new THREE.PlaneGeometry(pW + 0.04, ph + 0.04),
      new THREE.MeshStandardMaterial({ color: 0x3A2410, roughness: 0.8 }));
    border.position.set(p[0], p[1], 0.026); g.add(border);
  });
  // Door frame (architrave)
  const frameMat = new THREE.MeshStandardMaterial({ color: 0xF5F0E8, roughness: 0.6 });
  const fr = 0.1, fd = 0.09;
  const ft = new THREE.Mesh(new THREE.BoxGeometry(width + fr*2, fr, fd), frameMat);
  ft.position.set(0, height + fr/2, 0); g.add(ft);
  const fl = new THREE.Mesh(new THREE.BoxGeometry(fr, height + fr, fd), frameMat);
  fl.position.set(-width/2 - fr/2, height/2 + fr/2, 0); g.add(fl);
  const fr2 = fl.clone(); fr2.position.x = width/2 + fr/2; g.add(fr2);
  // Inner architrave reveal
  const rev = new THREE.Mesh(new THREE.BoxGeometry(width + 0.02, height + 0.02, 0.005),
    new THREE.MeshStandardMaterial({ color: 0xE0D8C8, roughness: 0.7 }));
  rev.position.set(0, height/2, 0.04); g.add(rev);
  // Handle assembly — back plate + lever + bolt
  const brassMat = new THREE.MeshStandardMaterial({ color: 0xC9A057, metalness: 0.85, roughness: 0.22 });
  const plate = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.16, 0.012), brassMat);
  plate.position.set(width/2 - 0.13, height * 0.46, 0.035); g.add(plate);
  const lever = new THREE.Mesh(new THREE.CylinderGeometry(0.022, 0.022, 0.13, 12), brassMat);
  lever.rotation.z = Math.PI/2;
  lever.position.set(width/2 - 0.18, height * 0.46, 0.05); g.add(lever);
  const knob = new THREE.Mesh(new THREE.SphereGeometry(0.028, 16, 12), brassMat);
  knob.position.set(width/2 - 0.245, height * 0.46, 0.05); g.add(knob);
  // Hinges (3 along left edge)
  const hingeMat = new THREE.MeshStandardMaterial({ color: 0x4A4035, metalness: 0.7, roughness: 0.4 });
  [0.15, height/2, height - 0.15].forEach(y => {
    const hinge = new THREE.Mesh(new THREE.BoxGeometry(0.04, 0.08, 0.028), hingeMat);
    hinge.position.set(-width/2 + 0.02, y, 0.028); g.add(hinge);
  });
  // Threshold (bottom strip)
  const thresh = new THREE.Mesh(new THREE.BoxGeometry(width + 0.04, 0.02, 0.06),
    new THREE.MeshStandardMaterial({ color: 0x5A4838, roughness: 0.5, metalness: 0.3 }));
  thresh.position.set(0, 0.01, 0.05); g.add(thresh);
  return g;
}

function makeWindow(width, height) {
  const g = new THREE.Group();
  // Outer architrave frame
  const frameMat = new THREE.MeshStandardMaterial({ color: 0xF5F0E8, roughness: 0.6 });
  const fr = 0.1, fd = 0.1;
  const ft = new THREE.Mesh(new THREE.BoxGeometry(width + fr*2, fr, fd), frameMat);
  ft.position.set(0, height/2 + fr/2, 0); g.add(ft);
  const fb = new THREE.Mesh(new THREE.BoxGeometry(width + fr*2, fr*1.4, fd), frameMat);
  fb.position.set(0, -height/2 - fr*0.7, 0); g.add(fb);
  const fl = new THREE.Mesh(new THREE.BoxGeometry(fr, height + fr*2, fd), frameMat);
  fl.position.set(-width/2 - fr/2, 0, 0); g.add(fl);
  const frr = fl.clone(); frr.position.x = width/2 + fr/2; g.add(frr);
  // Inner sash frame (white wood) — defines 4 panes
  const sashMat = new THREE.MeshStandardMaterial({ color: 0xFFFEFB, roughness: 0.5 });
  const sashT = 0.05;
  const sashOuterTop = new THREE.Mesh(new THREE.BoxGeometry(width - 0.02, sashT, 0.05), sashMat);
  sashOuterTop.position.set(0, height/2 - sashT/2, 0.03); g.add(sashOuterTop);
  const sashOuterBot = sashOuterTop.clone(); sashOuterBot.position.y = -height/2 + sashT/2; g.add(sashOuterBot);
  const sashOuterL = new THREE.Mesh(new THREE.BoxGeometry(sashT, height - 0.02, 0.05), sashMat);
  sashOuterL.position.set(-width/2 + sashT/2, 0, 0.03); g.add(sashOuterL);
  const sashOuterR = sashOuterL.clone(); sashOuterR.position.x = width/2 - sashT/2; g.add(sashOuterR);
  // Cross muntins (4 panes)
  const mh = new THREE.Mesh(new THREE.BoxGeometry(width - 0.02, 0.04, 0.04), sashMat);
  mh.position.z = 0.035; g.add(mh);
  const mv = new THREE.Mesh(new THREE.BoxGeometry(0.04, height - 0.02, 0.04), sashMat);
  mv.position.z = 0.035; g.add(mv);
  // Glass (4 separate panes for realism — slight gradient between them)
  const glassMat = new THREE.MeshPhysicalMaterial({
    color: 0xC4DCEC, transparent: true, opacity: 0.4,
    roughness: 0.05, metalness: 0.15, transmission: 0.65,
    clearcoat: 1, clearcoatRoughness: 0.05,
    side: THREE.DoubleSide
  });
  const paneW = (width - 0.06) / 2, paneH = (height - 0.06) / 2;
  for (let r = 0; r < 2; r++) for (let c = 0; c < 2; c++) {
    const pane = new THREE.Mesh(new THREE.PlaneGeometry(paneW, paneH), glassMat);
    pane.position.set((c - 0.5) * (paneW + 0.04), (0.5 - r) * (paneH + 0.04), 0.005);
    g.add(pane);
  }
  // Sky/outside view layer (gradient backdrop, behind glass)
  const skyCanvas = document.createElement('canvas'); skyCanvas.width = 256; skyCanvas.height = 256;
  const sctx = skyCanvas.getContext('2d');
  const skyGrad = sctx.createLinearGradient(0, 0, 0, 256);
  skyGrad.addColorStop(0, '#A8D0E8'); skyGrad.addColorStop(0.6, '#D8E8F0'); skyGrad.addColorStop(1, '#C8DCC8');
  sctx.fillStyle = skyGrad; sctx.fillRect(0, 0, 256, 256);
  // Distant trees silhouette
  sctx.fillStyle = 'rgba(80, 110, 80, 0.55)';
  for (let i = 0; i < 12; i++) {
    const x = i * 22, h = 60 + Math.random()*40;
    sctx.beginPath();
    sctx.ellipse(x, 256 - h/2, 14, h/2, 0, 0, Math.PI*2);
    sctx.fill();
  }
  const skyTex = new THREE.CanvasTexture(skyCanvas);
  const sky = new THREE.Mesh(new THREE.PlaneGeometry(width - 0.04, height - 0.04),
    new THREE.MeshBasicMaterial({ map: skyTex }));
  sky.position.z = -0.04; g.add(sky);
  // Sill (deeper, more pronounced)
  const sillMat = new THREE.MeshStandardMaterial({ color: 0xE8E0D0, roughness: 0.55 });
  const sill = new THREE.Mesh(new THREE.BoxGeometry(width + fr*3.5, 0.08, 0.22), sillMat);
  sill.position.set(0, -height/2 - fr*1.4 - 0.04, 0.06); g.add(sill);
  // Curtain rod above (decorative)
  const rodMat = new THREE.MeshStandardMaterial({ color: 0x4A3826, metalness: 0.7, roughness: 0.35 });
  const rod = new THREE.Mesh(new THREE.CylinderGeometry(0.018, 0.018, width + fr*4, 10), rodMat);
  rod.rotation.z = Math.PI/2;
  rod.position.set(0, height/2 + fr + 0.12, 0.18); g.add(rod);
  const finialL = new THREE.Mesh(new THREE.SphereGeometry(0.035, 12, 10), rodMat);
  finialL.position.set(-width/2 - fr*2, height/2 + fr + 0.12, 0.18); g.add(finialL);
  const finialR = finialL.clone(); finialR.position.x = width/2 + fr*2; g.add(finialR);
  return g;
}

function buildRoom() {
  while (roomGroup.children.length) roomGroup.remove(roomGroup.children[0]);
  ceilingLights.length = 0;
  const w = roomW, d = roomD, h = roomH;
  let floorRough = 0.65, floorMetal = 0;
  if (floorStyle === 'marble' || floorStyle === 'marble-dark') { floorRough = 0.18; floorMetal = 0.18; }
  else if (floorStyle === 'tile-gray' || floorStyle === 'tile-cream' || floorStyle === 'terracotta') { floorRough = 0.38; floorMetal = 0.05; }
  else if (floorStyle.indexOf('carpet') === 0) { floorRough = 0.95; }
  else if (floorStyle === 'concrete') { floorRough = 0.85; }
  const floorMat = new THREE.MeshStandardMaterial({ map: makeFloorTexture(floorStyle), roughness: floorRough, metalness: floorMetal });
  const floor = new THREE.Mesh(new THREE.PlaneGeometry(w, d), floorMat);
  floor.rotation.x = -Math.PI / 2; floor.receiveShadow = true; floor.name = 'floor';
  roomGroup.add(floor);
  const wallMat = new THREE.MeshStandardMaterial({ color: wallCol, roughness: 0.9, metalness: 0 });
  const bw = new THREE.Mesh(new THREE.PlaneGeometry(w, h), wallMat);
  bw.position.set(0, h/2, -d/2); bw.receiveShadow = true; roomGroup.add(bw);
  const lw = new THREE.Mesh(new THREE.PlaneGeometry(d, h), wallMat);
  lw.position.set(-w/2, h/2, 0); lw.rotation.y = Math.PI/2; lw.receiveShadow = true; roomGroup.add(lw);
  const rw = new THREE.Mesh(new THREE.PlaneGeometry(d, h), wallMat.clone());
  rw.position.set(w/2, h/2, 0); rw.rotation.y = -Math.PI/2; rw.receiveShadow = true; roomGroup.add(rw);
  const fw = new THREE.Mesh(new THREE.PlaneGeometry(w, h), new THREE.MeshStandardMaterial({ color: wallCol, roughness: 0.9, transparent: true, opacity: 0.15, side: THREE.DoubleSide }));
  fw.position.set(0, h/2, d/2); fw.rotation.y = Math.PI; roomGroup.add(fw);
  const ceil = new THREE.Mesh(new THREE.PlaneGeometry(w, d), new THREE.MeshStandardMaterial({ color: 0xFFFFF8, roughness: 1 }));
  ceil.rotation.x = Math.PI/2; ceil.position.y = h; roomGroup.add(ceil);
  const bbMat = new THREE.MeshStandardMaterial({ color: 0xF0E8D8, roughness: 0.7 });
  const bbH = 0.08;
  const bb1 = new THREE.Mesh(new THREE.BoxGeometry(w, bbH, 0.02), bbMat);
  bb1.position.set(0, bbH/2, -d/2 + 0.01); roomGroup.add(bb1);
  const bb2 = new THREE.Mesh(new THREE.BoxGeometry(0.02, bbH, d), bbMat);
  bb2.position.set(-w/2 + 0.01, bbH/2, 0); roomGroup.add(bb2);
  // ─── Windows (conditional) ───
  if (windowStyle !== 'none') {
    const winW = Math.min(w * 0.42, 3), winH = Math.min(h * 0.55, 1.9);
    const wY = h * 0.55;
    if (windowStyle === 'back') {
      const win = makeWindow(winW, winH);
      win.position.set(0, wY, -d/2 + 0.05);
      roomGroup.add(win);
      const sunLight = new THREE.PointLight(0xFFE8C0, 0.5, 10);
      sunLight.position.set(0, wY, -d/2 + 1.5); roomGroup.add(sunLight);
    } else if (windowStyle === 'back-twin') {
      const wTwin = Math.min(w * 0.22, 1.5);
      const win1 = makeWindow(wTwin, winH); win1.position.set(-w * 0.22, wY, -d/2 + 0.05); roomGroup.add(win1);
      const win2 = makeWindow(wTwin, winH); win2.position.set(w * 0.22, wY, -d/2 + 0.05); roomGroup.add(win2);
      const sunLight = new THREE.PointLight(0xFFE8C0, 0.4, 10);
      sunLight.position.set(0, wY, -d/2 + 1.5); roomGroup.add(sunLight);
    } else if (windowStyle === 'left') {
      const win = makeWindow(Math.min(d * 0.42, 2.5), winH);
      win.position.set(-w/2 + 0.05, wY, 0); win.rotation.y = Math.PI/2;
      roomGroup.add(win);
      const sunLight = new THREE.PointLight(0xFFE8C0, 0.5, 10);
      sunLight.position.set(-w/2 + 1.5, wY, 0); roomGroup.add(sunLight);
    } else if (windowStyle === 'right') {
      const win = makeWindow(Math.min(d * 0.42, 2.5), winH);
      win.position.set(w/2 - 0.05, wY, 0); win.rotation.y = -Math.PI/2;
      roomGroup.add(win);
      const sunLight = new THREE.PointLight(0xFFE8C0, 0.5, 10);
      sunLight.position.set(w/2 - 1.5, wY, 0); roomGroup.add(sunLight);
    }
  }

  // ─── Doors (conditional) ───
  if (doorStyle !== 'none') {
    const doorW = 0.95, doorH = Math.min(h * 0.75, 2.2);
    if (doorStyle === 'back-center') {
      const dr = makeDoor(doorW, doorH);
      dr.position.set(0, 0, -d/2 + 0.05); roomGroup.add(dr);
    } else if (doorStyle === 'back-right') {
      const dr = makeDoor(doorW, doorH);
      dr.position.set(w * 0.32, 0, -d/2 + 0.05); roomGroup.add(dr);
    } else if (doorStyle === 'left-wall') {
      const dr = makeDoor(doorW, doorH);
      dr.position.set(-w/2 + 0.05, 0, d * 0.2); dr.rotation.y = Math.PI/2;
      roomGroup.add(dr);
    } else if (doorStyle === 'right-wall') {
      const dr = makeDoor(doorW, doorH);
      dr.position.set(w/2 - 0.05, 0, d * 0.2); dr.rotation.y = -Math.PI/2;
      roomGroup.add(dr);
    }
  }
  // ─── Ceiling lights — grid layout based on room size ───
  const colsX = Math.max(2, Math.round(w / 2.2));
  const colsZ = Math.max(2, Math.round(d / 2.2));
  const stepX = w / (colsX + 1);
  const stepZ = d / (colsZ + 1);
  for (let i = 1; i <= colsX; i++) {
    for (let j = 1; j <= colsZ; j++) {
      const px = -w/2 + stepX * i;
      const pz = -d/2 + stepZ * j;
      const spot = new THREE.Mesh(new THREE.CylinderGeometry(0.13, 0.16, 0.04, 18), new THREE.MeshStandardMaterial({
        color: ceilingOn ? 0xFFEED0 : 0x2A2A2A,
        emissive: ceilingOn ? 0xFFE5B0 : 0x000000,
        emissiveIntensity: ceilingOn ? 1.4 : 0,
        roughness: 0.25, metalness: 0.85
      }));
      spot.position.set(px, h - 0.02, pz); roomGroup.add(spot);
      // Bright halo disc just below
      const halo = new THREE.Mesh(new THREE.CircleGeometry(0.18, 24), new THREE.MeshBasicMaterial({
        color: 0xFFE8B0, transparent: true, opacity: ceilingOn ? 0.45 : 0, side: THREE.DoubleSide
      }));
      halo.position.set(px, h - 0.04, pz); halo.rotation.x = Math.PI / 2; roomGroup.add(halo);
      const spotLight = new THREE.PointLight(0xFFEED0, ceilingOn ? 1.2 : 0, 7, 1.4);
      spotLight.position.set(px, h - 0.1, pz);
      spotLight.castShadow = false;
      roomGroup.add(spotLight);
      ceilingLights.push(spotLight);
    }
  }
  const gridHelper = new THREE.GridHelper(Math.max(w, d), Math.max(w, d) * 2, 0xCCBBAA, 0xDDD4C8);
  gridHelper.position.y = 0.002;
  gridHelper.material.opacity = 0.25;
  gridHelper.material.transparent = true;
  roomGroup.add(gridHelper);
  applyLightMode();
}

function makeMat(color, type) {
  const c = new THREE.Color(color);
  if (type === 'leather') return new THREE.MeshStandardMaterial({ color: c, roughness: 0.45, metalness: 0.02 });
  if (type === 'wood') return new THREE.MeshStandardMaterial({ color: c, roughness: 0.6, metalness: 0 });
  if (type === 'metal') return new THREE.MeshStandardMaterial({ color: c, roughness: 0.25, metalness: 0.85 });
  return new THREE.MeshStandardMaterial({ color: c, roughness: 0.85, metalness: 0 });
}

const legMat = new THREE.MeshStandardMaterial({ color: 0x3B2F28, roughness: 0.5, metalness: 0.1 });
const legGeo = (h=0.15, r=0.025) => new THREE.CylinderGeometry(Math.max(0.01,r), Math.max(0.01,r), Math.max(0.01,h), 8);

function createSofa(col, mtype) {
  const g = new THREE.Group();
  const m = makeMat(col, mtype || 'fabric');
  const seat = new THREE.Mesh(new THREE.BoxGeometry(2.1, 0.22, 0.85), m);
  seat.position.y = 0.34; seat.castShadow = true; seat.receiveShadow = true; g.add(seat);
  const back = new THREE.Mesh(new THREE.BoxGeometry(2.1, 0.55, 0.14), m.clone());
  back.position.set(0, 0.67, -0.36); back.castShadow = true; g.add(back);
  [-1.0, 1.0].forEach(x => {
    const arm = new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.35, 0.85), m.clone());
    arm.position.set(x, 0.52, 0); arm.castShadow = true; g.add(arm);
  });
  [[-0.9,0.12,0.32],[0.9,0.12,0.32],[-0.9,0.12,-0.32],[0.9,0.12,-0.32]].forEach(p => {
    const l = new THREE.Mesh(legGeo(), legMat); l.position.set(...p); l.castShadow=true; g.add(l);
  });
  const cm = makeMat(col, mtype || 'fabric'); cm.color.offsetHSL(0, 0, 0.04);
  [-0.52, 0, 0.52].forEach(x => {
    const c = new THREE.Mesh(new THREE.BoxGeometry(0.58, 0.08, 0.65), cm);
    c.position.set(x, 0.49, 0.03); c.castShadow = true; g.add(c);
  });
  [-0.52, 0, 0.52].forEach(x => {
    const c = new THREE.Mesh(new THREE.BoxGeometry(0.55, 0.4, 0.1), cm.clone());
    c.position.set(x, 0.62, -0.25); c.castShadow = true; g.add(c);
  });
  g.userData = { isFurniture: true, name: 'Modern Sofa', desc: '3-seat sofa, 210×90cm', matType: mtype||'fabric', matColor: col };
  return g;
}

