/* ===== GLB / GLTF SUPPORT (with Draco + KTX2 + Meshopt) ===== */
const dracoLoader = new DRACOLoader();
dracoLoader.setDecoderPath('https://www.gstatic.com/draco/versioned/decoders/1.5.6/');
dracoLoader.setDecoderConfig({ type: 'js' });

const ktx2Loader = new KTX2Loader()
  .setTranscoderPath('https://unpkg.com/three@0.160.0/examples/jsm/libs/basis/')
  .detectSupport(renderer);

const gltfLoader = new GLTFLoader();
gltfLoader.setDRACOLoader(dracoLoader);
gltfLoader.setKTX2Loader(ktx2Loader);
gltfLoader.setMeshoptDecoder(MeshoptDecoder);

function fitGLBToHeight(model, targetH) {
  const box = new THREE.Box3().setFromObject(model);
  const size = new THREE.Vector3(); box.getSize(size);
  const center = new THREE.Vector3(); box.getCenter(center);
  if (size.y === 0) return model;
  const scale = targetH / size.y;
  model.scale.multiplyScalar(scale);
  // re-center on origin and place on floor
  const box2 = new THREE.Box3().setFromObject(model);
  const c2 = new THREE.Vector3(); box2.getCenter(c2);
  model.position.x -= c2.x;
  model.position.z -= c2.z;
  model.position.y -= box2.min.y;
  return model;
}

function addGLBModel(gltf, label, targetH) {
  const root = gltf.scene || gltf.scenes[0];
  fitGLBToHeight(root, targetH || 0.95);
  root.traverse(c => {
    if (c.isMesh) { c.castShadow = true; c.receiveShadow = true; }
  });
  const group = new THREE.Group();
  group.add(root);
  const box = new THREE.Box3().setFromObject(root);
  const size = new THREE.Vector3(); box.getSize(size);
  const shadowMat = new THREE.MeshBasicMaterial({ color: 0x000000, transparent: true, opacity: 0.28, depthWrite: false });
  const shadow = new THREE.Mesh(new THREE.PlaneGeometry(size.x * 1.05, size.z * 1.05), shadowMat);
  shadow.rotation.x = -Math.PI / 2;
  shadow.position.y = 0.005;
  group.add(shadow);
  group.position.set((Math.random() - 0.5) * (roomW * 0.4), 0, (Math.random() - 0.5) * (roomD * 0.3));
  group.userData = {
    isFurniture: true,
    isProduct: true,
    isGLB: true,
    name: label || '3D Model',
    desc: 'Uploaded 3D model',
    matType: '3d',
    matColor: 'glb'
  };
  scene.add(group);
  placedItems.push(group);
  selectItem(group);
  showToast(`Added ${label || '3D Model'}`);
  return group;
}

function loadGLBFromArrayBuffer(buffer, label, targetH) {
  return new Promise((resolve, reject) => {
    gltfLoader.parse(buffer, '', (gltf) => {
      resolve(addGLBModel(gltf, label, targetH));
    }, (err) => reject(err));
  });
}

function loadGLBFromURL(url, label, targetH) {
  return new Promise((resolve, reject) => {
    gltfLoader.load(url, (gltf) => resolve(addGLBModel(gltf, label, targetH)), undefined, reject);
  });
}

/* placeholder kept for code below — was used for silhouette mode (now removed) */
async function buildShapeFromImage_unused(imgUrl, targetH) {
  const img = await loadHTMLImage(imgUrl);
  const aspect = img.width / img.height;
  const W = 256;
  const H = Math.max(8, Math.round(W / aspect));
  const cv = document.createElement('canvas');
  cv.width = W; cv.height = H;
  const ctx = cv.getContext('2d');
  ctx.drawImage(img, 0, 0, W, H);
  const data = ctx.getImageData(0, 0, W, H).data;

  // detect alpha vs solid background (white-ish)
  let hasAlpha = false;
  for (let i = 3; i < data.length; i += 4) {
    if (data[i] < 250) { hasAlpha = true; break; }
  }
  const isFG = (x, y) => {
    const i = (y * W + x) * 4;
    if (hasAlpha) return data[i + 3] > 128;
    return (data[i] + data[i + 1] + data[i + 2]) < 720;
  };

  // top/bottom envelope per column
  const top = new Array(W).fill(-1);
  const bot = new Array(W).fill(-1);
  for (let x = 0; x < W; x++) {
    for (let y = 0; y < H; y++) {
      if (isFG(x, y)) { if (top[x] < 0) top[x] = y; bot[x] = y; }
    }
  }
  let xMin = W, xMax = -1;
  for (let x = 0; x < W; x++) if (top[x] >= 0) { if (x < xMin) xMin = x; if (x > xMax) xMax = x; }
  if (xMax < xMin) throw new Error('Empty silhouette');
  const cropW = xMax - xMin + 1;

  const w = targetH * (cropW / H);
  const xW = (x) => ((x - xMin) / Math.max(1, cropW - 1) - 0.5) * w;
  const yW = (y) => (1 - y / H) * targetH;

  const shape = new THREE.Shape();
  const step = Math.max(1, Math.floor(cropW / 80));
  let started = false;
  for (let x = xMin; x <= xMax; x += step) {
    if (top[x] >= 0) {
      const px = xW(x), py = yW(top[x]);
      if (!started) { shape.moveTo(px, py); started = true; } else shape.lineTo(px, py);
    }
  }
  if (top[xMax] >= 0) shape.lineTo(xW(xMax), yW(top[xMax]));
  for (let x = xMax; x >= xMin; x -= step) {
    if (bot[x] >= 0) shape.lineTo(xW(x), yW(bot[x]));
  }
  if (bot[xMin] >= 0) shape.lineTo(xW(xMin), yW(bot[xMin]));

  // dominant color of opaque pixels for the side walls
  let r = 0, g = 0, b = 0, n = 0;
  for (let y = 0; y < H; y++) {
    for (let x = xMin; x <= xMax; x++) {
      if (isFG(x, y)) {
        const i = (y * W + x) * 4;
        r += data[i]; g += data[i + 1]; b += data[i + 2]; n++;
      }
    }
  }
  if (n) { r = Math.round(r / n); g = Math.round(g / n); b = Math.round(b / n); }
  const sideColor = (r << 16) | (g << 8) | b;

  // crop canvas to silhouette so UV [0,1] maps cleanly to the front face
  const cropCv = document.createElement('canvas');
  cropCv.width = cropW; cropCv.height = H;
  cropCv.getContext('2d').drawImage(cv, xMin, 0, cropW, H, 0, 0, cropW, H);
  const tex = new THREE.CanvasTexture(cropCv);
  tex.colorSpace = THREE.SRGBColorSpace;

  return { shape, width: w, height: targetH, tex, sideColor };
}

function addProductFurniture(prod) {
  // If a GLB url was attached to this product, load that instead
  if (prod.glb) {
    const heights = { armchair: 0.95, two_seater: 0.95, three_seater: 1.0 };
    const targetH = heights[prod.type] || 0.95;
    showToast('Loading 3D model…');
    loadGLBFromURL(prod.glb, prod.name, targetH).then(group => {
      if (group) {
        attachProductMeta(group, prod);
        renderPlacedList();
      }
    }).catch(err => {
      console.warn('GLB load failed, falling back to image', err);
      addFlatProductImage(prod);
    });
    return;
  }
  return addFlatProductImage(prod);
}

function attachProductMeta(group, prod) {
  group.userData.variantId = prod.variantId;
  group.userData.productId = prod.productId;
  group.userData.thumb = prod.thumb;
  group.userData.url = prod.url;
}

function addFlatProductImage(prod) {
  const heights = { armchair: 0.95, two_seater: 0.95, three_seater: 0.98 };
  const targetH = heights[prod.type] || 0.95;

  texLoader.load(prod.img, (tex) => {
    tex.colorSpace = THREE.SRGBColorSpace;
    tex.anisotropy = renderer.capabilities.getMaxAnisotropy();
    tex.minFilter = THREE.LinearMipmapLinearFilter;
    tex.magFilter = THREE.LinearFilter;
    tex.generateMipmaps = true;
    tex.needsUpdate = true;
    const img = tex.image;
    const aspect = (img && img.width && img.height) ? (img.width / img.height) : 1.6;
    const h = targetH;
    const w = h * aspect;

    const group = new THREE.Group();

    const shadowMat = new THREE.MeshBasicMaterial({ color: 0x000000, transparent: true, opacity: 0.25, depthWrite: false });
    const shadow = new THREE.Mesh(new THREE.PlaneGeometry(w * 0.95, w * 0.45), shadowMat);
    shadow.rotation.x = -Math.PI / 2;
    shadow.position.y = 0.006;
    group.add(shadow);

    const planeMat = new THREE.MeshBasicMaterial({
      map: tex,
      transparent: true,
      alphaTest: 0.05,
      side: THREE.DoubleSide,
      toneMapped: false
    });
    const plane = new THREE.Mesh(new THREE.PlaneGeometry(w, h), planeMat);
    plane.position.y = h / 2;
    group.add(plane);

    const camPos = new THREE.Vector3(); camera.getWorldPosition(camPos);
    group.position.set((Math.random() - 0.5) * (roomW * 0.4), 0, (Math.random() - 0.5) * (roomD * 0.3));
    group.lookAt(camPos.x, group.position.y, camPos.z);

    group.userData = {
      isFurniture: true,
      isProduct: true,
      name: prod.name,
      desc: prod.desc || prod.type,
      matType: 'image',
      matColor: 'image',
      productImg: prod.img,
      _planeMesh: plane
    };
    attachProductMeta(group, prod);
    scene.add(group);
    placedItems.push(group);
    selectItem(group);
    renderPlacedList();
    showToast(`Added ${prod.name}`);
  }, undefined, () => {
    showToast('Image failed to load');
  });
}

function addFurniture(fnName, col, mtype) {
  const fn = builders[fnName];
  if (!fn) return;
  const item = fn(col, mtype);
  item.position.set((Math.random()-0.5) * (roomW * 0.4), 0, (Math.random()-0.5) * (roomD * 0.3));
  scene.add(item);
  placedItems.push(item);
  selectItem(item);
  showToast(`Added ${item.userData.name}`);
  return item;
}

function selectItem(obj) {
  deselectAll();
  selectedObj = obj;
  obj.traverse(c => {
    if (c.isMesh && c.material) {
      if (c.material.emissive) {
        c.material._origEmissive = c.material.emissive.getHex();
        c.material.emissive.setHex(0x443322);
      } else if (c.material.color && c === obj.userData._planeMesh) {
        c.material._origColor = c.material.color.getHex();
        c.material.color.setHex(0xfff5e0);
      }
    }
  });
  $('#item-panel').classList.remove('hidden');
  $('#sel-name').textContent = obj.userData.name;
  $('#sel-desc').textContent = obj.userData.desc;
  $('#current-mat').textContent = `${obj.userData.matType} — ${obj.userData.matColor}`;
  highlightSwatch(obj.userData.matColor);
}

function deselectAll() {
  if (selectedObj) {
    selectedObj.traverse(c => {
      if (c.isMesh && c.material) {
        if (c.material._origEmissive !== undefined && c.material.emissive) c.material.emissive.setHex(c.material._origEmissive);
        if (c.material._origColor !== undefined && c.material.color) c.material.color.setHex(c.material._origColor);
      }
    });
  }
  selectedObj = null;
  $('#item-panel').classList.add('hidden');
  $('#current-mat').textContent = '—';
}

function deleteSelected() {
  if (!selectedObj) return;
  removeItem(selectedObj);
}

function removeItem(item) {
  const name = item.userData.name;
  scene.remove(item);
  placedItems = placedItems.filter(i => i !== item);
  item.traverse(c => { if (c.geometry) c.geometry.dispose(); if (c.material) { if (Array.isArray(c.material)) c.material.forEach(m=>m.dispose()); else c.material.dispose(); }});
  if (selectedObj === item) {
    selectedObj = null;
    $('#item-panel').classList.add('hidden');
  }
  renderPlacedList();
  showToast(`Removed ${name}`);
}

function renderPlacedList() {
  const list = $('#placed-list');
  const products = placedItems.filter(i => i.userData.isProduct && i.userData.variantId);
  $('#placed-count').textContent = products.length;
  const btn = $('#btn-add-cart');
  if (products.length === 0) {
    btn.style.opacity = '.5';
    btn.style.pointerEvents = 'none';
    list.innerHTML = '<div class="placed-empty">No items added yet — pick from the library above</div>';
    return;
  }
  btn.style.opacity = '1';
  btn.style.pointerEvents = 'auto';
  list.innerHTML = '';
  products.forEach(item => {
    const row = document.createElement('div');
    row.className = 'placed-row';
    row.innerHTML = `
      <img class="placed-thumb" src="${item.userData.thumb || item.userData.productImg || ''}" alt="" loading="lazy">
      <span class="placed-name" title="${item.userData.name}">${item.userData.name}</span>
      <button class="placed-remove" type="button" title="Remove">&times;</button>
    `;
    row.querySelector('.placed-name').addEventListener('click', () => selectItem(item));
    row.querySelector('.placed-thumb').addEventListener('click', () => selectItem(item));
    row.querySelector('.placed-remove').addEventListener('click', e => {
      e.stopPropagation();
      removeItem(item);
    });
    list.appendChild(row);
  });
}

async function captureRoomScreenshot(maxW = 1200, quality = 0.7) {
  renderer.render(scene, camera);
  return new Promise((resolve) => {
    const src = renderer.domElement;
    const scale = Math.min(1, maxW / src.width);
    const w = Math.round(src.width * scale);
    const h = Math.round(src.height * scale);
    const dst = document.createElement('canvas');
    dst.width = w; dst.height = h;
    dst.getContext('2d').drawImage(src, 0, 0, w, h);
    dst.toBlob(b => resolve(b), 'image/jpeg', quality);
  });
}

async function addAllToCart() {
  const products = placedItems.filter(i => i.userData.isProduct && i.userData.variantId);
  if (products.length === 0) { showToast('No products placed'); return; }

  showToast('Capturing your room…');
  let blob = null;
  try { blob = await captureRoomScreenshot(); } catch (_) {}

  const designId = 'RD-' + Date.now().toString(36).toUpperCase();
  const summary = products.map(i => i.userData.name).join(' | ');

  try {
    showToast('Adding to cart…');
    // 1) First product: include the design image as a line item file property (Shopify keeps it on the order)
    const first = products[0];
    const fd = new FormData();
    fd.append('id', first.userData.variantId);
    fd.append('quantity', '1');
    fd.append('properties[Room Design ID]', designId);
    fd.append('properties[Room Position]', `x:${first.position.x.toFixed(2)} z:${first.position.z.toFixed(2)} rot:${(first.rotation.y*180/Math.PI).toFixed(0)}°`);
    if (blob) fd.append('properties[Room Design Image]', blob, `${designId}.jpg`);
    const r1 = await fetch('/cart/add', { method: 'POST', body: fd, headers: { 'Accept': 'application/json' } });
    if (!r1.ok) throw new Error('First item add failed: ' + r1.status);

    // 2) Remaining products via cart/add.js (JSON, no file)
    if (products.length > 1) {
      const items = products.slice(1).map(it => ({
        id: it.userData.variantId,
        quantity: 1,
        properties: {
          'Room Design ID': designId,
          'Room Position': `x:${it.position.x.toFixed(2)} z:${it.position.z.toFixed(2)} rot:${(it.rotation.y*180/Math.PI).toFixed(0)}°`
        }
      }));
      const r2 = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items })
      });
      if (!r2.ok) {
        const txt = await r2.text();
        throw new Error('Items add failed: ' + r2.status + ' — ' + txt);
      }
    }

    // 3) Cart-level attribute summary (visible in admin)
    await fetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        attributes: {
          'Room Design ID': designId,
          'Room Design Items': summary,
          'Room Design Date': new Date().toISOString()
        }
      })
    });

    showToast('Added! Redirecting to cart…');
    setTimeout(() => { window.location.href = '/cart'; }, 700);
  } catch (e) {
    console.error(e);
    showToast('Add to cart failed — see console');
  }
}

function duplicateSelected() {
  if (!selectedObj) return;
  const d = selectedObj.userData;
  let matchFn = null;
  for (const cat of Object.values(furnitureItems)) {
    const found = cat.find(it => it.name === d.name);
    if (found) { matchFn = found.fn; break; }
  }
  if (matchFn) {
    const item = builders[matchFn](d.matColor, d.matType);
    item.position.copy(selectedObj.position).add(new THREE.Vector3(0.5, 0, 0.5));
    item.rotation.y = selectedObj.rotation.y;
    scene.add(item);
    placedItems.push(item);
    selectItem(item);
    showToast(`Duplicated ${d.name}`);
  }
}

function applyMaterial(color, type) {
  if (!selectedObj) { showToast('Select an item first'); return; }
  // ─── Skip material override on uploaded GLB models — preserve original textures ───
  if (selectedObj.userData && (selectedObj.userData.isGLB || selectedObj.userData.isProduct)) {
    showToast('Original 3D textures preserved');
    return;
  }
  // ─── Skip on openings (doors/windows) — they have their own materials ───
  if (selectedObj.userData && selectedObj.userData.isOpening) {
    return;
  }
  currentColor = color;
  currentMatType = type;
  selectedObj.userData.matColor = color;
  selectedObj.userData.matType = type;
  const newMat = makeMat(color, type);
  let idx = 0;
  selectedObj.traverse(c => {
    if (c.isMesh && c.material && !c.material._isLeg && !c.material._isStruct) {
      const m = newMat.clone();
      if (idx > 0) m.color.offsetHSL(0, 0, (idx % 3) * 0.02);
      m._origEmissive = m.emissive ? m.emissive.getHex() : 0;
      m.emissive.setHex(0x443322);
      c.material.dispose();
      c.material = m;
      idx++;
    }
  });
  $('#current-mat').textContent = `${type} — ${color}`;
  highlightSwatch(color);
}

const raycaster = new THREE.Raycaster();
const pointer = new THREE.Vector2();

function getMeshes() {
  const meshes = [];
  placedItems.forEach(g => g.traverse(c => { if (c.isMesh) meshes.push(c); }));
  return meshes;
}

function findParentFurniture(obj) {
  let current = obj;
  while (current) {
    if (current.userData && current.userData.isFurniture) return current;
    current = current.parent;
  }
  return null;
}

canvas.addEventListener('pointerdown', e => {
  const rect = canvas.getBoundingClientRect();
  pointer.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
  pointer.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
  raycaster.setFromCamera(pointer, camera);
  const hits = raycaster.intersectObjects(getMeshes(), false);
  if (hits.length > 0) {
    const furniture = findParentFurniture(hits[0].object);
    if (furniture) {
      selectItem(furniture);
      dragItem = furniture;
      isDrag = true;
      controls.enabled = false;
      raycaster.ray.intersectPlane(dragPlane, intersection);
      dragOffset.copy(intersection).sub(furniture.position);
      dragOffset.y = 0;
      canvas.style.cursor = 'move';
    }
  } else {
    deselectAll();
  }
});

canvas.addEventListener('pointermove', e => {
  if (!isDrag || !dragItem) return;
  const rect = canvas.getBoundingClientRect();
  pointer.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
  pointer.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
  raycaster.setFromCamera(pointer, camera);
  if (raycaster.ray.intersectPlane(dragPlane, intersection)) {
    const newPos = intersection.sub(dragOffset);

    // ─── Opening snap-to-wall ───
    if (dragItem.userData && dragItem.userData.isOpening) {
      const halfW = roomW / 2, halfD = roomD / 2;
      const openW = dragItem.userData.openingW || 1;
      const margin = openW / 2 + 0.15;
      // Find nearest wall by distance
      const dBack  = Math.abs(newPos.z - (-halfD));
      const dFront = Math.abs(newPos.z - halfD);
      const dLeft  = Math.abs(newPos.x - (-halfW));
      const dRight = Math.abs(newPos.x - halfW);
      const minD = Math.min(dBack, dFront, dLeft, dRight);
      const slide = 0.04; // distance from wall surface

      if (minD === dBack) {
        dragItem.position.set(
          Math.max(-halfW + margin, Math.min(halfW - margin, newPos.x)),
          0, -halfD + slide
        );
        dragItem.rotation.y = 0;
      } else if (minD === dFront) {
        dragItem.position.set(
          Math.max(-halfW + margin, Math.min(halfW - margin, newPos.x)),
          0, halfD - slide
        );
        dragItem.rotation.y = Math.PI;
      } else if (minD === dLeft) {
        dragItem.position.set(
          -halfW + slide, 0,
          Math.max(-halfD + margin, Math.min(halfD - margin, newPos.z))
        );
        dragItem.rotation.y = Math.PI / 2;
      } else {
        dragItem.position.set(
          halfW - slide, 0,
          Math.max(-halfD + margin, Math.min(halfD - margin, newPos.z))
        );
        dragItem.rotation.y = -Math.PI / 2;
      }
      return;
    }

    const hw = roomW / 2 - 0.3, hd = roomD / 2 - 0.3;
    dragItem.position.x = Math.max(-hw, Math.min(hw, newPos.x));
    dragItem.position.z = Math.max(-hd, Math.min(hd, newPos.z));
  }
});

canvas.addEventListener('pointerup', () => {
  isDrag = false;
  dragItem = null;
  controls.enabled = true;
  canvas.style.cursor = 'grab';
});

function renderCatTabs() {
  const container = $('#cat-tabs');
  container.innerHTML = '';
  categories.forEach(cat => {
    const el = document.createElement('div');
    el.className = `cat-tab ${currentCat === cat.id ? 'active' : ''}`;
    el.innerHTML = `<i class="fas ${cat.icon} mr-1"></i>${cat.label}`;
    el.addEventListener('click', () => { currentCat = cat.id; renderCatTabs(); renderFurnGrid(); });
    container.appendChild(el);
  });
}

function renderFurnGrid() {
  const container = $('#furn-grid');
  container.innerHTML = '';
  const catDef = categories.find(c => c.id === currentCat);
  if (catDef && catDef.productCat) {
    const products = shopProducts[currentCat] || [];
    if (products.length === 0) {
      container.innerHTML = `<div class="col-span-2 text-center text-[11px] py-4" style="color:var(--muted)">No products in this collection. Configure source collection in theme editor.</div>`;
      return;
    }
    products.forEach(prod => {
      const el = document.createElement('div');
      el.className = 'furn-card fade-up';
      el.style.padding = '0';
      el.style.overflow = 'hidden';
      el.innerHTML = `<div style="aspect-ratio:1;background:#fff"><img src="${prod.thumb}" alt="${prod.name}" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block"></div><div style="padding:6px 8px"><p class="text-[11px] font-semibold leading-tight" style="line-height:1.15">${prod.name.length>26?prod.name.slice(0,24)+'…':prod.name}</p><p class="text-[10px] mt-0.5" style="color:var(--muted)">${prod.desc}</p></div>`;
      el.addEventListener('click', () => addProductFurniture(prod));
      container.appendChild(el);
    });
    return;
  }
  const items = furnitureItems[currentCat] || [];
  items.forEach(item => {
    const el = document.createElement('div');
    el.className = 'furn-card fade-up';
    el.innerHTML = `<div class="w-8 h-8 rounded-lg flex items-center justify-center mb-2" style="background:var(--warm)"><i class="fas ${item.icon} text-xs" style="color:var(--accent)"></i></div><p class="text-xs font-semibold leading-tight">${item.name}</p><p class="text-[10px] mt-0.5" style="color:var(--muted)">${item.desc}</p>`;
    el.addEventListener('click', () => addFurniture(item.fn, currentColor, currentMatType));
    container.appendChild(el);
  });
}

function renderMatTypes() {
  const container = $('#mat-types');
  container.innerHTML = '';
  ['fabric','leather','wood','metal'].forEach(t => {
    const el = document.createElement('button');
    el.className = `mat-type ${currentMatType === t ? 'active' : ''}`;
    el.textContent = t.charAt(0).toUpperCase() + t.slice(1);
    el.addEventListener('click', () => { currentMatType = t; renderMatTypes(); renderColorSwatches(); });
    container.appendChild(el);
  });
}

function renderColorSwatches() {
  const container = $('#color-swatches');
  container.innerHTML = '';
  const colors = matColors[currentMatType] || [];
  colors.forEach(c => {
    const el = document.createElement('div');
    el.className = `mat-swatch ${currentColor === c ? 'active' : ''}`;
    el.style.background = c;
    el.title = c;
    el.addEventListener('click', () => {
      currentColor = c;
      renderColorSwatches();
      if (selectedObj) applyMaterial(c, currentMatType);
    });
    container.appendChild(el);
  });
}

