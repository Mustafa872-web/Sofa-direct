function _doorWoodTex(baseHex, streakAlpha) {
  const c = document.createElement('canvas'); c.width = 256; c.height = 512;
  const ctx = c.getContext('2d');
  ctx.fillStyle = baseHex; ctx.fillRect(0,0,256,512);
  for (let i = 0; i < 80; i++) {
    ctx.strokeStyle = `rgba(30,15,5,${Math.random()*streakAlpha})`;
    ctx.lineWidth = Math.random()*1.2 + 0.3;
    ctx.beginPath(); const y = Math.random()*512;
    ctx.moveTo(0, y);
    for (let x = 0; x < 256; x += 8) ctx.lineTo(x, y + Math.sin(x*0.02 + i)*3);
    ctx.stroke();
  }
  return new THREE.CanvasTexture(c);
}
function _frame(g, w, h, color, depth) {
  const m = new THREE.MeshStandardMaterial({ color, roughness: 0.6 });
  const fr = 0.1, fd = depth || 0.09;
  const ft = new THREE.Mesh(new THREE.BoxGeometry(w + fr*2, fr, fd), m);
  ft.position.set(0, h + fr/2, 0); g.add(ft);
  const fl = new THREE.Mesh(new THREE.BoxGeometry(fr, h + fr, fd), m);
  fl.position.set(-w/2 - fr/2, h/2 + fr/2, 0); g.add(fl);
  const fr2 = fl.clone(); fr2.position.x = w/2 + fr/2; g.add(fr2);
}
function _handle(g, x, y) {
  const m = new THREE.MeshStandardMaterial({ color: 0xC9A057, metalness: 0.85, roughness: 0.22 });
  const plate = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.16, 0.012), m);
  plate.position.set(x, y, 0.035); g.add(plate);
  const lever = new THREE.Mesh(new THREE.CylinderGeometry(0.022, 0.022, 0.13, 12), m);
  lever.rotation.z = Math.PI/2; lever.position.set(x - 0.05, y, 0.05); g.add(lever);
  const knob = new THREE.Mesh(new THREE.SphereGeometry(0.028, 16, 12), m);
  knob.position.set(x - 0.115, y, 0.05); g.add(knob);
}
