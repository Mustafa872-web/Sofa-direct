<style>
.sd-room-studio-wrap{max-width:1440px;margin:40px auto 60px;padding:0 1.5rem}
@media(min-width:990px){.sd-room-studio-wrap{padding:0 5rem}}
.sd-room-studio{--bg:#F5F0E8;--fg:#2D2D2D;--muted:#8A8478;--accent:#C17F4E;--card:#FFFFFF;--border:#E2DDD4;--wood:#8B7355;--ivory:#FAF8F4;--dark:#333;--warm:#F0E8D8;font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--fg);height:calc(100vh - 120px);min-height:640px;overflow:hidden;display:flex;width:100%;border-radius:18px;box-shadow:0 8px 32px rgba(47,72,88,.08);border:1px solid var(--border)}
.sd-room-studio *{box-sizing:border-box}
.sd-room-studio h1,.sd-room-studio h2,.sd-room-studio h3,.sd-room-studio h4,.sd-room-studio h5,.sd-room-studio h6{font-family:'Outfit',sans-serif;margin:0}
.sd-room-studio ::-webkit-scrollbar{width:4px}
.sd-room-studio ::-webkit-scrollbar-track{background:transparent}
.sd-room-studio ::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px}
.sd-room-studio #viewer-canvas{width:100%;height:100%;display:block;cursor:grab}
.sd-room-studio #viewer-canvas:active{cursor:grabbing}
.sd-room-studio .sidebar{width:310px;min-width:310px;background:var(--card);border-right:1px solid var(--border);height:100%;overflow-y:auto;transition:margin-left .4s cubic-bezier(.16,1,.3,1)}
.sd-room-studio .sidebar.collapsed{margin-left:-310px}
.sd-room-studio .cat-tab{padding:7px 12px;border-radius:8px;font-size:12px;font-weight:500;cursor:pointer;transition:all .25s;border:1px solid transparent;white-space:nowrap;background:var(--ivory);color:var(--muted)}
.sd-room-studio .cat-tab:hover{background:var(--warm)}
.sd-room-studio .cat-tab.active{background:var(--accent);color:#fff;border-color:var(--accent)}
.sd-room-studio .furn-card{padding:10px;border-radius:10px;border:1px solid var(--border);cursor:pointer;transition:all .25s;background:var(--ivory)}
.sd-room-studio .furn-card:hover{border-color:var(--accent);box-shadow:0 4px 16px rgba(193,127,78,.15);transform:translateY(-2px)}
.sd-room-studio .furn-card.active-card{border-color:var(--accent);background:rgba(193,127,78,.08)}
.sd-room-studio .mat-swatch{width:30px;height:30px;min-width:30px;min-height:30px;border-radius:8px;cursor:pointer;transition:all .2s;border:2px solid #E2DDD4;flex-shrink:0;display:inline-block;background-size:cover;background-position:center;box-shadow:inset 0 0 0 1px rgba(0,0,0,0.06)}
.sd-room-studio .mat-swatch:hover{transform:scale(1.12);border-color:var(--accent)}
.sd-room-studio .mat-swatch.active{border-color:var(--accent);box-shadow:0 0 0 2px rgba(193,127,78,.35)}
.sd-room-studio #wall-colors,
.sd-room-studio #floor-styles,
.sd-room-studio #door-styles,
.sd-room-studio #window-styles{display:flex;flex-wrap:wrap;gap:6px;width:100%}
.sd-room-studio #wall-colors .mat-swatch,
.sd-room-studio #floor-styles .mat-swatch,
.sd-room-studio #door-styles .mat-swatch,
.sd-room-studio #window-styles .mat-swatch{display:inline-block !important;visibility:visible !important;opacity:1}
.sd-room-studio .ctrl-btn{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;cursor:pointer;background:rgba(255,255,255,.92);backdrop-filter:blur(8px);border:1px solid var(--border);transition:all .2s;color:var(--fg);font-size:13px}
.sd-room-studio .ctrl-btn:hover{border-color:var(--accent);color:var(--accent)}
.sd-room-studio input[type=range]{-webkit-appearance:none;width:100%;height:4px;background:var(--border);border-radius:4px;outline:none}
.sd-room-studio input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:14px;border-radius:50%;background:var(--accent);cursor:pointer;border:2px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.15)}
.sd-room-studio .section-label{font-family:'Outfit',sans-serif;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1.8px;color:var(--muted);margin-bottom:10px}
.sd-room-studio .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--dark);color:#fff;padding:10px 22px;border-radius:10px;font-size:13px;font-weight:500;z-index:1000;opacity:0;transition:all .4s cubic-bezier(.16,1,.3,1);pointer-events:none}
.sd-room-studio .toast.show{transform:translateX(-50%) translateY(0);opacity:1}
.sd-room-studio .mat-type{cursor:pointer;font-size:11px;padding:5px 10px;border-radius:20px;border:1px solid var(--border);background:transparent;color:var(--muted);transition:all .2s}
.sd-room-studio .mat-type.active{border-color:var(--accent);background:rgba(193,127,78,.1);color:var(--accent)}
.sd-room-studio .mat-type:hover{border-color:var(--accent)}
.sd-room-studio .action-btn{width:100%;padding:10px;border-radius:10px;font-size:13px;font-weight:600;display:flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:all .2s;border:none}
.sd-room-studio .action-btn:hover{filter:brightness(.92)}
@keyframes sdRoomFadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.sd-room-studio .fade-up{animation:sdRoomFadeUp .4s ease forwards}
.sd-room-studio .flex-1{flex:1 1 0%}
.sd-room-studio .relative{position:relative}
.sd-room-studio .absolute{position:absolute}
.sd-room-studio .prod-card{position:relative;border-radius:8px;overflow:hidden;border:1px solid var(--border);background:var(--ivory);cursor:pointer;aspect-ratio:1;transition:all .2s}
.sd-room-studio .prod-card:hover{border-color:var(--accent);transform:translateY(-2px);box-shadow:0 4px 12px rgba(193,127,78,.18)}
.sd-room-studio .prod-card.active{border-color:var(--accent);box-shadow:0 0 0 2px rgba(193,127,78,.3)}
.sd-room-studio .prod-card img{width:100%;height:100%;object-fit:cover;display:block}
.sd-room-studio .prod-card .prod-name{position:absolute;left:0;right:0;bottom:0;background:linear-gradient(transparent,rgba(0,0,0,.7));color:#fff;font-size:9px;padding:8px 4px 3px;line-height:1.1;text-align:center;font-weight:500}
.sd-room-studio .placed-row{display:flex;align-items:center;gap:8px;padding:7px 9px;border-radius:7px;background:var(--ivory);border:1px solid var(--border);font-size:11px;transition:all .15s}
.sd-room-studio .placed-row:hover{border-color:var(--accent)}
.sd-room-studio .placed-row .placed-thumb{width:28px;height:28px;border-radius:5px;object-fit:cover;flex-shrink:0;background:#fff}
.sd-room-studio .placed-row .placed-name{flex:1;cursor:pointer;font-weight:500;line-height:1.2;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sd-room-studio .placed-row .placed-remove{width:22px;height:22px;border-radius:5px;background:#fdecec;color:#c0392b;font-size:14px;line-height:1;border:none;cursor:pointer;font-weight:700;flex-shrink:0;display:flex;align-items:center;justify-content:center}
.sd-room-studio .placed-row .placed-remove:hover{background:#f8c8c8}
.sd-room-studio .placed-empty{font-size:11px;color:var(--muted);padding:10px 4px;text-align:center;font-style:italic}
</style>

<div class="sd-room-studio-wrap"><div class="sd-room-studio" id="sd-room-studio">
  <aside class="sidebar" id="sidebar">
    <div class="p-5 border-b" style="border-color:var(--border)">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:var(--accent)"><i class="fas fa-couch text-white text-xs"></i></div>
        <div><h1 class="text-base font-bold leading-tight">Interior Studio</h1><p class="text-[10px]" style="color:var(--muted)">3D Design Previewer</p></div>
      </div>
    </div>
    <div class="p-4 border-b" style="border-color:var(--border)">
      <p class="section-label">Furniture Library</p>
      <div class="flex gap-1.5 mb-3 overflow-x-auto pb-1" id="cat-tabs"></div>
      <div class="grid grid-cols-2 gap-2" id="furn-grid"></div>
    </div>

    {%- capture products_json -%}
    {
      {%- comment -%} Helper variable scoped per loop. Builds: img URL, glb URL, variant id. {%- endcomment -%}
      "armchair": [
        {%- assign ac = collections[section.settings.armchair_collection] -%}
        {%- for p in ac.products limit: 30 -%}
          {%- assign room_img = p.metafields.custom.room_image.value -%}
          {%- if room_img != blank -%}
            {%- assign p_img = room_img | image_url: width: 2000 -%}
            {%- assign p_thumb = room_img | image_url: width: 200 -%}
          {%- elsif p.featured_image != blank -%}
            {%- assign p_img = p.featured_image | image_url: width: 2000 -%}
            {%- assign p_thumb = p.featured_image | image_url: width: 200 -%}
          {%- else -%}
            {%- assign p_img = '' -%}
            {%- assign p_thumb = '' -%}
          {%- endif -%}
          {%- if p_img != '' -%}
            {%- assign glb_url = '' -%}
            {%- for m in p.media -%}{%- if m.media_type == 'model' -%}{%- for s in m.sources -%}{%- if s.format == 'glb' and glb_url == '' -%}{%- assign glb_url = s.url -%}{%- endif -%}{%- endfor -%}{%- endif -%}{%- endfor -%}
            {%- if glb_url == '' and p.metafields.custom.model_3d != blank -%}
              {%- assign glb_url = p.metafields.custom.model_3d.value | file_url -%}
              {%- if glb_url == nil or glb_url == '' -%}{%- assign glb_url = p.metafields.custom.model_3d -%}{%- endif -%}
            {%- endif -%}
            {%- assign v_id = p.selected_or_first_available_variant.id -%}
            {%- unless forloop.first %},{% endunless -%}
            {"name": {{ p.title | json }}, "desc": {{ p.metafields.custom.dimensions | default: 'Armchair' | json }}, "img": {{ p_img | json }}, "thumb": {{ p_thumb | json }}, "glb": {{ glb_url | default: '' | json }}, "type": "armchair", "variantId": {{ v_id | json }}, "productId": {{ p.id | json }}, "url": {{ p.url | json }}, "price": {{ p.price | money_without_currency | json }}}
          {%- endif -%}
        {%- endfor -%}
      ],
      "two_seater": [
        {%- assign ts = collections[section.settings.two_seater_collection] -%}
        {%- for p in ts.products limit: 30 -%}
          {%- assign room_img = p.metafields.custom.room_image.value -%}
          {%- if room_img != blank -%}
            {%- assign p_img = room_img | image_url: width: 2000 -%}
            {%- assign p_thumb = room_img | image_url: width: 200 -%}
          {%- elsif p.featured_image != blank -%}
            {%- assign p_img = p.featured_image | image_url: width: 2000 -%}
            {%- assign p_thumb = p.featured_image | image_url: width: 200 -%}
          {%- else -%}
            {%- assign p_img = '' -%}
            {%- assign p_thumb = '' -%}
          {%- endif -%}
          {%- if p_img != '' -%}
            {%- assign glb_url = '' -%}
            {%- for m in p.media -%}{%- if m.media_type == 'model' -%}{%- for s in m.sources -%}{%- if s.format == 'glb' and glb_url == '' -%}{%- assign glb_url = s.url -%}{%- endif -%}{%- endfor -%}{%- endif -%}{%- endfor -%}
            {%- if glb_url == '' and p.metafields.custom.model_3d != blank -%}
              {%- assign glb_url = p.metafields.custom.model_3d.value | file_url -%}
              {%- if glb_url == nil or glb_url == '' -%}{%- assign glb_url = p.metafields.custom.model_3d -%}{%- endif -%}
            {%- endif -%}
            {%- assign v_id = p.selected_or_first_available_variant.id -%}
            {%- unless forloop.first %},{% endunless -%}
            {"name": {{ p.title | json }}, "desc": {{ p.metafields.custom.dimensions | default: '2 Seater Sofa' | json }}, "img": {{ p_img | json }}, "thumb": {{ p_thumb | json }}, "glb": {{ glb_url | default: '' | json }}, "type": "two_seater", "variantId": {{ v_id | json }}, "productId": {{ p.id | json }}, "url": {{ p.url | json }}, "price": {{ p.price | money_without_currency | json }}}
          {%- endif -%}
        {%- endfor -%}
      ],
      "three_seater": [
        {%- assign th = collections[section.settings.three_seater_collection] -%}
        {%- for p in th.products limit: 30 -%}
          {%- assign room_img = p.metafields.custom.room_image.value -%}
          {%- if room_img != blank -%}
            {%- assign p_img = room_img | image_url: width: 2000 -%}
            {%- assign p_thumb = room_img | image_url: width: 200 -%}
          {%- elsif p.featured_image != blank -%}
            {%- assign p_img = p.featured_image | image_url: width: 2000 -%}
            {%- assign p_thumb = p.featured_image | image_url: width: 200 -%}
          {%- else -%}
            {%- assign p_img = '' -%}
            {%- assign p_thumb = '' -%}
          {%- endif -%}
          {%- if p_img != '' -%}
            {%- assign glb_url = '' -%}
            {%- for m in p.media -%}{%- if m.media_type == 'model' -%}{%- for s in m.sources -%}{%- if s.format == 'glb' and glb_url == '' -%}{%- assign glb_url = s.url -%}{%- endif -%}{%- endfor -%}{%- endif -%}{%- endfor -%}
            {%- if glb_url == '' and p.metafields.custom.model_3d != blank -%}
              {%- assign glb_url = p.metafields.custom.model_3d.value | file_url -%}
              {%- if glb_url == nil or glb_url == '' -%}{%- assign glb_url = p.metafields.custom.model_3d -%}{%- endif -%}
            {%- endif -%}
            {%- assign v_id = p.selected_or_first_available_variant.id -%}
            {%- unless forloop.first %},{% endunless -%}
            {"name": {{ p.title | json }}, "desc": {{ p.metafields.custom.dimensions | default: '3 Seater Sofa' | json }}, "img": {{ p_img | json }}, "thumb": {{ p_thumb | json }}, "glb": {{ glb_url | default: '' | json }}, "type": "three_seater", "variantId": {{ v_id | json }}, "productId": {{ p.id | json }}, "url": {{ p.url | json }}, "price": {{ p.price | money_without_currency | json }}}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
    {%- endcapture -%}
    <script type="application/json" id="sd-shop-products">{{ products_json }}</script>
    <div class="p-4 border-b" style="border-color:var(--border)">
      <p class="section-label">Material &amp; Color</p>
      <p class="text-[11px] mb-2" style="color:var(--muted)">Select a placed item, then pick a material</p>
      <div class="flex gap-1.5 mb-3 flex-wrap" id="mat-types"></div>
      <div class="flex flex-wrap gap-2" id="color-swatches"></div>
      <div class="flex items-center gap-2 mt-2"><span class="text-[10px]" style="color:var(--muted)">Applied:</span><span class="text-[11px] font-semibold" id="current-mat" style="color:var(--accent)">—</span></div>
    </div>

    <div class="p-4 border-b" style="border-color:var(--border)">
      <p class="section-label">My Products</p>
      <p class="text-[11px] mb-2" style="color:var(--muted)">Click product → applies as texture on selected item</p>
      {%- assign product_collection = collections[section.settings.product_collection] -%}
      {%- if product_collection == blank or product_collection.products_count == 0 -%}
        {%- assign product_list = collections.all.products -%}
      {%- else -%}
        {%- assign product_list = product_collection.products -%}
      {%- endif -%}
      <div class="grid grid-cols-3 gap-2" id="product-grid">
        {%- for product in product_list limit: section.settings.products_limit -%}
          {%- if product.featured_image -%}
            <div class="prod-card" data-img="{{ product.featured_image | image_url: width: 600 }}" data-name="{{ product.title | escape }}" title="{{ product.title | escape }}">
              <img src="{{ product.featured_image | image_url: width: 200 }}" alt="{{ product.title | escape }}" loading="lazy">
              <span class="prod-name">{{ product.title | truncate: 22 }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="mt-3">
        <label class="action-btn" style="background:var(--ivory);color:var(--fg);border:1px solid var(--border);cursor:pointer">
          <i class="fas fa-upload text-xs"></i>Upload Custom Image
          <input type="file" id="img-upload" accept="image/*" style="display:none">
        </label>
        <button class="action-btn mt-2" style="background:#fff;color:var(--muted);border:1px solid var(--border)" id="btn-clear-tex"><i class="fas fa-times text-xs"></i>Remove Image</button>
      </div>
    </div>
    <div class="p-4 border-b" style="border-color:var(--border)">
      <p class="section-label">Room Settings</p>
      <div class="mb-3">
        <div class="flex justify-between mb-1"><span class="text-[11px] font-medium">Width</span><span class="text-[10px]" style="color:var(--muted)" id="rw-val">8.0m</span></div>
        <input type="range" id="room-width" min="4" max="14" value="8" step="0.5">
      </div>
      <div class="mb-3">
        <div class="flex justify-between mb-1"><span class="text-[11px] font-medium">Depth</span><span class="text-[10px]" style="color:var(--muted)" id="rd-val">6.0m</span></div>
        <input type="range" id="room-depth" min="4" max="12" value="6" step="0.5">
      </div>
      <div class="mb-3">
        <div class="flex justify-between mb-1"><span class="text-[11px] font-medium">Ceiling Height</span><span class="text-[10px]" style="color:var(--muted)" id="wh-val">3.0m</span></div>
        <input type="range" id="wall-height" min="2.5" max="5" value="3" step="0.25">
      </div>
      <div class="mb-3">
        <span class="text-[11px] font-medium">Wall Color</span>
        <div class="flex flex-wrap gap-2 mt-2" id="wall-colors">
          <div class="mat-swatch active" data-wc="#FAF8F4" title="Ivory"      style="background:#FAF8F4;border-color:var(--accent)"></div>
          <div class="mat-swatch" data-wc="#FFFFFF"       title="White"       style="background:#FFFFFF"></div>
          <div class="mat-swatch" data-wc="#F5EFE0"       title="Cream"       style="background:#F5EFE0"></div>
          <div class="mat-swatch" data-wc="#FFFAEA"       title="Warm Cream"  style="background:#FFFAEA"></div>
          <div class="mat-swatch" data-wc="#E8E2D8"       title="Mushroom"    style="background:#E8E2D8"></div>
          <div class="mat-swatch" data-wc="#D4C8B8"       title="Stone"       style="background:#D4C8B8"></div>
          <div class="mat-swatch" data-wc="#C4B8A8"       title="Linen"       style="background:#C4B8A8"></div>
          <div class="mat-swatch" data-wc="#C0B09F"       title="Taupe"       style="background:#C0B09F"></div>
          <div class="mat-swatch" data-wc="#A58C70"       title="Brown"       style="background:#A58C70"></div>
          <div class="mat-swatch" data-wc="#8B6F4A"       title="Walnut"      style="background:#8B6F4A"></div>
          <div class="mat-swatch" data-wc="#B8C4C0"       title="Sage"        style="background:#B8C4C0"></div>
          <div class="mat-swatch" data-wc="#7A8E84"       title="Eucalyptus"  style="background:#7A8E84"></div>
          <div class="mat-swatch" data-wc="#5E7464"       title="Forest"      style="background:#5E7464"></div>
          <div class="mat-swatch" data-wc="#A8B8C8"       title="Sky"         style="background:#A8B8C8"></div>
          <div class="mat-swatch" data-wc="#5478A0"       title="Denim"       style="background:#5478A0"></div>
          <div class="mat-swatch" data-wc="#2F4858"       title="Teal"        style="background:#2F4858"></div>
          <div class="mat-swatch" data-wc="#1F2A3A"       title="Navy"        style="background:#1F2A3A"></div>
          <div class="mat-swatch" data-wc="#D4A89E"       title="Blush"       style="background:#D4A89E"></div>
          <div class="mat-swatch" data-wc="#A85848"       title="Terracotta"  style="background:#A85848"></div>
          <div class="mat-swatch" data-wc="#7A3A30"       title="Burgundy"    style="background:#7A3A30"></div>
          <div class="mat-swatch" data-wc="#E0C878"       title="Mustard"     style="background:#E0C878"></div>
          <div class="mat-swatch" data-wc="#3A3A3A"       title="Charcoal"    style="background:#3A3A3A"></div>
          <div class="mat-swatch" data-wc="#1A1A1A"       title="Black"       style="background:#1A1A1A"></div>
        </div>
      </div>
      <div class="mb-3">
        <span class="text-[11px] font-medium">Floor</span>
        <div class="flex flex-wrap gap-2 mt-2" id="floor-styles">
          <div class="mat-swatch active" data-floor="wood-light"   title="Light Wood"   style="background:linear-gradient(135deg,#C9A57A,#B8956A);border-color:var(--accent)"></div>
          <div class="mat-swatch" data-floor="wood-natural"        title="Natural Wood" style="background:linear-gradient(135deg,#D8B58A,#B89668)"></div>
          <div class="mat-swatch" data-floor="wood-dark"           title="Dark Wood"    style="background:linear-gradient(135deg,#5C3A1E,#3A2410)"></div>
