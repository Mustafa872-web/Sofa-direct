function createDoorFrench(col) {
  const w = 1.4, h = 2.1;
  const g = new THREE.Group();
  const frameMat = new THREE.MeshStandardMaterial({ color: col || 0xFFFEFB, roughness: 0.5 });
  const glassMat = new THREE.MeshPhysicalMaterial({ color: 0xC4DCEC, transparent: true, opacity: 0.4, roughness: 0.05, metalness: 0.15, transmission: 0.6, clearcoat: 1, side: THREE.DoubleSide });
  for (let side = 0; side < 2; side++) {
