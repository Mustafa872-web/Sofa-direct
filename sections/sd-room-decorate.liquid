  back.position.set(0, 0.67, -0.36); back.castShadow = true; g.add(back);
  [-0.72, 0.72].forEach(x => {
    const arm = new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.35, 0.85), m.clone());
    arm.position.set(x, 0.52, 0); arm.castShadow = true; g.add(arm);
  });
  [[-0.65,0.12,0.32],[0.65,0.12,0.32],[-0.65,0.12,-0.32],[0.65,0.12,-0.32]].forEach(p => {
    const l = new THREE.Mesh(legGeo(), legMat); l.position.set(...p); l.castShadow=true; g.add(l);
  });
  const cm = makeMat(col, mtype || 'fabric'); cm.color.offsetHSL(0, 0, 0.04);
  [-0.36, 0.36].forEach(x => {
