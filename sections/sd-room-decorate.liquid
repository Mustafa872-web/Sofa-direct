function createDoorBarn(col) {
  const w = 1.1, h = 2.1;
  const g = new THREE.Group();
  const tex = _doorWoodTex('#7A4E2A', 0.22);
  const mat = new THREE.MeshStandardMaterial({ map: tex, color: col || 0x8B5C36, roughness: 0.75 });
  const door = new THREE.Mesh(new THREE.BoxGeometry(w, h, 0.045), mat);
  door.position.y = h/2; door.castShadow = true; g.add(door);
  // Diagonal X planks (rustic barn style)
  const plankMat = new THREE.MeshStandardMaterial({ color: 0x5A3018, roughness: 0.8 });
  const diag1 = new THREE.Mesh(new THREE.BoxGeometry(w*1.3, 0.1, 0.01), plankMat);
  diag1.rotation.z = Math.atan2(h, w); diag1.position.set(0, h/2, 0.025); g.add(diag1);
  const diag2 = diag1.clone(); diag2.rotation.z = -Math.atan2(h, w); g.add(diag2);
  // Top + bottom rails
  for (let y of [h*0.05, h*0.95]) {
    const rail = new THREE.Mesh(new THREE.BoxGeometry(w, 0.12, 0.01), plankMat);
    rail.position.set(0, y, 0.025); g.add(rail);
  }
  // Sliding track + rollers
  const trackMat = new THREE.MeshStandardMaterial({ color: 0x2A2A2A, metalness: 0.85, roughness: 0.3 });
  const track = new THREE.Mesh(new THREE.BoxGeometry(w*1.8, 0.04, 0.05), trackMat);
  track.position.set(0, h + 0.1, 0); g.add(track);
  for (let x of [-w*0.3, w*0.3]) {
    const roller = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.05, 0.03, 16), trackMat);
    roller.rotation.x = Math.PI/2; roller.position.set(x, h + 0.05, 0); g.add(roller);
  }
  // Pull handle (long horizontal)
  const handleMat = new THREE.MeshStandardMaterial({ color: 0x2A2A2A, metalness: 0.85, roughness: 0.3 });
  const pull = new THREE.Mesh(new THREE.CylinderGeometry(0.018, 0.018, 0.3, 12), handleMat);
  pull.rotation.z = Math.PI/2; pull.position.set(w/2 - 0.18, h*0.5, 0.04); g.add(pull);
  g.userData = { isFurniture: true, isOpening: true, openingType:'door', openingW: 1.1, name:'Barn Door', desc:'Sliding, 110×210cm', matType:'wood', matColor: col || '#8B5C36' };
  return g;
}

