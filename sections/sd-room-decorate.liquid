    const leaf = new THREE.Mesh(new THREE.BoxGeometry(w/2, h, 0.04), frameMat);
    leaf.position.set(x, h/2, 0); leaf.castShadow = true; g.add(leaf);
    const pane = new THREE.Mesh(new THREE.PlaneGeometry(w/2 - 0.18, h - 0.3), glassMat);
    pane.position.set(x, h/2, 0.025); g.add(pane);
    // 4-pane muntins
    const mh = new THREE.Mesh(new THREE.BoxGeometry(w/2 - 0.16, 0.025, 0.03), frameMat);
    mh.position.set(x, h/2, 0.03); g.add(mh);
    const mv = new THREE.Mesh(new THREE.BoxGeometry(0.025, h - 0.3, 0.03), frameMat);
    mv.position.set(x, h/2, 0.03); g.add(mv);
    _handle(g, side === 0 ? -0.05 : 0.05, h*0.46);
  }
  _frame(g, w, h, 0xF5F0E8);
  g.userData = { isFurniture: true, isOpening: true, openingType:'door', openingW: 1.4, name:'French Doors', desc:'Double glass, 140×210cm', matType:'wood', matColor: col || '#FFFEFB' };
