/* ===== TEXTURE / PRODUCT IMAGE APPLY ===== */
const texLoader = new THREE.TextureLoader();
texLoader.setCrossOrigin('anonymous');

function applyTextureToSelected(imgUrl, label) {
  if (!selectedObj) { showToast('Select an item first'); return; }
  // ─── Skip texture overlay on uploaded GLB models — keep original ───
  if (selectedObj.userData && (selectedObj.userData.isGLB || selectedObj.userData.isProduct)) {
    showToast('Original 3D model textures preserved');
    return;
  }
  if (selectedObj.userData && selectedObj.userData.isOpening) {
    return;
  }
  texLoader.load(imgUrl, (tex) => {
    tex.colorSpace = THREE.SRGBColorSpace;
    tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
    tex.anisotropy = renderer.capabilities.getMaxAnisotropy();
    let isFirst = true;
    selectedObj.traverse(c => {
      if (c.isMesh && c.material && !c.material._isLeg) {
        const m = new THREE.MeshStandardMaterial({
          map: tex,
          roughness: 0.75,
          metalness: 0,
          color: 0xffffff
        });
        m._origEmissive = 0;
        if (m.emissive) m.emissive.setHex(isFirst ? 0x221a10 : 0);
        c.material.dispose();
        c.material = m;
        isFirst = false;
      }
    });
    selectedObj.userData.textureUrl = imgUrl;
    selectedObj.userData.matColor = label || 'image';
    $('#current-mat').textContent = `image — ${label || 'custom'}`;
    showToast(`Applied: ${label || 'image'}`);
  }, undefined, () => {
    showToast('Image failed to load');
  });
}

