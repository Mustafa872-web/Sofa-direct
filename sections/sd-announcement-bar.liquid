{{ 'sd-announcement-bar.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign tp_rating = section.settings.tp_rating | default: '4.8'
  assign tp_count  = section.settings.tp_count  | default: '2,400'
  assign tp_url    = section.settings.tp_url
  assign tp_full   = tp_rating | times: 1.0 | floor
-%}

{%- comment -%} ═══════════════ ROW 1 — MARQUEE TICKER ═══════════════ {%- endcomment -%}
{%- if section.settings.show_marquee -%}
  <div class="sd-marquee-wrap">
  {%- if section.settings.mobile_image != blank -%}
    <div class="sd-marquee-wrap__img">
      {{
        section.settings.mobile_image
        | image_url: width: 1400
        | image_tag: loading: 'lazy', class: 'sd-marquee-wrap__img-el', alt: section.settings.mobile_image.alt
      }}
    </div>
  {%- endif -%}
  <div class="sd-marquee" role="region" aria-label="Promotions">
    <div class="sd-marquee__viewport">
      <div class="sd-marquee__track" aria-hidden="false">
        {%- comment -%} Render the items twice for a seamless loop {%- endcomment -%}
        {%- for cycle in (1..2) -%}
          <div class="sd-marquee__group" {% if cycle == 2 %}aria-hidden="true"{% endif %}>
            {%- for block in section.blocks -%}
              {%- if block.type == 'marquee_item' -%}
                {%- liquid
                  assign icon = block.settings.icon | default: 'sparkle'
                  assign url = block.settings.url
                -%}
                {%- if url != blank -%}
                  <a href="{{ url }}" class="sd-marquee__item" {{ block.shopify_attributes }}>
                {%- else -%}
                  <span class="sd-marquee__item" {{ block.shopify_attributes }}>
                {%- endif -%}
                  <span class="sd-marquee__icon" aria-hidden="true">
                    {%- case icon -%}
                      {%- when 'flower' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c1.5 0 2.7 1 3.2 2.4.4-.2.9-.4 1.5-.4 1.8 0 3.3 1.5 3.3 3.3 0 .6-.2 1.1-.4 1.5 1.4.5 2.4 1.7 2.4 3.2s-1 2.7-2.4 3.2c.2.4.4.9.4 1.5 0 1.8-1.5 3.3-3.3 3.3-.6 0-1.1-.2-1.5-.4-.5 1.4-1.7 2.4-3.2 2.4s-2.7-1-3.2-2.4c-.4.2-.9.4-1.5.4-1.8 0-3.3-1.5-3.3-3.3 0-.6.2-1.1.4-1.5C3 14.7 2 13.5 2 12s1-2.7 2.4-3.2c-.2-.4-.4-.9-.4-1.5 0-1.8 1.5-3.3 3.3-3.3.6 0 1.1.2 1.5.4C9.3 3 10.5 2 12 2z"/><circle cx="12" cy="12" r="3" fill="#fff" opacity=".4"/></svg>
                      {%- when 'truck' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="14" height="10" rx="1"/><path d="M15 9h4l3 3v4h-7"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
                      {%- when 'credit' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h2M11 15h2"/></svg>
                      {%- when 'shield' -%}
                        <svg width="47" height="56" viewBox="0 0 47 56" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M23.6711 3.08936C23.3623 2.95745 23.0587 2.88006 22.7268 2.92432C22.4921 3.02738 22.2708 3.14168 22.0491 3.25635C21.8218 3.3739 21.5932 3.49278 21.3567 3.59717C19.6428 4.35332 17.9053 5.17101 16.1624 5.87451H16.1614C12.8896 7.1755 9.53773 8.26648 6.1272 9.14111C5.90895 9.19656 5.68819 9.24248 5.46997 9.28564L4.82153 9.41846C4.52205 9.48629 4.22271 9.56004 3.92212 9.63428C3.66165 9.69861 3.3995 9.76126 3.13696 9.82178C3.15032 10.1404 3.15442 10.4606 3.15161 10.7798L3.14185 11.853C3.15985 13.2872 3.16146 14.7215 3.14673 16.1558C3.13444 20.2077 3.15237 24.295 3.18481 28.3481C3.19205 29.2541 3.13263 30.1366 3.18872 31.0229C3.82164 36.7036 7.27096 41.5485 11.4055 45.3354C14.1444 47.8439 17.5174 50.171 20.7942 51.8989L21.345 52.1851C21.8922 52.4637 22.439 52.7214 23.0129 52.939C23.1267 52.9696 23.3029 52.9539 23.5334 52.8872C23.7604 52.8215 24.0178 52.714 24.2795 52.5874C24.8034 52.334 25.3245 52.016 25.6292 51.8384C32.5868 47.7776 39.6661 42.0534 42.2131 34.1597C42.8432 32.2069 42.8623 30.1356 42.8567 28.0972L42.8547 23.8872L42.8596 13.7222V13.7212C42.8624 12.9472 42.8606 12.1729 42.8547 11.3989C42.8507 10.9445 42.8332 10.3037 42.8674 9.81689C37.7191 8.71972 32.6933 7.11046 27.8655 5.01221H27.8635L24.6438 3.56982V3.56885C24.4729 3.49125 24.3059 3.40418 24.1458 3.3208C23.9842 3.2367 23.8284 3.15656 23.6711 3.08936ZM45.3323 18.4185L45.3489 24.5142C45.3679 26.4858 45.4166 28.75 45.3313 30.7212V30.7231C45.2836 31.6344 45.1738 32.5414 45.0042 33.438V33.439C44.5697 35.6383 43.2163 38.5944 41.9768 40.5229C38.329 46.199 32.5963 50.7576 26.762 54.0142C26.3954 54.2188 25.8403 54.5208 25.2834 54.7944C24.7305 55.0661 24.1619 55.3165 23.7727 55.4106L23.7629 55.4136V55.4126C23.4393 55.469 22.9671 55.4882 22.6301 55.3677C20.4043 54.5706 17.8717 53.1955 15.802 51.8442L14.9456 51.2681C8.68667 46.9102 2.58067 40.8794 0.987549 33.0952C0.528325 30.8513 0.671491 28.2597 0.672119 25.9858L0.673096 18.2446L0.668213 12.6606V12.6597C0.667773 11.6625 0.642357 10.6252 0.698486 9.64502V9.64