                      {%- when 'heart' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.5-9.5-9C.5 8 3 4 7 4c2 0 3.5 1 5 3 1.5-2 3-3 5-3 4 0 6.5 4 4.5 8C19 16.5 12 21 12 21z"/></svg>
                      {%- else -%}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 5.5L19.5 9l-4.7 3.5L16.3 18 12 14.8 7.7 18l1.5-5.5L4.5 9l5.7-1.5L12 2z"/></svg>
                    {%- endcase -%}
