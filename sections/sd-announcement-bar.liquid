                  <span class="sd-marquee__text">{{ block.settings.text }}</span>
                {%- if url != blank -%}
                  </a>
                {%- else -%}
                  </span>
                {%- endif -%}

                {%- unless forloop.last -%}
                  <span class="sd-marquee__dot" aria-hidden="true"></span>
                {%- endunless -%}
              {%- endif -%}
            {%- endfor -%}
            <span class="sd-marquee__dot" aria-hidden="true"></span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
  </div>
{%- endif -%}

{%- comment -%} ═══════════════ ROW 2 — UNIFIED SALE + TRUST BANNER ═══════════════ {%- endcomment -%}
{%- liquid
  assign sale_text = section.settings.sale_text | default: 'Spring Sale — Up to 50% Off'
  assign sale_cta  = section.settings.sale_cta  | default: 'Shop Now'
  assign sale_url  = section.settings.sale_url
  assign sale_sub  = section.settings.sale_sub  | default: 'Free UK delivery · 0% finance available · Ends soon'
-%}
{%- if section.settings.show_sale or section.settings.show_trustpilot -%}
<div class="sd-ann2" role="region" aria-label="Sale and customer reviews">
  <div class="sd-ann2__bg" aria-hidden="true">
    <span class="sd-ann2__petal sd-ann2__petal--1"></span>
    <span class="sd-ann2__petal sd-ann2__petal--2"></span>
    <span class="sd-ann2__shimmer"></span>
  </div>

  <div class="sd-ann2__inner">

    {%- comment -%} ── LEFT — Call CTA ── {%- endcomment -%}
    {%- assign ab_phone = section.settings.phone_number -%}
    {%- if ab_phone != blank -%}
      <a href="tel:{{ ab_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}" class="sd-ann2__call" aria-label="Call {{ ab_phone }}">
        <span class="sd-ann2__call-icon" aria-hidden="true">
          <span class="sd-ann2__call-ring"></span>
          <span class="sd-ann2__call-ring sd-ann2__call-ring--2"></span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </span>
        <span class="sd-ann2__call-text">
          {%- if section.settings.phone_label != blank -%}
            <span class="sd-ann2__call-label">{{ section.settings.phone_label }}</span>
          {%- endif -%}
          <strong class="sd-ann2__call-num">{{ ab_phone }}</strong>
        </span>
      </a>
    {%- else -%}
      <span class="sd-ann2__spacer" aria-hidden="true"></span>
    {%- endif -%}

    {%- comment -%} ── CENTER — Sale message ── {%- endcomment -%}
    {%- if section.settings.show_sale -%}
      <div class="sd-ann2__sale">
        <span class="sd-ann2__sale-flower" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2c1.5 0 2.7 1 3.2 2.4.4-.2.9-.4 1.5-.4 1.8 0 3.3 1.5 3.3 3.3 0 .6-.2 1.1-.4 1.5 1.4.5 2.4 1.7 2.4 3.2s-1 2.7-2.4 3.2c.2.4.4.9.4 1.5 0 1.8-1.5 3.3-3.3 3.3-.6 0-1.1-.2-1.5-.4-.5 1.4-1.7 2.4-3.2 2.4s-2.7-1-3.2-2.4c-.4.2-.9.4-1.5.4-1.8 0-3.3-1.5-3.3-3.3 0-.6.2-1.1.4-1.5C3 14.7 2 13.5 2 12s1-2.7 2.4-3.2c-.2-.4-.4-.9-.4-1.5 0-1.8 1.5-3.3 3.3-3.3.6 0 1.1.2 1.5.4C9.3 3 10.5 2 12 2z"/>
            <circle cx="12" cy="12" r="3.2" fill="#fff" opacity=".7"/>
          </svg>
        </span>
        <span class="sd-ann2__sale-text">
          <span class="sd-ann2__sale-eyebrow">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24" stroke="currentColor" stroke-width="2"/></svg>
            Limited Time
          </span>
          <span class="sd-ann2__sale-headline">{{ sale_text }}</span>
        </span>
        {%- if sale_url != blank and sale_cta != blank -%}
          <a href="{{ sale_url }}" class="sd-ann2__sale-cta">
            <span>{{ sale_cta }}</span>
            <span class="sd-ann2__sale-cta-arrow" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} ── RIGHT — Premium Benefits Capsule ── {%- endcomment -%}
    <aside class="sd-ann2__capsule" aria-label="Today's benefits">
      <span class="sd-ann2__capsule-edge" aria-hidden="true"></span>
      <header class="sd-ann2__capsule-head">
        <span class="sd-ann2__capsule-dot" aria-hidden="true"></span>
        <span class="sd-ann2__capsule-eyebrow">Today's Benefits</span>
        <span class="sd-ann2__capsule-badge">VERIFIED</span>
      </header>
      <ul class="sd-ann2__capsule-list">
        <li class="sd-ann2__capsule-item">
          <span class="sd-ann2__capsule-check" aria-hidden="true">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <span class="sd-ann2__capsule-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="14" height="10" rx="1"/><path d="M15 9h4l3 3v4h-7"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
          </span>
          <span class="sd-ann2__capsule-label">Free UK Delivery</span>
        </li>
        <li class="sd-ann2__capsule-item">
          <span class="sd-ann2__capsule-check" aria-hidden="true">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <span class="sd-ann2__capsule-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
          </span>
          <span class="sd-ann2__capsule-label">0% Finance</span>
        </li>
        <li class="sd-ann2__capsule-item">
          <span class="sd-ann2__capsule-check" aria-hidden="true">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <span class="sd-ann2__capsule-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 6v6c0 5 3.5 9.5 8 10 4.5-.5 8-5 8-10V6l-8-4z"/><path d="m9 12 2 2 4-4"/></svg>
          </span>
          <span class="sd-ann2__capsule-label">5-Year Warranty</span>
        </li>
      </ul>
    </aside>

  </div>
</div>
{%- endif -%}

{%- comment -%}
  Mobile (≤749px): lift the running marquee to the very top of the header
  (above the topbar), matching the live site. Restores into its own section
  on desktop, where CSS hides it.
{%- endcomment -%}
<script>
  (function () {
    var section = document.getElementById('shopify-section-sd-announcement-bar');
    var marquee = section ? section.querySelector('.sd-marquee-wrap') : document.querySelector('.sd-marquee-wrap');
    if (!marquee || !section) return;
    var mq = window.matchMedia('(max-width: 749px)');

    function place() {
      var topbar = document.getElementById('shopify-section-sd-topbar');
      if (mq.matches && topbar) {
        if (topbar.previousElementSibling !== marquee) {
          topbar.parentNode.insertBefore(marquee, topbar);
        }
      } else if (marquee.parentNode !== section) {
        section.insertBefore(marquee, section.firstChild);
      }
    }

    // Wait for the topbar section to exist in the DOM before placing.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', place);
    } else {
      place();
    }
    if (mq.addEventListener) mq.addEventListener('change', place);
    else mq.addListener(place);
    window.addEventListener('resize', place);
  })();
</script>

{% schema %}
{
  "name": "SD Announcement Bar",
  "class": "sd-announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Row 1 — Marquee ticker"
    },
    {
      "type": "checkbox",
      "id": "show_marquee",
      "label": "Show marquee strip",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image (above marquee)",
      "info": "Shows full-width above the marquee on mobile only."
    },
    {
      "type": "header",
      "content": "Row 2 — Spring Sale callout"
    },
    {
      "type": "checkbox",
      "id": "show_sale",
      "label": "Show Spring Sale",
      "default": true
    },
    {
      "type": "text",
      "id": "sale_text",
      "label": "Sale text",
      "default": "Spring Sale — Up to 50% Off"
    },
    {
      "type": "text",
      "id": "sale_cta",
      "label": "CTA label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "sale_url",
      "label": "Sale link"
    },
    {
