<link rel="stylesheet" href="{{ 'sd-all-collections.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'sd-all-collections.css' | asset_url | stylesheet_tag }}</noscript>

{%- liquid
  assign sorted_collections = collections

  case section.settings.sort
    when 'alphabetical'
      assign sorted_collections = collections | sort: 'title'
    when 'alphabetical_reversed'
      assign sorted_collections = collections | sort: 'title' | reverse
    when 'date'
      assign sorted_collections = collections | sort: 'published_at'
    when 'date_reversed'
      assign sorted_collections = collections | sort: 'published_at' | reverse
    when 'products_low'
      assign sorted_collections = collections | sort: 'all_products_count'
    when 'products_high'
      assign sorted_collections = collections | sort: 'all_products_count' | reverse
  endcase

  assign featured_collection_1 = section.settings.featured_collection_1
  assign featured_collection_2 = section.settings.featured_collection_2

  if featured_collection_1 == blank and sorted_collections.size > 0
    assign featured_collection_1 = sorted_collections.first
  endif

  if featured_collection_2 == blank and sorted_collections.size > 1
    assign featured_collection_2 = sorted_collections[1]
  endif

  assign show_filters = false
  if section.blocks.size > 0
    assign show_filters = true
  endif

  assign has_hero_image_mobile = false
  if section.settings.hero_image_mobile != blank
    assign has_hero_image_mobile = true
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section id="SDAllCollections-{{ section.id }}" class="sd-all-collections section-{{ section.id }}-padding">
  <div class="sd-all-collections__shape sd-all-collections__shape--one" aria-hidden="true"></div>
  <div class="sd-all-collections__shape sd-all-collections__shape--two" aria-hidden="true"></div>

  <div class="sd-all-collections__container page-width">
    <header class="sd-all-collections__hero sd-ac-reveal" data-reveal>
      <div class="sd-all-collections__hero-media{% if has_hero_image_mobile %} sd-all-collections__hero-media--has-mobile{% endif %}">
        {%- if section.settings.hero_image != blank -%}
          {{
            section.settings.hero_image
            | image_url: width: 2200
            | image_tag:
              class: 'sd-all-collections__hero-image sd-all-collections__hero-image--desktop',
              widths: '900,1400,1800,2200',
              sizes: '100vw',
              alt: section.settings.heading,
              loading: 'eager',
              fetchpriority: 'high'
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'sd-all-collections__hero-image sd-all-collections__hero-image--desktop' }}
        {%- endif -%}

        {%- if section.settings.hero_image_mobile != blank -%}
          {{
            section.settings.hero_image_mobile
            | image_url: width: 900
            | image_tag:
              class: 'sd-all-collections__hero-image sd-all-collections__hero-image--mobile',
              widths: '375,550,750,900',
              sizes: '100vw',
              alt: section.settings.heading,
              loading: 'eager',
              fetchpriority: 'high'
          }}
        {%- endif -%}

        <div class="sd-all-collections__hero-overlay" aria-hidden="true"></div>
      </div>

      <div class="sd-all-collections__hero-content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="sd-all-collections__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h1 class="sd-all-collections__title">{{ section.settings.heading }}</h1>
        {%- if section.settings.subheading != blank -%}
          <p class="sd-all-collections__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.hero_cta_label != blank -%}
          <a href="{{ section.settings.hero_cta_url | default: routes.collections_url }}" class="sd-all-collections__hero-btn">
            {{ section.settings.hero_cta_label }}
          </a>
        {%- endif -%}
      </div>
    </header>

    {%- if section.settings.show_featured and featured_collection_1 != blank -%}
      <section class="sd-all-collections__featured sd-ac-reveal" data-reveal>
        <div class="sd-all-collections__section-head">
          <h2 class="sd-all-collections__section-title">{{ section.settings.featured_heading }}</h2>
          {%- if section.settings.featured_text != blank -%}
            <p class="sd-all-collections__section-copy">{{ section.settings.featured_text }}</p>
          {%- endif -%}
        </div>

        <div class="sd-all-collections__featured-grid">
          {%- liquid
            assign featured_1_image = featured_collection_1.featured_image
            if featured_1_image == blank and featured_collection_1.products.first.featured_image != blank
              assign featured_1_image = featured_collection_1.products.first.featured_image
            endif
          -%}
          <article class="sd-feature-collection sd-feature-collection--primary">
            <a href="{{ featured_collection_1.url }}" class="sd-feature-collection__media">
              {%- if featured_1_image != blank -%}
                {{
                  featured_1_image
                  | image_url: width: 1500
                  | image_tag:
                    class: 'sd-feature-collection__image',
                    widths: '650,900,1200,1500',
                    sizes: '(min-width: 1200px) 62vw, 100vw',
                    alt: featured_collection_1.title,
                    loading: 'lazy'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'sd-feature-collection__image' }}
              {%- endif -%}
              <span class="sd-feature-collection__glow" aria-hidden="true"></span>
            </a>
            <div class="sd-feature-collection__content">
              <p class="sd-feature-collection__meta">{{ featured_collection_1.all_products_count }} products</p>
              <h3 class="sd-feature-collection__title">{{ featured_collection_1.title }}</h3>
              <a href="{{ featured_collection_1.url }}" class="sd-feature-collection__cta">Shop Now -></a>
            </div>
          </article>

          {%- if featured_collection_2 != blank -%}
            {%- liquid
              assign featured_2_image = featured_collection_2.featured_image
              if featured_2_image == blank and featured_collection_2.products.first.featured_image != blank
                assign featured_2_image = featured_collection_2.products.first.featured_image
              endif
            -%}
            <article class="sd-feature-collection sd-feature-collection--secondary">
              <a href="{{ featured_collection_2.url }}" class="sd-feature-collection__media">
                {%- if featured_2_image != blank -%}
                  {{
                    featured_2_image
                    | image_url: width: 1100
                    | image_tag:
                      class: 'sd-feature-collection__image',
                      widths: '520,750,900,1100',
                      sizes: '(min-width: 1200px) 36vw, 100vw',
                      alt: featured_collection_2.title,
                      loading: 'lazy'
                  }}
                {%- else -%}
                  {{ 'collection-2' | placeholder_svg_tag: 'sd-feature-collection__image' }}
                {%- endif -%}
                <span class="sd-feature-collection__glow" aria-hidden="true"></span>
              </a>
              <div class="sd-feature-collection__content">
                <p class="sd-feature-collection__meta">{{ featured_collection_2.all_products_count }} products</p>
                <h3 class="sd-feature-collection__title">{{ featured_collection_2.title }}</h3>
                <a href="{{ featured_collection_2.url }}" class="sd-feature-collection__cta">Shop Now -></a>
              </div>
            </article>
          {%- endif -%}
        </div>
      </section>
    {%- endif -%}

    {%- if show_filters -%}
      <nav class="sd-all-collections__filters sd-ac-reveal" data-reveal data-filter-nav aria-label="Collection filters">
        {%- for block in section.blocks -%}
          {%- assign filter_term = block.settings.term | strip | downcase -%}
          {%- if filter_term == blank -%}
            {%- assign filter_term = 'all' -%}
          {%- endif -%}
          <button
            type="button"
            class="sd-all-collections__filter-btn{% if forloop.first %} is-active{% endif %}"
            data-filter-term="{{ filter_term | escape }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.label }}
          </button>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <section class="sd-all-collections__catalog sd-ac-reveal" data-reveal>
      <div class="sd-all-collections__section-head">
        <h2 class="sd-all-collections__section-title">{{ section.settings.grid_heading }}</h2>
        {%- if section.settings.grid_text != blank -%}
          <p class="sd-all-collections__section-copy">{{ section.settings.grid_text }}</p>
        {%- endif -%}
      </div>

      {%- paginate sorted_collections by section.settings.collections_per_page -%}
        <ul
          class="sd-all-collections__grid"
          role="list"
          data-collection-grid
          style="--sd-ac-grid-cols: {{ section.settings.desktop_columns }};"
        >
          {%- for collection in paginate.items -%}
            {%- liquid
              assign skip_item = false
              if section.settings.show_featured and section.settings.hide_featured_from_grid
                if featured_collection_1 != blank and collection.handle == featured_collection_1.handle
                  assign skip_item = true
                endif
                if featured_collection_2 != blank and collection.handle == featured_collection_2.handle
                  assign skip_item = true
                endif
              endif
            -%}
            {%- unless skip_item -%}
              {%- liquid
                assign card_image = collection.featured_image
                if card_image == blank and collection.products.first.featured_image != blank
                  assign card_image = collection.products.first.featured_image
                endif
              -%}
              <li
                class="sd-collection-card"
                data-filter-target
                data-filter-content="{{ collection.title | downcase | escape }} {{ collection.handle | downcase | escape }} {{ collection.description | strip_html | downcase | escape }}"
              >
                <a href="{{ collection.url }}" class="sd-collection-card__media">
                  {%- if card_image != blank -%}
                    {{
                      card_image
                      | image_url: width: 1100
                      | image_tag:
                        class: 'sd-collection-card__image',
                        widths: '320,460,620,820,1100',
                        sizes: '(min-width: 1500px) 22vw, (min-width: 1200px) 25vw, (min-width: 750px) 49vw, 100vw',
                        alt: collection.title,
                        loading: 'lazy'
                    }}
                  {%- else -%}
                    {{ 'collection-3' | placeholder_svg_tag: 'sd-collection-card__image' }}
                  {%- endif -%}
                  <div class="sd-collection-card__overlay" aria-hidden="true"></div>
                  <span class="sd-collection-card__cta">Shop Now</span>
                </a>

                <div class="sd-collection-card__body">
                  {%- if section.settings.show_product_count -%}
                    <p class="sd-collection-card__meta">{{ collection.all_products_count }} products</p>
                  {%- endif -%}
                  <h3 class="sd-collection-card__title">
                    <a href="{{ collection.url }}">{{ collection.title }}</a>
                  </h3>
                  {%- if section.settings.show_collection_description and collection.description != blank -%}
                    <p class="sd-collection-card__excerpt">
                      {{ collection.description | strip_html | truncatewords: 18 }}
                    </p>
                  {%- endif -%}
                </div>
              </li>
            {%- endunless -%}
          {%- endfor -%}
        </ul>

        <p class="sd-all-collections__empty is-hidden" data-filter-empty>{{ section.settings.empty_text }}</p>

        {%- if paginate.pages > 1 -%}
          <nav class="sd-all-collections__pagination" role="navigation" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a class="sd-all-collections__page-btn" href="{{ paginate.previous.url }}">Previous</a>
            {%- endif -%}

            <div class="sd-all-collections__page-list">
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a class="sd-all-collections__page-link" href="{{ part.url }}">{{ part.title }}</a>
                {%- else -%}
                  <span class="sd-all-collections__page-link{% if part.title == paginate.current_page %} is-active{% endif %}">
                    {{ part.title }}
                  </span>
                {%- endif -%}
              {%- endfor -%}
            </div>

            {%- if paginate.next -%}
              <a class="sd-all-collections__page-btn" href="{{ paginate.next.url }}">Next</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    </section>

    {%- if section.settings.show_promo and section.settings.promo_heading != blank -%}
      <section class="sd-all-collections__promo sd-ac-reveal" data-reveal>
        <div class="sd-all-collections__promo-content">
          <h2 class="sd-all-collections__promo-title">{{ section.settings.promo_heading }}</h2>
          {%- if section.settings.promo_text != blank -%}
            <p class="sd-all-collections__promo-text">{{ section.settings.promo_text }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.promo_button_label != blank -%}
          <a class="sd-all-collections__promo-btn" href="{{ section.settings.promo_button_link | default: routes.collections_url }}">
            {{ section.settings.promo_button_label }}
          </a>
        {%- endif -%}
      </section>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('SDAllCollections-{{ section.id }}');
    if (!root) return;

    var revealEls = root.querySelectorAll('[data-reveal]');
    if ('IntersectionObserver' in window) {
      var revealObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.16 });

      revealEls.forEach(function (el) { revealObserver.observe(el); });
    } else {
      revealEls.forEach(function (el) { el.classList.add('is-visible'); });
    }

    var filterNav = root.querySelector('[data-filter-nav]');
    if (!filterNav) return;

    var buttons = Array.prototype.slice.call(filterNav.querySelectorAll('[data-filter-term]'));
    var cards = Array.prototype.slice.call(root.querySelectorAll('[data-filter-target]'));
    var emptyState = root.querySelector('[data-filter-empty]');

    function applyFilter(term) {
      var normalized = (term || 'all').toLowerCase();
      var visibleCount = 0;

      buttons.forEach(function (button) {
        var isActive = (button.getAttribute('data-filter-term') || 'all') === normalized;
        button.classList.toggle('is-active', isActive);
      });

      cards.forEach(function (card) {
        var content = (card.getAttribute('data-filter-content') || '').toLowerCase();
        var isMatch = normalized === 'all' || normalized === '' || content.indexOf(normalized) !== -1;
        card.classList.toggle('is-hidden', !isMatch);
        if (isMatch) visibleCount += 1;
      });

      if (emptyState) {
        emptyState.classList.toggle('is-hidden', visibleCount !== 0);
      }
    }

    buttons.forEach(function (button) {
      button.addEventListener('click', function () {
        applyFilter(button.getAttribute('data-filter-term'));
      });
    });

    var urlHash = window.location.hash.replace('#', '').trim().toLowerCase();
    if (urlHash) {
      var matchingButton = buttons.find(function (button) {
        return (button.getAttribute('data-filter-term') || 'all') === urlHash;
      });
      if (matchingButton) {
        applyFilter(matchingButton.getAttribute('data-filter-term'));
        return;
      }
    }

    if (buttons[0]) {
      applyFilter(buttons[0].getAttribute('data-filter-term'));
    }
  })();
</script>

{% schema %}
{
  "name": "SD All Collections",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Hero eyebrow",
      "default": "Curated for modern homes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Hero heading",
      "default": "Explore Our Collections"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Hero subheading",
      "default": "Discover handcrafted comfort, statement silhouettes, and timeless textures designed to elevate every living space."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Hero image (mobile)"
    },
    {
      "type": "text",
      "id": "hero_cta_label",
      "label": "Hero button label",
      "default": "Shop Sofas"
    },
    {
      "type": "url",
      "id": "hero_cta_url",
      "label": "Hero button link"
    },
    {
      "type": "header",
      "content": "Featured Collections"
    },
    {
      "type": "checkbox",
      "id": "show_featured",
      "label": "Show featured collections",
      "default": true
    },
    {
      "type": "collection",
      "id": "featured_collection_1",
      "label": "Featured collection 1"
    },
    {
      "type": "collection",
      "id": "featured_collection_2",
      "label": "Featured collection 2"
    },
    {
      "type": "checkbox",
      "id": "hide_featured_from_grid",
      "label": "Hide featured collections from main grid",
      "default": false
    },
    {
      "type": "text",
      "id": "featured_heading",
      "label": "Featured heading",
      "default": "Featured Collections"
    },
    {
      "type": "textarea",
      "id": "featured_text",
      "label": "Featured text",
      "default": "Start with our most-loved ranges and find the style that fits your home."
    },
    {
      "type": "header",
      "content": "Collection Grid"
    },
    {
      "type": "text",
      "id": "grid_heading",
      "label": "Grid heading",
      "default": "All Collections"
    },
    {
      "type": "textarea",
      "id": "grid_text",
      "label": "Grid text",
      "default": "Browse every collection with premium visuals, clear structure, and seamless navigation."
    },
    {
      "type": "select",
      "id": "sort",
      "label": "Sort collections by",
      "default": "alphabetical",
      "options": [
        { "value": "alphabetical", "label": "Alphabetical (A-Z)" },
        { "value": "alphabetical_reversed", "label": "Alphabetical (Z-A)" },
        { "value": "date_reversed", "label": "Newest first" },
        { "value": "date", "label": "Oldest first" },
        { "value": "products_high", "label": "Most products first" },
        { "value": "products_low", "label": "Fewest products first" }
      ]
    },
    {
      "type": "range",
      "id": "collections_per_page",
      "label": "Collections per page",
      "min": 6,
      "max": 36,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "Show short description",
      "default": true
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "No collections matched this filter. Try another category."
    },
    {
      "type": "header",
      "content": "Promo Banner"
    },
    {
      "type": "checkbox",
      "id": "show_promo",
      "label": "Show promo banner",
      "default": true
    },
    {
      "type": "text",
      "id": "promo_heading",
      "label": "Promo heading",
      "default": "Find Your Perfect Sofa"
    },
    {
      "type": "textarea",
      "id": "promo_text",
      "label": "Promo text",
      "default": "From compact styles to spacious statement pieces, discover the one that transforms your room."
    },
    {
      "type": "text",
      "id": "promo_button_label",
      "label": "Promo button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "promo_button_link",
      "label": "Promo button link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Filter tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "All"
        },
        {
          "type": "text",
          "id": "term",
          "label": "Filter term",
          "info": "Use 'all' to show every collection, or words like sofas, chairs, beds.",
          "default": "all"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "SD All Collections",
      "blocks": [
        { "type": "filter", "settings": { "label": "All", "term": "all" } },
        { "type": "filter", "settings": { "label": "Sofas", "term": "sofa" } },
        { "type": "filter", "settings": { "label": "Chairs", "term": "chair" } },
        { "type": "filter", "settings": { "label": "Beds", "term": "bed" } }
      ]
    }
  ]
}
{% endschema %}
