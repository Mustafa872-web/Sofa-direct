<link rel="stylesheet" href="{{ 'sd-blog.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'sd-blog.css' | asset_url | stylesheet_tag }}</noscript>

{%- liquid
  assign badge_text   = section.settings.badge_text   | default: 'Inspiration'
  assign heading      = section.settings.heading      | default: 'Stories, guides & sofa inspiration.'
  assign subheading   = section.settings.subheading
  assign blog         = blogs[section.settings.blog]
  assign post_count   = section.settings.posts_to_show | default: 3
  assign cta_label    = section.settings.cta_label    | default: 'View All Articles'
  assign cta_url      = section.settings.cta_url
  if cta_url == blank and blog != blank
    assign cta_url = blog.url
  endif
-%}

<section
  id="sd-blog-{{ section.id }}"
  class="sd-blog{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
  aria-label="{{ heading | escape }}"
>
  <div class="sd-blog__container page-width">

    <header class="sd-blog__header">
      {%- if badge_text != blank -%}
        <span class="sd-badge sd-blog__badge">{{ badge_text }}</span>
      {%- endif -%}
      {%- if heading != blank -%}
        <h2 class="sd-blog__heading">{{ heading }}</h2>
      {%- endif -%}
      {%- if subheading != blank -%}
        <p class="sd-blog__subheading">{{ subheading }}</p>
      {%- endif -%}
    </header>

    {%- if blog != blank and blog.articles.size > 0 -%}
      <div class="sd-blog__grid" data-count="{{ post_count }}">
        {%- for article in blog.articles limit: post_count -%}
          <article class="sd-blog-card">
            <a href="{{ article.url }}" class="sd-blog-card__media" aria-label="{{ article.title | escape }}">
              {%- if article.image != blank -%}
                {{
                  article.image
                  | image_url: width: 800
                  | image_tag:
                    class: 'sd-blog-card__img',
                    widths: '400,600,800,1000',
                    sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 90vw',
                    alt: article.image.alt | default: article.title,
                    loading: 'lazy'
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'sd-blog-card__img sd-blog-card__img--ph' }}
              {%- endif -%}

              {%- if article.tags.size > 0 -%}
                <span class="sd-blog-card__tag">{{ article.tags.first }}</span>
              {%- endif -%}
            </a>

            <div class="sd-blog-card__body">
              <div class="sd-blog-card__meta">
                <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                  {{ article.published_at | date: '%d %b %Y' }}
                </time>
                {%- if article.author != blank -%}
                  <span class="sd-blog-card__dot" aria-hidden="true">•</span>
                  <span>{{ article.author }}</span>
                {%- endif -%}
              </div>

              <h3 class="sd-blog-card__title">
                <a href="{{ article.url }}">{{ article.title | escape }}</a>
              </h3>

              {%- if section.settings.show_excerpt -%}
                <p class="sd-blog-card__excerpt">
                  {{ article.excerpt_or_content | strip_html | truncatewords: 22 }}
                </p>
              {%- endif -%}

              <a href="{{ article.url }}" class="sd-blog-card__link">
                Read more
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if cta_label != blank and cta_url != blank -%}
        <div class="sd-blog__cta-wrap">
          <a href="{{ cta_url }}" class="sd-blog__cta">
            {{ cta_label }}
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      {%- endif -%}

    {%- else -%}
      <div class="sd-blog__empty">
        <p>{{ 'sections.featured_blog.onboarding_content' | t | default: 'Pick a blog from the section settings to feature articles here.' }}</p>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "SD Blog",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge label",
      "default": "Inspiration"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stories, guides & sofa inspiration."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Style tips, fabric guides and behind-the-scenes from the Sofa Direct team."
    },
    {
      "type": "header",
      "content": "Articles"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Source blog"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "label": "Number of posts",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show article excerpt",
      "default": true
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "View All Articles"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link",
      "info": "Leave blank to link to the source blog page."
    }
  ],
  "presets": [
    {
      "name": "SD Blog",
      "settings": {
        "badge_text": "Inspiration",
        "heading": "Stories, guides & sofa inspiration.",
        "subheading": "Style tips, fabric guides and behind-the-scenes from the Sofa Direct team.",
        "posts_to_show": 3,
        "show_excerpt": true,
        "cta_label": "View All Articles"
      }
    }
  ]
}
{% endschema %}
