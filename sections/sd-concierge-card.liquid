<link rel="stylesheet" href="{{ 'sd-concierge-card.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'sd-concierge-card.css' | asset_url | stylesheet_tag }}</noscript>

{%- liquid
  assign eyebrow      = section.settings.eyebrow      | default: 'Our Concierge'
  assign heading      = section.settings.heading      | default: 'Talk to a real sofa expert.'
  assign subheading   = section.settings.subheading   | default: 'Need help choosing fabric, sizing for your room, or timing your delivery? Our UK team is just a call away.'
  assign phone_label  = section.settings.phone_label  | default: 'Direct Line'
  assign phone_number = section.settings.phone_number | default: '02476 581 053'
  assign phone_hours  = section.settings.phone_hours  | default: 'Mon–Sat 08:00 – 18:00'
  assign cta_label    = section.settings.cta_label    | default: 'Call the team'
  assign image        = section.settings.image
  assign image_alt    = section.settings.image_alt    | default: 'Our customer service team'
  assign image_pos    = section.settings.image_position | default: 'left'
  assign tel_clean    = phone_number | remove: ' ' | remove: '(' | remove: ')' | remove: '-'
-%}

<section
  id="sd-cc-{{ section.id }}"
  class="sd-cc{% if image_pos == 'right' %} sd-cc--reverse{% endif %}"
  aria-label="{{ heading | escape }}"
>
  <div class="sd-cc__container page-width">
    <div class="sd-cc__card">

      {%- comment -%} ── Image side ── {%- endcomment -%}
      <div class="sd-cc__media">
        {%- if image != blank -%}
          {{
            image
            | image_url: width: 1200
            | image_tag:
              class: 'sd-cc__img',
              widths: '400,600,800,1000,1200',
              sizes: '(min-width: 990px) 45vw, 100vw',
              alt: image_alt,
              loading: 'lazy'
          }}
        {%- else -%}
          <div class="sd-cc__img sd-cc__img--ph" aria-hidden="true">
            <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 44h48v8H8zM14 44V28a4 4 0 0 1 4-4h28a4 4 0 0 1 4 4v16M10 44v6M54 44v6M18 32h28v8H18z"/>
            </svg>
            <span>Add a showroom or team photo</span>
          </div>
        {%- endif -%}
        <span class="sd-cc__media-tag">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/>
          </svg>
          UK-based team
        </span>
      </div>

      {%- comment -%} ── Content side ── {%- endcomment -%}
      <div class="sd-cc__body">
        {%- if eyebrow != blank -%}
          <span class="sd-cc__eyebrow">
            <span class="sd-cc__eyebrow-line"></span>
            {{ eyebrow }}
          </span>
        {%- endif -%}

        {%- if heading != blank -%}
          <h2 class="sd-cc__heading">{{ heading }}</h2>
        {%- endif -%}

        {%- if subheading != blank -%}
          <p class="sd-cc__subheading">{{ subheading }}</p>
        {%- endif -%}

        <div class="sd-cc__phone">
          <span class="sd-cc__phone-label">{{ phone_label }}</span>
          <a href="tel:{{ tel_clean }}" class="sd-cc__phone-number">{{ phone_number }}</a>
          {%- if phone_hours != blank -%}
            <span class="sd-cc__phone-hours">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
              </svg>
              {{ phone_hours }}
            </span>
          {%- endif -%}
        </div>

        <div class="sd-cc__actions">
          <a href="tel:{{ tel_clean }}" class="sd-cc__cta">
            <span class="sd-cc__cta-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </span>
            {{ cta_label }}
            <svg class="sd-cc__cta-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>

          {%- if section.settings.trust_text != blank -%}
            <span class="sd-cc__trust">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5"/>
              </svg>
              {{ section.settings.trust_text }}
            </span>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "SD Concierge Card",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (showroom, team or sofa lifestyle)"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left",  "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Concierge"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Talk to a real sofa expert."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Need help choosing fabric, sizing for your room, or timing your delivery? Our UK team is just a call away."
    },
    {
      "type": "header",
      "content": "Phone"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone label",
      "default": "Direct Line"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone number",
      "default": "02476 581 053"
    },
    {
      "type": "text",
      "id": "phone_hours",
      "label": "Opening hours",
      "default": "Mon-Sat 08:00 - 18:00"
    },
    {
      "type": "header",
      "content": "CTA"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Call the team"
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust microcopy",
      "default": "No queues. No bots. Just real people.",
      "info": "Small line below the button. Leave blank to hide."
    }
  ],
  "presets": [
    {
      "name": "SD Concierge Card"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
