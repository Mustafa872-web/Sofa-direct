              <div class="sd-fabric" {{ block.shopify_attributes }}>
                <p class="sd-fabric__label">Material Information</p>
                <div class="sd-fabric__cards">
                  <div class="sd-fabric__current-card sd-fabric__current-card--hoverable">
                    <div class="sd-fabric__thumb-wrap">
                      {%- if mo_image != blank -%}
                        {{-
                          mo_image
                          | image_url: width: 140
                          | image_tag:
                            class: 'sd-fabric__thumb-img',
                            loading: 'lazy',
                            width: 70,
                            height: 70,
                            alt: mo_name
                        -}}
                      {%- else -%}
                        <span class="sd-fabric__thumb-dot" data-color="{{ mo_name | escape }}"></span>
                      {%- endif -%}
                    </div>
