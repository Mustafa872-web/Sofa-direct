              <p class="sd-finance-row__text">See our pay later options
                <svg width="12" height="6" viewBox="0 0 12 6" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 1l5 4 5-4"/></svg>
              </p>
            </div>

          {%- when 'fabric_card' -%}
            {%- comment -%} Fabric Card — renders inline within the main block loop so admin drag-drop reorders it freely. {%- endcomment -%}
            {%- assign color_meta = product.metafields.custom.product_color -%}
