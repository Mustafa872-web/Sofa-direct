            <script>
              (function () {
                var root = document.getElementById('sd-pifc-{{ section.id }}');
                if (!root) return;

                var apr = parseFloat(root.dataset.apr) || 0;
                var basePrice = parseFloat(root.dataset.price) || 0;

                var priceInput = root.querySelector('[data-sd-pifc-price]');
                var priceSlider = root.querySelector('[data-sd-pifc-price-slider]');
                var depSlider = root.querySelector('[data-sd-pifc-deposit]');
                var depPctEl = root.querySelector('[data-sd-pifc-deposit-pct]');
                var depAmtEl = root.querySelector('[data-sd-pifc-deposit-amt]');
                var monthlyEl = root.querySelector('[data-sd-pifc-monthly]');
                var termRoEl = root.querySelector('[data-sd-pifc-term-readout]');
                var termBtns = root.querySelectorAll('[data-sd-pifc-term]');
                var cashEl = root.querySelector('[data-sd-pifc-cash]');
                var depCellEl = root.querySelector('[data-sd-pifc-dep]');
                var loanEl = root.querySelector('[data-sd-pifc-loan]');
                var totalEl = root.querySelector('[data-sd-pifc-total]');

                var toggleBtn = root.querySelector('[data-sd-pifc-toggle]');
                var monthlyBarEl = root.querySelector('[data-sd-pifc-monthly-bar]');

                var fmt = function (n) {
                  return n.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                };
                var fmtInt = function (n) {
                  return Math.round(n).toLocaleString('en-GB');
                };

                function getTerm() {
                  var a = root.querySelector('[data-sd-pifc-term].is-active');
                  return a ? parseInt(a.dataset.sdPifcTerm, 10) : 12;
                }

                function compute() {
                  var price = Math.max(0, parseFloat(priceInput.value) || 0);
                  var depPct = parseFloat(depSlider.value) || 0;
                  var depAmt = (price * depPct) / 100;
                  var principal = Math.max(0, price - depAmt);
                  var term = getTerm();
                  var monthly, total;

                  if (apr <= 0) {
                    monthly = principal / term;
                    total = principal;
                  } else {
                    var r = apr / 100 / 12;
                    monthly = (principal * r) / (1 - Math.pow(1 + r, -term));
                    total = monthly * term;
                  }
                  if (!isFinite(monthly) || monthly < 0) {
                    monthly = 0;
                    total = 0;
                  }

                  monthlyEl.textContent = fmt(monthly);
                  if (monthlyBarEl) monthlyBarEl.textContent = fmt(monthly);
                  termRoEl.textContent = term;
                  depPctEl.textContent = depPct + '%';
                  depAmtEl.textContent = fmtInt(depAmt);
                  cashEl.textContent = fmtInt(price);
                  depCellEl.textContent = fmtInt(depAmt);
                  loanEl.textContent = fmtInt(principal);
                  totalEl.textContent = fmtInt(total + depAmt);
                }

                // Sync price input + slider
                priceInput.addEventListener('input', function () {
                  if (parseFloat(priceInput.value) > parseFloat(priceSlider.max)) {
                    priceSlider.max = Math.ceil(parseFloat(priceInput.value) * 1.5);
                  }
                  priceSlider.value = priceInput.value;
                  compute();
                });
                priceSlider.addEventListener('input', function () {
                  priceInput.value = priceSlider.value;
                  compute();
                });

                depSlider.addEventListener('input', compute);

                termBtns.forEach(function (btn) {
                  btn.addEventListener('click', function () {
                    termBtns.forEach(function (b) {
                      b.classList.remove('is-active');
                      b.setAttribute('aria-checked', 'false');
                    });
                    btn.classList.add('is-active');
                    btn.setAttribute('aria-checked', 'true');
                    compute();
                  });
                });

                toggleBtn.addEventListener('click', function () {
                  var nowOpen = root.classList.toggle('is-collapsed') === false;
                  toggleBtn.setAttribute('aria-expanded', nowOpen ? 'true' : 'false');
                });

                document.addEventListener('variant:change', function (e) {
                  if (e && e.detail && e.detail.variant && typeof e.detail.variant.price === 'number') {
                    var p = e.detail.variant.price / 100;
                    basePrice = p;
                    priceInput.value = Math.round(p);
                    if (p > parseFloat(priceSlider.max)) priceSlider.max = Math.ceil(p * 1.5);
                    priceSlider.value = Math.round(p);
                    compute();
                  }
                });

                compute();
              })();
            </script>
