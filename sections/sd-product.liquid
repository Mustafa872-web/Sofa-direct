{{ 'sd-pinfo-fabric.css' | asset_url | stylesheet_tag }}
{{ 'sd-pinfo-material.css' | asset_url | stylesheet_tag }}
{{ 'sd-pinfo-dimensions.css' | asset_url | stylesheet_tag }}
{{ 'sd-pinfo-support.css' | asset_url | stylesheet_tag }}
{{ 'sd-pinfo-tabs.css' | asset_url | stylesheet_tag }}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign product_form_id = 'sd-product-form-' | append: section.id -%}
{%- assign featured_media = current_variant.featured_media | default: product.featured_media -%}

{%- assign sd_release_date = product.metafields.custom.product_release_date.value -%}
{%- assign sd_is_preorder = false -%}
{%- if sd_release_date != blank -%}
  {%- assign sd_now_ts = 'now' | date: '%s' | plus: 0 -%}
  {%- assign sd_release_ts = sd_release_date | date: '%s' | plus: 0 -%}
  {%- if sd_release_ts > sd_now_ts -%}
    {%- assign sd_is_preorder = true -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%}
  ── 3D / AR feature gating from product metafields ──
  - custom.view_360       → list of images for 360° spin; 3D View button hides if empty
  - custom.view_in_space  → GLB/USDZ (or image of) for AR; View-in-Space button hides if empty
{%- endcomment -%}
{%- assign _frames_360_check = product.metafields.custom.view_360.value -%}
{%- assign has_view_360 = false -%}
{%- if _frames_360_check != blank and _frames_360_check.size > 0 -%}
  {%- assign has_view_360 = true -%}
{%- endif -%}

{%- assign _vis_meta = product.metafields.custom.view_in_space -%}

{%- assign view_in_space_url = '' -%}
{%- if _vis_meta != blank and _vis_meta.value != blank and _vis_meta.value.sources != blank -%}
  {%- assign view_in_space_url = _vis_meta.value.sources.first.url -%}
{%- endif -%}

{%- assign has_view_in_space = false -%}
{%- if view_in_space_url != blank -%}
  {%- assign has_view_in_space = true -%}
{%- endif -%}


{%- comment -%}
  Detect dimension images from product media.
  Any product image whose ALT text contains "dimension" (case-insensitive)
  is treated as a dimension diagram:
    • hidden from the main gallery & thumbs
    • shown ONLY inside the Dimensions modal (lazy-loaded on click)
{%- endcomment -%}
{%- assign dim_media_count = 0 -%}
{%- for media in product.media -%}
  {%- assign _alt = media.alt | default: '' | downcase -%}
  {%- if _alt contains 'dimension' -%}
    {%- assign dim_media_count = dim_media_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

<div
  class="sd-product{% if template.suffix == 'sd-v2' or section.settings.enable_v2_layout %} sd-product--v2{% endif %}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
>
  <div class="sd-product__layout">
    {%- comment -%}══ GALLERY ══{%- endcomment -%}
    <div class="sd-product__gallery" id="sd-gallery-{{ section.id }}">
      <div class="sd-gallery__thumbs">
        <div class="sd-gallery__thumbs-inner">
          {%- for media in product.media limit: 12 -%}
            {%- assign _alt = media.alt | default: '' | downcase -%}
            {%- if _alt contains 'dimension' -%}{%- continue -%}{%- endif -%}
            {%- assign is_active = false -%}
            {%- if featured_media != blank and media.id == featured_media.id -%}
              {%- assign is_active = true -%}
            {%- elsif featured_media == blank and forloop.first -%}
              {%- assign is_active = true -%}
            {%- endif -%}
            <button
              class="sd-gallery__thumb{% if is_active %} active{% endif %}"
              data-media-id="{{ media.id }}"
              type="button"
              aria-label="View image {{ forloop.index }}"
            >
              {{-
                media
                | image_url: width: 160
                | image_tag: loading: 'lazy', width: 80, height: 80, alt: media.alt
                | default: product.title, class: 'sd-gallery__thumb-img'
              -}}
            </button>
          {%- endfor -%}
        </div>
      </div>

      <div class="sd-gallery__main">
        {%- comment -%} Image slides — skip dimension images (shown in modal only) {%- endcomment -%}
        {%- assign slide_idx = 0 -%}
        {%- for media in product.media limit: 12 -%}
          {%- assign _alt = media.alt | default: '' | downcase -%}
          {%- if _alt contains 'dimension' -%}{%- continue -%}{%- endif -%}
          {%- assign slide_idx = slide_idx | plus: 1 -%}
          {%- assign is_active = false -%}
          {%- if featured_media != blank and media.id == featured_media.id -%}
            {%- assign is_active = true -%}
          {%- elsif featured_media == blank and slide_idx == 1 -%}
            {%- assign is_active = true -%}
          {%- endif -%}
          {%- assign load_type = 'lazy' -%}
          {%- if slide_idx == 1 -%}{%- assign load_type = 'eager' -%}{%- endif -%}
          <div class="sd-gallery__slide{% if is_active %} active{% endif %}" data-media-id="{{ media.id }}">
            {%- if media.media_type == 'video' -%}
              <video
                class="sd-gallery__img"
                autoplay
                muted
                loop
                playsinline
                width="{{ media.width }}"
                height="{{ media.height }}"
              >
                {%- for s in media.sources -%}
                  <source src="{{ s.url }}" type="{{ s.mime_type }}">
                {%- endfor -%}
              </video>
            {%- elsif slide_idx == 1 -%}
              {{-
                media
                | image_url: width: 2400
                | image_tag:
                  loading: 'eager',
                  fetchpriority: 'high',
                  widths: '720,960,1200,1500,1800,2048,2400',
                  sizes: '(min-width:990px) 54vw, 100vw',
                  alt: media.alt
                | default: product.title, class: 'sd-gallery__img', width: media.width, height: media.height
              -}}
            {%- else -%}
              {{-
                media
                | image_url: width: 2400
                | image_tag:
                  loading: 'lazy',
                  widths: '720,960,1200,1500,1800,2048,2400',
                  sizes: '(min-width:990px) 54vw, 100vw',
                  alt: media.alt
                | default: product.title, class: 'sd-gallery__img', width: media.width, height: media.height
              -}}
            {%- endif -%}
          </div>
        {%- endfor -%}

        {%- comment -%} 360° View overlay (shown in-place) {%- endcomment -%}
        {%- assign frames_360 = product.metafields.custom.view_360.value -%}
        <div
          class="sd-gallery__overlay sd-gallery__overlay--360"
          id="sd-3d-overlay-{{ section.id }}"
          data-overlay="3d"
          style="display:none"
        >
          {%- comment -%} Top bar — back to photo button {%- endcomment -%}
          <div class="sd-360-overlay-topbar">
            <button type="button" class="sd-gallery__overlay-back" data-gallery-close aria-label="Back to photo">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M19 12H5M12 19l-7-7 7-7"/>
              </svg>
              <span>Back to photo</span>
            </button>
            <span class="sd-360-overlay-badge">360°</span>
          </div>

          <div class="sd-360-overlay-stage">
            <canvas
              class="sd-360-canvas"
              id="sd-360-canvas-overlay-{{ section.id }}"
              data-frames-id="sd-360-frames-{{ section.id }}"
              data-context="overlay"
            ></canvas>

            <div class="sd-360-overlay-load" id="sd-360-overlay-load-{{ section.id }}">
              <div class="sd-360-poster__spinner"></div>
              <span>Loading 360°…</span>
            </div>

            {%- comment -%} Center hand-cursor hint {%- endcomment -%}
            <div class="sd-360-hint" id="sd-360-overlay-hint-{{ section.id }}">
              <svg
                class="sd-360-hint__cursor"
                width="44"
                height="52"
                viewBox="0 0 44 52"
                fill="none"
                aria-hidden="true"
              >
                <path d="M14 23V9a3 3 0 016 0v10" stroke="#1a1a1a" stroke-width="2.2" stroke-linecap="round" fill="#fff"/>
                <path d="M20 19v-2a3 3 0 016 0v4" stroke="#1a1a1a" stroke-width="2.2" stroke-linecap="round" fill="#fff"/>
                <path d="M26 21v-2a3 3 0 016 0v6" stroke="#1a1a1a" stroke-width="2.2" stroke-linecap="round" fill="#fff"/>
                <path d="M32 25v-1a3 3 0 016 0v12a10 10 0 01-10 10h-4a10 10 0 01-10-10v-9l-3-3a2.5 2.5 0 013.5-3.5L14 23" stroke="#1a1a1a" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="#fff"/>
              </svg>
            </div>
          </div>

          {%- comment -%} Bottom arc scrubber — sofaclub-style {%- endcomment -%}
          <div class="sd-360-overlay-bottombar">
            <button
              type="button"
              class="sd-360-play-btn"
              id="sd-360-play-overlay-{{ section.id }}"
              aria-label="Play 360° loop"
              title="Play 360° loop"
            >
              <span class="sd-360-play-btn__icon sd-360-play-btn__icon--play">
                <svg width="14" height="16" viewBox="0 0 14 16" fill="currentColor">
                  <path d="M1 1l12 7L1 15V1z"/>
                </svg>
              </span>
              <span class="sd-360-play-btn__icon sd-360-play-btn__icon--pause" style="display:none">
                <svg width="14" height="16" viewBox="0 0 14 16" fill="currentColor">
                  <rect x="1" y="1" width="4" height="14" rx="1"/><rect x="9" y="1" width="4" height="14" rx="1"/>
                </svg>
              </span>
            </button>
            <div
              class="sd-360-arc"
              id="sd-360-scrub-overlay-{{ section.id }}"
              role="slider"
              aria-label="Rotate product"
              tabindex="0"
            >
              <span class="sd-360-arc__label">360°</span>
              <svg class="sd-360-arc__svg" viewBox="0 0 140 40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path id="sd-360-arc-path-overlay-{{ section.id }}" class="sd-360-arc__path"
                      d="M 8 28 Q 70 0 132 28" fill="none"
                      stroke="#1a1a1a" stroke-width="1.4" stroke-linecap="round"/>
                <circle id="sd-360-arc-dot-overlay-{{ section.id }}" class="sd-360-arc__dot"
                        cx="8" cy="28" r="3.2" fill="#1a1a1a"/>
              </svg>
              <span class="sd-360-arc__tip">DRAG TO SPIN</span>
            </div>
          </div>
        </div>

        {%- comment -%} Dimensions overlay (shown in-place) {%- endcomment -%}
        <div class="sd-gallery__overlay" id="sd-dims-overlay-{{ section.id }}" data-overlay="dims" style="display:none">
          {%- if section.settings.dimensions_image != blank -%}
            {{-
              section.settings.dimensions_image
              | image_url: width: 1200
              | image_tag: class: 'sd-gallery__overlay-img', loading: 'lazy', width: 1200, alt: 'Product dimensions'
            -}}
          {%- else -%}
            <div class="sd-gallery__overlay-placeholder">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(0,0,0,.3)" stroke-width="1.5">
                <path d="M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z"/>
              </svg>
              <p>Dimensions image not set. Upload in Theme Editor.</p>
            </div>
          {%- endif -%}
          <button type="button" class="sd-gallery__overlay-close" data-gallery-close>&times; Back to photos</button>
        </div>

        <div class="sd-gallery__dots">
          {%- for media in product.media limit: 12 -%}
            {%- assign _alt = media.alt | default: '' | downcase -%}
            {%- if _alt contains 'dimension' -%}{%- continue -%}{%- endif -%}
            <span class="sd-gallery__dot{% if forloop.first %} active{% endif %}"></span>
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} 3D / Dims / Specs buttons — desktop: overlaid top-right; mobile: bar below image {%- endcomment -%}
      <div class="sd-gallery__view-btns">
        {%- if section.settings.show_3d_btn and has_view_360 -%}
          <button type="button" class="sd-view-btn" data-gallery-view="3d">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>
            </svg>
            3D View
          </button>
        {%- endif -%}
        {%- if section.settings.show_dims_btn -%}
          <button type="button" class="sd-view-btn" data-modal-open="sd-modal-dims-{{ section.id }}">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z"/>
            </svg>
            Dimensions
          </button>
        {%- endif -%}
        {%- if section.settings.show_specs_btn -%}
          <button type="button" class="sd-view-btn" data-modal-open="sd-modal-specs-{{ section.id }}">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
            </svg>
            Specs
          </button>
        {%- endif -%}
        {%- if has_view_in_space -%}
          {%- assign glb_url = view_in_space_url -%}
          {%- assign usdz_url = glb_url | replace: '.glb', '.usdz' -%}
          <button
            type="button"
            class="sd-view-btn sd-view-btn--ar"
            id="sd-ar-btn-{{ section.id }}"
            data-glb="{{ glb_url | escape }}"
            data-usdz="{{ usdz_url | escape }}"
            data-ar-modal="sd-modal-ar-{{ section.id }}"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 3H3v4"/><path d="M19 3h2v4"/><path d="M5 21H3v-4"/><path d="M19 21h2v-4"/><path d="M12 8l-4 2.5v5L12 18l4-2.5v-5L12 8z"/>
            </svg>
            View in Space
          </button>
        {%- endif -%}
      </div>

      {%- comment -%}
        Gallery bottom grid — auto-sequential from image 2 onwards.
        Image 1 is the large feature image (shown above in the main gallery).
        Pattern repeats every 7: images 2-4 → row of 3, 5-6 → row of 2, 7-8 → row of 2,
        then 9-11 → row of 3, 12-13 → row of 2, 14-15 → row of 2 …
        Dimension images (alt contains "dimension") are always excluded.
        No manual alt-text tagging required.
      {%- endcomment -%}
      {%- assign grid_count = 0 -%}
      {%- assign skip_first = false -%}
      {%- for media in product.media -%}
        {%- assign _alt = media.alt | default: '' | downcase -%}
        {%- if _alt contains 'dimension' -%}{%- continue -%}{%- endif -%}
        {%- unless skip_first -%}
          {%- assign skip_first = true -%}
          {%- continue -%}
        {%- endunless -%}
        {%- assign grid_count = grid_count | plus: 1 -%}
      {%- endfor -%}

      {%- if grid_count > 0 -%}
        <div class="sd-gallery__grid">
          {%- assign gi = 0 -%}
          {%- assign skip_first2 = false -%}
          {%- for media in product.media -%}
            {%- assign _alt = media.alt | default: '' | downcase -%}
            {%- if _alt contains 'dimension' -%}{%- continue -%}{%- endif -%}
            {%- unless skip_first2 -%}
              {%- assign skip_first2 = true -%}
              {%- continue -%}
            {%- endunless -%}
            {%- assign cycle_pos = gi | modulo: 7 -%}
            {%- if cycle_pos < 3 -%}
              {%- assign row_cls = 'sd-gallery__grid-item--row1' -%}
            {%- else -%}
              {%- assign row_cls = 'sd-gallery__grid-item--row2' -%}
            {%- endif -%}
            <button
              type="button"
              class="sd-gallery__grid-item {{ row_cls }}"
              data-media-id="{{ media.id }}"
              aria-label="View image {{ gi | plus: 2 }}"
            >
              {{-
                media
                | image_url: width: 600
                | image_tag:
                  loading: 'lazy',
                  widths: '300,400,600',
                  sizes: '(min-width:990px) 18vw, 33vw',
                  alt: media.alt
                | default: product.title, class: 'sd-gallery__grid-img'
              -}}
            </button>
            {%- assign gi = gi | plus: 1 -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} Product video — autoplay muted when scrolled into view, src set lazily {%- endcomment -%}
      {%- if section.settings.product_video_url != blank -%}
        {%- assign poster_img = section.settings.product_video_poster -%}

        <div class="sd-product-video" id="sd-pvid-{{ section.id }}">
          <video
            class="sd-product-video__player"
            data-src="{{ section.settings.product_video_url }}"
            {%- if poster_img != blank -%}
              poster="{{ poster_img | image_url: width: 1200 }}"
            {%- endif -%}
            muted
            autoplay
            playsinline
            loop
            preload="none"
          ></video>
        </div>

        <script>
          (function () {
            if (window.innerWidth <= 749) return;
            var vid = document.querySelector('#sd-pvid-{{ section.id }} video');
            var obs = new IntersectionObserver(
              function (entries) {
                if (entries[0].isIntersecting) {
                  vid.src = vid.dataset.src;
                  vid.play();
                  obs.disconnect();
                }
              },
              { rootMargin: '200px' }
            );
            obs.observe(vid);
          })();
        </script>
      {%- endif -%}
    </div>
<style>
  .product__inventory-text.product__inventory-pre-release .svg-wrapper>svg {
   
    color: #fff;
}
.product__inventory-text {
    margin-bottom: 20px;
}
.product__inventory-text.product__inventory-pre-release span.svg-wrapper {
    background: #E4CF01;
    border-radius: 50%;
    margin-right: 8px;
}
.product__inventory-text.product__inventory-pre-release {
    display: flex;
    align-items: center;
}
</style>
    {%- comment -%}══ PRODUCT INFO ══{%- endcomment -%}
    <div class="sd-product__info" id="sd-info-{{ section.id }}">
      {%- comment -%} Breadcrumb: Home > [Collection chain] > Product {%- endcomment -%}
      <nav class="sd-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}" class="sd-breadcrumb__link">Home</a>
        {%- if product.type != blank -%}
          <span class="sd-breadcrumb__sep" aria-hidden="true">&rsaquo;</span>
          <a
            href="{{ routes.all_products_collection_url }}?filter.p.product_type={{ product.type | url_encode }}"
            class="sd-breadcrumb__link"
          >
            {{- product.type -}}
          </a>
        {%- endif -%}
        {%- if product.collections.size > 0 -%}
          {%- assign bc_col = product.collections.first -%}
          <span class="sd-breadcrumb__sep" aria-hidden="true">&rsaquo;</span>
          <a href="{{ bc_col.url }}" class="sd-breadcrumb__link">{{ bc_col.title }}</a>
        {%- endif -%}
        <span class="sd-breadcrumb__sep" aria-hidden="true">&rsaquo;</span>
        <span class="sd-breadcrumb__current">{{ product.title }}</span>
      </nav>

      {%- comment -%} Optional badge driven by product.metafields.custom.price_badge (single-line text). Empty = hidden. {%- endcomment -%}
      {%- assign pbadge = product.metafields.custom.price_badge -%}
      {%- if pbadge != blank -%}
        <span class="sd-product__badge">{{ pbadge }}</span>
      {%- endif -%}

      <div class="sd-product__title-row">
        <h1 class="sd-product__title">{{ product.title }}</h1>
        <span class="sd-product__price-mobile" id="sd-mobile-price-{{ section.id }}">
          {{- current_variant.price | money -}}
        </span>
        <button type="button" class="sd-product__wishlist" aria-label="Add to wishlist">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
          </svg>
        </button>
      </div>

      {%- comment -%} ── Inline review summary card (top of product info) ── {%- endcomment -%}
      {%- liquid
        assign rv_rating = product.metafields.reviews.rating.value.rating | default: 4.8
        assign rv_count = product.metafields.reviews.rating_count | default: 247
        assign rv_rating_str = rv_rating | times: 10 | round | divided_by: 10.0
        assign rv_pct = rv_rating | times: 20
        assign r_full = rv_rating | floor
        assign r_half_f = rv_rating | minus: r_full
        assign r_half = 0
        if r_half_f >= 0.25 and r_half_f < 0.75
          assign r_half = 1
        endif
        if r_half_f >= 0.75
          assign r_full = r_full | plus: 1
        endif
        assign r_half_pos = r_full | plus: 1
      -%}
      <button
        type="button"
        class="sd-pinforev"
        data-sd-rev-open
        aria-label="View {{ rv_count }} customer reviews"
        aria-haspopup="dialog"
        aria-controls="sd-rev-drawer-{{ section.id }}"
      >
        <div class="sd-pinforev__l">
          <div class="sd-pinforev__rating">
            <span class="sd-pinforev__num">{{ rv_rating_str }}</span>
            <span class="sd-pinforev__outof">/5</span>
          </div>
          <span class="sd-pinforev__stars" aria-label="{{ rv_rating_str }} out of 5 stars">
            {%- for i in (1..5) -%}
              {%- if i <= r_full -%}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/>
                </svg>
              {%- elsif i == r_half_pos and r_half == 1 -%}
                <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
