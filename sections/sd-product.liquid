                      </div>
                      <span class="sd-addon__price">
                        {%- if av2 %}{{ av2.price | money_without_trailing_zeros }}{% else %}£91{% endif -%}
                      </span>
                    </label>
                  </div>

                  {%- comment -%} Sofa Removal with type dropdown {%- endcomment -%}
                  <div class="sd-addon">
                    <label class="sd-addon__row">
                      <input
                        type="checkbox"
                        class="sd-addon__check"
                        name="properties[Sofa Removal]"
                        form="{{ product_form_id }}"
                        value="{% if av3 %}{{ av3.price | money_without_trailing_zeros }}{% else %}£99{% endif %}"
                        {% if av3 %}
                          data-addon-variant="{{ av3.id }}"
                        {% endif %}
                      >
                      <span class="sd-addon__icon">
                        {%- if ap3.featured_image -%}
                          {{-
                            ap3.featured_image
                            | image_url: width: 120
                            | image_tag:
                              loading: 'lazy',
                              width: 60,
                              height: 60,
                              alt: ap3.title,
                              class: 'sd-addon__icon-img'
                          -}}
                        {%- else -%}
                          <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
                          </svg>
                        {%- endif -%}
                        <span class="sd-addon__check-badge" aria-hidden="true">
                          <svg width="11" height="9" viewBox="0 0 11 9" fill="none">
                            <path d="M1 4.5L4 7.5L10 1" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </span>
                      </span>
                      <div class="sd-addon__info">
                        <strong class="sd-addon__title">
                          {%- if ap3 %}{{ ap3.title }}{% else %}Sofa Removal{% endif -%}
                        </strong>
                        <span class="sd-addon__sub">(select your sofa)</span>
                      </div>
                      <div class="sd-addon__type-select">
                        <select class="sd-addon__dropdown" name="properties[Removal Type]" form="{{ product_form_id }}">
                          <option>Armchair</option>
                          <option>2 Seater</option>
                          <option>3 Seater</option>
                          <option>Corner Sofa</option>
                        </select>
                        <svg class="sd-addon__dropdown-arrow" width="10" height="6" viewBox="0 0 12 6" fill="none">
                          <path d="M1 1l5 4 5-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                      </div>
                      <span class="sd-addon__price">
                        {%- if av3 %}{{ av3.price | money_without_trailing_zeros }}{% else %}£99{% endif -%}
                      </span>
                    </label>
                  </div>

                  {%- comment -%} Expose addon variant IDs + images to JS for popup filtering {%- endcomment -%}
                  <script>
                    window.sdAddonData = [
                      {
                        attr: 'Premier Delivery',
                        variantId: {% if av1 %}{{ av1.id }}{% else %}null{% endif %},
                        rawPrice: {% if av1 %}{{ av1.price }}{% else %}4900{% endif %},
                        price: '{% if av1 %}{{ av1.price | money_without_trailing_zeros }}{% else %}£49{% endif %}',
                        title: '{% if ap1 %}{{ ap1.title | escape }}{% else %}Premier Delivery Service{% endif %}',
                        sub: 'Assembly & Packaging Recycling',
                        image: '{% if ap1.featured_image %}{{ ap1.featured_image | image_url: width: 160 }}{% endif %}'
                      },
                      {
                        attr: 'Care Plan',
                        variantId: {% if av2 %}{{ av2.id }}{% else %}null{% endif %},
                        rawPrice: {% if av2 %}{{ av2.price }}{% else %}9100{% endif %},
                        price: '{% if av2 %}{{ av2.price | money_without_trailing_zeros }}{% else %}£91{% endif %}',
                        title: '{% if ap2 %}{{ ap2.title | escape }}{% else %}5 Year Care Protection Plan{% endif %}',
                        sub: 'If an accident happens, it\'s covered',
                        image: '{% if ap2.featured_image %}{{ ap2.featured_image | image_url: width: 160 }}{% endif %}'
                      },
                      {
                        attr: 'Sofa Removal',
                        variantId: {% if av3 %}{{ av3.id }}{% else %}null{% endif %},
                        rawPrice: {% if av3 %}{{ av3.price }}{% else %}9900{% endif %},
                        price: '{% if av3 %}{{ av3.price | money_without_trailing_zeros }}{% else %}£99{% endif %}',
                        title: '{% if ap3 %}{{ ap3.title | escape }}{% else %}Sofa Removal{% endif %}',
                        sub: 'We\'ll remove your old sofa',
                        image: '{% if ap3.featured_image %}{{ ap3.featured_image | image_url: width: 160 }}{% endif %}'
                      }
                    ];
                  </script>
                </div>
              </div>

            {%- when '__trust_badges_moved_to_main_loop__' -%}
              {%- comment -%} Trust badges moved to main loop (alongside atc_stack). Never matches; kept as reference. {%- endcomment -%}
              <div class="sd-trust-grid" {{ block.shopify_attributes }}>
                <div class="sd-trust-grid__row">
                  <div class="sd-trust-grid__item">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                    <span>Lifetime warranty <a href="#" class="sd-trust-link">Learn More</a></span>
                  </div>
                  <span class="sd-trust-grid__divider"></span>
                  <div class="sd-trust-grid__item">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                    </svg>
                    <span>Free &amp; easy returns <a href="#" class="sd-trust-link">Learn More</a></span>
                  </div>
                </div>
                <div class="sd-trust-grid__row">
                  <div class="sd-trust-grid__item">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>
                    </svg>
                    <span>Secure payment options</span>
                  </div>
                  <span class="sd-trust-grid__divider"></span>
                  <div class="sd-trust-grid__item">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"/><path d="M16 8l-4 4-4-4"/>
                    </svg>
                    <span>4 interest-free payments</span>
                  </div>
                </div>
              </div>

            {%- when '__payment_icons_moved_to_main_loop__' -%}
              {%- comment -%} Payment icons moved to main loop (alongside atc_stack). Never matches; kept as reference. {%- endcomment -%}
              <div class="sd-finance-row" {{ block.shopify_attributes }}>
                <div class="sd-finance-row__icons">
                  {%- assign has_custom_icons = false -%}
                  {%- for i in (1..6) -%}
                    {%- assign pkey = 'payment_icon_img_' | append: i -%}
                    {%- if section.settings[pkey] != blank -%}
                      {%- assign has_custom_icons = true -%}
                      <span class="sd-pay-chip sd-pay-chip--img">
                        {{-
                          section.settings[pkey]
                          | image_url: width: 160
                          | image_tag:
                            class: 'sd-pay-chip__img',
                            loading: 'lazy',
                            width: 60,
                            height: 60,
                            alt: 'Payment method'
                        -}}
                      </span>
                    {%- endif -%}
                  {%- endfor -%}
                  {%- unless has_custom_icons -%}
                    <span class="sd-pay-chip sd-pay-chip--delta" aria-label="Debit/Credit Card">
                      <svg viewBox="0 0 40 40" width="100%" height="100%" fill="none" aria-hidden="true">
                        <circle cx="20" cy="20" r="20" fill="#003b7a"/><text x="50%" y="56%" text-anchor="middle" fill="#fff" font-family="Arial,sans-serif" font-weight="900" font-size="15" dominant-baseline="middle">D</text>
                      </svg>
                    </span>
                    <span class="sd-pay-chip sd-pay-chip--mint" aria-label="Pay Later">
                      <svg viewBox="0 0 40 40" width="100%" height="100%" fill="none" aria-hidden="true">
                        <circle cx="20" cy="20" r="20" fill="#b4f1d8"/><path d="M13 14l6 6-6 6M27 14l-6 6 6 6" stroke="#083f2b" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span class="sd-pay-chip sd-pay-chip--paypal" aria-label="PayPal">
                      <svg viewBox="0 0 40 40" width="100%" height="100%" fill="none" aria-hidden="true">
                        <circle cx="20" cy="20" r="20" fill="#3b82f6"/><text x="50%" y="58%" text-anchor="middle" fill="#fff" font-family="Arial,sans-serif" font-weight="900" font-size="18" font-style="italic" dominant-baseline="middle">P</text>
                      </svg>
                    </span>
                    <span class="sd-pay-chip sd-pay-chip--pink" aria-label="Klarna">
                      <svg viewBox="0 0 40 40" width="100%" height="100%" fill="none" aria-hidden="true">
                        <circle cx="20" cy="20" r="20" fill="#ffb3c7"/><text x="50%" y="57%" text-anchor="middle" fill="#0a0a0a" font-family="Arial,sans-serif" font-weight="900" font-size="9" dominant-baseline="middle">Klarna</text>
                      </svg>
                    </span>
                  {%- endunless -%}
                </div>
                <p class="sd-finance-row__text">
                  See our pay later options
                  <svg width="12" height="6" viewBox="0 0 12 6" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M1 1l5 4 5-4"/>
                  </svg>
                </p>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      {%- endform -%}
    </div>
  </div>
</div>

{%- comment -%}══ STICKY ATC BAR (Figma node 670:9 — pill with view buttons + product + CTA) ══{%- endcomment -%}
<div class="sd-sticky" id="sd-sticky-{{ section.id }}" aria-hidden="true">
  <div class="sd-sticky__inner">
    <div class="sd-sticky__views">
      {%- if section.settings.show_3d_btn and has_view_360 -%}
        <button type="button" class="sd-sticky__chip" data-modal-open="sd-modal-360-{{ section.id }}">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 2a10 10 0 110 20 10 10 0 010-20z"/><path d="M2 12c5-3 15-3 20 0"/><path d="M12 2c3 5 3 15 0 20"/>
          </svg>
          <span>3D View</span>
        </button>
      {%- endif -%}
      {%- if section.settings.show_dims_btn -%}
        <button type="button" class="sd-sticky__chip" data-modal-open="sd-modal-dims-{{ section.id }}">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 2L2 7v10l10 5 10-5V7L12 2z"/><path d="M2 7l10 5 10-5"/><path d="M12 22V12"/>
          </svg>
          <span>Dimensions</span>
        </button>
      {%- endif -%}
      {%- if section.settings.show_specs_btn -%}
        <button type="button" class="sd-sticky__chip" data-modal-open="sd-modal-specs-{{ section.id }}">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
          </svg>
          <span>Specs</span>
        </button>
      {%- endif -%}
      {%- if has_view_in_space -%}
        {%- assign sticky_glb = view_in_space_url -%}
        {%- assign sticky_usdz = sticky_glb | replace: '.glb', '.usdz' -%}
        <button
          type="button"
          class="sd-sticky__chip sd-sticky__chip--ar"
          data-ar-modal="sd-modal-ar-{{ section.id }}"
          data-glb="{{ sticky_glb | escape }}"
          data-usdz="{{ sticky_usdz | escape }}"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 3H3v4"/><path d="M19 3h2v4"/><path d="M5 21H3v-4"/><path d="M19 21h2v-4"/><path d="M12 8l-4 2.5v5L12 18l4-2.5v-5L12 8z"/>
          </svg>
          <span>View in Space</span>
        </button>
      {%- endif -%}
    </div>
    <div class="sd-sticky__product">
      <p class="sd-sticky__name">{{ product.title }}</p>
      <p class="sd-sticky__price" id="sd-sticky-price-{{ section.id }}">{{ current_variant.price | money }}</p>
    </div>
    <button
      class="sd-sticky__atc"
      id="sd-sticky-atc-{{ section.id }}"
      type="button"
      data-form-target="{{ product_form_id }}"
      {% unless current_variant.available %}
        disabled
      {% endunless %}
    >
       {%- if current_variant.available -%}{% if sd_is_preorder %}Pre Order Now{% else %}Add To Cart{% endif %}{%- else -%}Out of Stock{%- endif -%}
    </button>
  </div>
</div>

{%- comment -%}══ GALLERY LIGHTBOX — big image + full-width thumb slider ══{%- endcomment -%}
<div
  class="sd-lightbox"
  id="sd-zoom-{{ section.id }}"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Product gallery"
>
  <div class="sd-lightbox__backdrop" data-zoom-close></div>

  <button class="sd-lightbox__close" data-zoom-close aria-label="Close">
    <svg
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
    >
      <path d="M18 6L6 18M6 6l12 12"/>
    </svg>
  </button>

  <div class="sd-lightbox__stage">
    <button class="sd-lightbox__nav sd-lightbox__nav--prev" type="button" aria-label="Previous image">
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>

    <div class="sd-lightbox__image-wrap">
      <img class="sd-lightbox__img sd-zoom__img" src="" alt="" loading="lazy" width="1400" height="1400">
      <span class="sd-lightbox__counter"><span data-lb-cur>1</span> / <span data-lb-total>1</span></span>
    </div>

    <button class="sd-lightbox__nav sd-lightbox__nav--next" type="button" aria-label="Next image">
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="9 18 15 12 9 6"/>
      </svg>
    </button>
  </div>

  <div class="sd-lightbox__thumbs-viewport">
    <button
      type="button"
      class="sd-lightbox__thumbs-nav sd-lightbox__thumbs-nav--prev"
      data-lb-thumbs-prev
      aria-label="Scroll thumbnails left"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>
    <div class="sd-lightbox__thumbs" data-lb-thumbs>
      {%- assign lb_idx = 0 -%}
      {%- for media in product.media -%}
        {%- assign _alt = media.alt | default: '' | downcase -%}
        {%- if _alt contains 'dimension' -%}{%- continue -%}{%- endif -%}
        {%- assign lb_idx = lb_idx | plus: 1 -%}
        <button
          type="button"
          class="sd-lightbox__thumb{% if forloop.first %} active{% endif %}"
          data-lb-thumb
          data-media-id="{{ media.id }}"
          data-full="{{ media | image_url: width: 1600 }}"
          data-alt="{{ media.alt | default: product.title | escape }}"
          data-index="{{ lb_idx }}"
          aria-label="View image {{ lb_idx }}"
        >
          {{-
            media
            | image_url: width: 200
            | image_tag: loading: 'lazy', width: 100, height: 100, alt: media.alt
            | default: product.title, class: 'sd-lightbox__thumb-img'
          -}}
        </button>
      {%- endfor -%}
    </div>
    <button
      type="button"
      class="sd-lightbox__thumbs-nav sd-lightbox__thumbs-nav--next"
      data-lb-thumbs-next
      aria-label="Scroll thumbnails right"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="9 18 15 12 9 6"/>
      </svg>
    </button>
  </div>
</div>

{%- comment -%}══ MODAL: 360° IMAGE VIEWER ══{%- endcomment -%}
{%- if section.settings.show_3d_btn -%}
  {%- assign frames_360 = product.metafields.custom.view_360.value -%}
  <div
    class="sd-modal sd-modal--360"
    id="sd-modal-3d-{{ section.id }}"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-label="360 View"
  >
    <div class="sd-modal__overlay" data-modal-close></div>
    <div class="sd-360-panel">
      <div class="sd-360-topbar">
        <div class="sd-360-topbar__left">
          <span class="sd-360-badge">360°</span>
          <span class="sd-360-title">{{ product.title }}</span>
        </div>
        <div class="sd-360-topbar__right">
          <div class="sd-360-progress-wrap">
            <div class="sd-360-progress-bar" id="sd-360-bar-{{ section.id }}"></div>
          </div>
          <span class="sd-360-progress-txt" id="sd-360-txt-{{ section.id }}"></span>
          <button class="sd-360-close" data-modal-close aria-label="Close">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
          </button>
        </div>
      </div>

      <div class="sd-360-viewer" id="sd-360-viewer-{{ section.id }}">
        {%- comment -%} Loading state {%- endcomment -%}
        <div class="sd-360-loading" id="sd-360-loading-{{ section.id }}">
          <div class="sd-360-poster__spinner"></div>
          <span class="sd-360-poster__label">
            {%- if frames_360 != blank -%}Preparing 360° view…{%- else -%}No 360° images added yet{%- endif -%}
          </span>
        </div>

        {%- comment -%} Canvas — images drawn here {%- endcomment -%}
        <canvas
          class="sd-360-canvas"
          id="sd-360-canvas-{{ section.id }}"
          data-frames-id="sd-360-frames-{{ section.id }}"
          data-context="modal"
          style="display:none"
        ></canvas>

        {%- comment -%} Center drag hint — soft hand cursor demo, fades on first interaction {%- endcomment -%}
        <div class="sd-360-hint" id="sd-360-hint-{{ section.id }}">
          <svg class="sd-360-hint__cursor" width="44" height="52" viewBox="0 0 44 52" fill="none" aria-hidden="true">
            <path d="M14 23V9a3 3 0 016 0v10" stroke="#1a1a1a" stroke-width="2.2" stroke-linecap="round" fill="#fff"/>
            <path d="M20 19v-2a3 3 0 016 0v4" stroke="#1a1a1a" stroke-width="2.2" stroke-linecap="round" fill="#fff"/>
            <path d="M26 21v-2a3 3 0 016 0v6" stroke="#1a1a1a" stroke-width="2.2" stroke-linecap="round" fill="#fff"/>
            <path d="M32 25v-1a3 3 0 016 0v12a10 10 0 01-10 10h-4a10 10 0 01-10-10v-9l-3-3a2.5 2.5 0 013.5-3.5L14 23" stroke="#1a1a1a" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="#fff"/>
          </svg>
        </div>

        {%- comment -%} No images setup guide {%- endcomment -%}
        {%- if frames_360 == blank -%}
          <div class="sd-360-empty">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(0,0,0,.2)" stroke-width="1.2">
              <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
            </svg>
            <p>360° images not set up yet.</p>
            <p>
              Go to <strong>Shopify Admin → Products → [this product] → Metafields → 360 View Images</strong> and upload
              your frames.
            </p>
          </div>
        {%- endif -%}
      </div>

      <div class="sd-360-bottombar">
        <div class="sd-360-controls">
          <button class="sd-360-ctrl" id="sd-360-play-{{ section.id }}" title="Play / Pause">
            <svg class="sd-360-ctrl__pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>
            </svg>
            <svg
              class="sd-360-ctrl__play"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="currentColor"
              style="display:none"
            >
              <path d="M5 3l14 9-14 9V3z"/>
            </svg>
          </button>
          <button class="sd-360-ctrl" id="sd-360-reset-{{ section.id }}" title="Reset to front">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
            >
              <path d="M3 12a9 9 0 109-9 9 9 0 00-6.7 3"/><path d="M3 3v6h6"/>
            </svg>
          </button>
          <div class="sd-360-frame-counter" id="sd-360-frame-{{ section.id }}"></div>
        </div>

        {%- comment -%} Arc scrubber — sofaclub-style 360° curve with moving dot {%- endcomment -%}
        <div
          class="sd-360-arc"
          id="sd-360-scrub-{{ section.id }}"
          role="slider"
          aria-label="Rotate product"
          tabindex="0"
        >
          <span class="sd-360-arc__label">360°</span>
          <svg class="sd-360-arc__svg" viewBox="0 0 140 40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path id="sd-360-arc-path-{{ section.id }}" class="sd-360-arc__path"
                  d="M 8 28 Q 70 0 132 28" fill="none"
                  stroke="#1a1a1a" stroke-width="1.4" stroke-linecap="round"/>
            <circle id="sd-360-arc-dot-{{ section.id }}" class="sd-360-arc__dot"
                    cx="8" cy="28" r="3.2" fill="#1a1a1a"/>
          </svg>
          <span class="sd-360-arc__tip">DRAG TO SPIN</span>
        </div>

        <div class="sd-360-bottombar__spacer"></div>
      </div>
    </div>
  </div>
{%- endif -%}

{%- comment -%}══ MODAL: DIMENSIONS ══{%- endcomment -%}
{%- if section.settings.show_dims_btn -%}
  <div
    class="sd-modal"
    id="sd-modal-dims-{{ section.id }}"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-label="Dimensions"
  >
    <div class="sd-modal__overlay" data-modal-close></div>
    <div class="sd-modal__panel">
      <div class="sd-modal__head">
        <h3 class="sd-modal__title">Dimensions</h3>
        <button class="sd-modal__close" data-modal-close aria-label="Close">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M18 6L6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <div class="sd-modal__body" data-dims-body>
        {%- if section.settings.dims_intro != blank -%}
          <p class="sd-dims-intro">{{ section.settings.dims_intro }}</p>
        {%- endif -%}

        {%- if dim_media_count > 0 -%}
          {%- comment -%}
            Layout: image (left) + text panel (right), thumbnail strip below.
            Text comes from the image's ALT text using a "|" separator:
              "Dimension — Overall Size | W 220 cm × D 95 cm × H 85 cm"
               ↑ first segment = title    ↑ remaining segments = bullet lines

            Example alt texts:
              "Dimension Overall | W 220 cm | D 95 cm | H 85 cm"
              "Dimension Seat | Seat height 45 cm | Seat depth 60 cm"

            All images use data-src so browser does not download until modal opens.
          {%- endcomment -%}
          <div class="sd-dims-viewer" data-dims-viewer>
            <div class="sd-dims-stage">
              <button
                type="button"
                class="sd-dims-nav sd-dims-nav--prev"
                data-dims-prev
                aria-label="Previous dimension"
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M15 18l-6-6 6-6"/>
                </svg>
              </button>

              <div class="sd-dims-stage__media">
                <img class="sd-dims-stage__img" data-dims-main alt="" width="1600" height="1200">
                <div class="sd-dims-stage__counter" data-dims-counter>1 / {{ dim_media_count }}</div>
              </div>

              <div class="sd-dims-stage__info">
                <span class="sd-dims-stage__eyebrow">Dimension</span>
                <h4 class="sd-dims-stage__title" data-dims-title></h4>
                <ul class="sd-dims-stage__list" data-dims-list></ul>
              </div>

              <button type="button" class="sd-dims-nav sd-dims-nav--next" data-dims-next aria-label="Next dimension">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M9 18l6-6-6-6"/>
                </svg>
              </button>
            </div>

            {%- comment -%} Thumbnail strip {%- endcomment -%}
            {%- if dim_media_count > 1 -%}
              <div class="sd-dims-thumbs" data-dims-thumbs>
                {%- assign dim_i = 0 -%}
                {%- for media in product.media -%}
                  {%- assign _alt = media.alt | default: '' | downcase -%}
                  {%- unless _alt contains 'dimension' -%}{%- continue -%}{%- endunless -%}
                  {%- assign dim_i = dim_i | plus: 1 -%}
                  {%- assign dim_full = media | image_url: width: 1600 -%}
                  {%- assign dim_thumb = media | image_url: width: 240 -%}

                  {%- comment -%} Parse alt into title + bullets using "|" separator {%- endcomment -%}
                  {%- assign alt_raw = media.alt | default: '' -%}
                  {%- assign alt_parts = alt_raw | split: '|' -%}
                  {%- assign dim_title_raw = alt_parts | first | default: '' | strip -%}
                  {%- comment -%} Drop leading "Dimension" keyword + separators from title for cleaner display {%- endcomment -%}
                  {%- assign dim_title_clean = dim_title_raw
                    | replace: 'Dimensions -', ''
                    | replace: 'Dimensions –', ''
                    | replace: 'Dimensions—', ''
                    | replace: 'Dimensions:', ''
                    | replace: 'Dimensions', ''
                    | replace: 'Dimension -', ''
                    | replace: 'Dimension –', ''
                    | replace: 'Dimension—', ''
                    | replace: 'Dimension:', ''
                    | replace: 'dimension', ''
                    | replace: 'Dimension', ''
                    | strip
                  -%}

                  <button
                    type="button"
                    class="sd-dims-thumb{% if dim_i == 1 %} is-active{% endif %}"
                    data-dims-thumb
                    data-index="{{ dim_i }}"
                    data-full="{{ dim_full }}"
                    data-title="{{ dim_title_clean | escape }}"
                    data-bullets="{%- for p in alt_parts -%}{%- if forloop.first -%}{%- continue -%}{%- endif -%}{{ p | strip | escape }}{%- unless forloop.last -%}||{%- endunless -%}{%- endfor -%}"
                    aria-label="View dimension {{ dim_i }}"
                  >
                    <img
                      class="sd-dims-thumb__img"
                      data-src="{{ dim_thumb }}"
                      alt="{{ media.alt | escape }}"
                      width="120"
                      height="120"
                      loading="lazy"
                    >
                  </button>
                {%- endfor -%}
              </div>
            {%- else -%}
              {%- comment -%} Single dimension — still need hidden thumb-like element with title/bullets for JS {%- endcomment -%}
              {%- for media in product.media -%}
                {%- assign _alt = media.alt | default: '' | downcase -%}
                {%- unless _alt contains 'dimension' -%}{%- continue -%}{%- endunless -%}
                {%- assign solo_full = media | image_url: width: 1600 -%}
                {%- assign alt_raw = media.alt | default: '' -%}
                {%- assign alt_parts = alt_raw | split: '|' -%}
                {%- assign solo_title_raw = alt_parts | first | default: '' | strip -%}
                {%- assign solo_title = solo_title_raw
                  | replace: 'Dimensions -', ''
                  | replace: 'Dimensions –', ''
                  | replace: 'Dimensions:', ''
                  | replace: 'Dimensions', ''
                  | replace: 'Dimension -', ''
                  | replace: 'Dimension –', ''
                  | replace: 'Dimension:', ''
                  | replace: 'Dimension', ''
                  | strip
                -%}
                <button
                  type="button"
                  hidden
                  data-dims-thumb
                  data-index="1"
                  data-full="{{ solo_full }}"
                  data-title="{{ solo_title | escape }}"
                  data-bullets="{%- for p in alt_parts -%}{%- if forloop.first -%}{%- continue -%}{%- endif -%}{{ p | strip | escape }}{%- unless forloop.last -%}||{%- endunless -%}{%- endfor -%}"
                ></button>
                {%- break -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="sd-dims-empty">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(0,0,0,.25)" stroke-width="1.4">
              <path d="M3 3h18v18H3zM3 9h18M9 3v18"/>
            </svg>
            <p><strong>No dimension images yet.</strong></p>
            <p>
              Upload dimension diagrams in <em>Shopify Admin → Products → Media</em> and add the word
              <strong>"dimension"</strong> to each image's ALT text. Only those images will appear here.
            </p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{%- comment -%}══ MODAL: SPECS ══{%- endcomment -%}
{%- if section.settings.show_specs_btn -%}
