      <script>
        (function () {
          var openers = document.querySelectorAll('[data-sd-rev-open]');
          var drawer = document.getElementById('sd-rev-drawer-{{ section.id }}');
          if (!drawer) return;
          var panel = drawer.querySelector('.sd-rev-drawer__panel');
          var body = drawer.querySelector('[data-sd-rev-drawer-body]');
          var closers = drawer.querySelectorAll('[data-sd-rev-close]');
          var viewAll = drawer.querySelector('[data-sd-rev-viewall]');
          var populated = false;

          function populate() {
            if (populated) return;
            var src = document.getElementById('sd-reviews');
            if (!src) {
              body.innerHTML = '<p style="padding:2rem;color:#7a7a7a;">Reviews section not found on this page.</p>';
              populated = true;
              return;
            }
            var container = src.querySelector('.sd-rev__container');
            if (!container) return;
            var clone = container.cloneNode(true);
            // Strip the outer page heading — drawer has its own
            var header = clone.querySelector('.sd-rev__header');
            if (header) header.remove();
            body.innerHTML = '';
            body.appendChild(clone);

            // Re-wire interactive bits inside the clone
            var chips = body.querySelectorAll('[data-sd-rev-filter]');
            var cards = body.querySelectorAll('.sd-rev__card');
            var sortSel = body.querySelector('[data-sd-rev-sort]');
            var moreBtn = body.querySelector('[data-sd-rev-more]');
            var listEl = body.querySelector('[data-sd-rev-list]');

            function applyFilter(filter) {
              cards.forEach(function (c) {
                var rating = parseInt(c.dataset.rating, 10) || 0;
                var hasPhoto = c.dataset.hasPhoto === 'true';
                var tags = c.dataset.tags || '';
                var show = true;
                if (filter === '5') show = rating === 5;
                else if (filter === 'photos') show = hasPhoto;
                else if (filter && filter !== 'all') show = tags.indexOf(filter) !== -1;
                c.style.display = show ? '' : 'none';
              });
            }
            chips.forEach(function (b) {
              b.addEventListener('click', function () {
                chips.forEach(function (x) {
                  x.classList.remove('is-active');
                  x.setAttribute('aria-selected', 'false');
                });
                b.classList.add('is-active');
                b.setAttribute('aria-selected', 'true');
                applyFilter(b.dataset.sdRevFilter);
              });
            });
            if (sortSel) {
              sortSel.addEventListener('change', function () {
                var mode = sortSel.value;
                var arr = Array.prototype.slice.call(cards);
                arr.sort(function (a, b) {
                  if (mode === 'highest') return parseInt(b.dataset.rating, 10) - parseInt(a.dataset.rating, 10);
                  if (mode === 'lowest') return parseInt(a.dataset.rating, 10) - parseInt(b.dataset.rating, 10);
                  return 0;
                });
                arr.forEach(function (c) {
                  listEl.appendChild(c);
                });
              });
            }
            if (moreBtn) {
              var visible = 6;
              function applyVisible() {
                cards.forEach(function (c, i) {
                  if (i >= visible && c.style.display !== 'none') c.classList.add('is-hidden');
                  else c.classList.remove('is-hidden');
                });
                if (visible >= cards.length) moreBtn.style.display = 'none';
              }
              applyVisible();
              moreBtn.addEventListener('click', function () {
                visible += 6;
                applyVisible();
              });
            }
            body.querySelectorAll('[data-sd-rev-helpful]').forEach(function (b) {
              b.addEventListener('click', function () {
                var n = b.querySelector('[data-sd-rev-helpful-n]');
                n.textContent = (parseInt(n.textContent, 10) || 0) + 1;
                b.classList.add('is-on');
              });
            });
            populated = true;
          }

          function open() {
            populate();
            // Portal to <body> so position:fixed escapes any ancestor containing block
            if (drawer.parentNode !== document.body) {
              document.body.appendChild(drawer);
            }
            drawer.hidden = false;
            // Force reflow so transition fires
            drawer.offsetHeight;
            drawer.classList.add('is-open');
            document.body.style.overflow = 'hidden';
          }
          function close() {
            drawer.classList.remove('is-open');
            document.body.style.overflow = '';
            setTimeout(function () {
              drawer.hidden = true;
            }, 320);
          }

          openers.forEach(function (b) {
            b.addEventListener('click', open);
          });
          closers.forEach(function (b) {
            b.addEventListener('click', close);
          });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && drawer.classList.contains('is-open')) close();
          });
          if (viewAll) {
            viewAll.addEventListener('click', function () {
              close();
              setTimeout(function () {
                var t = document.getElementById('sd-reviews');
                if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }, 280);
            });
          }
        })();
      </script>

