                </div>
                <p class="sd-sale-banner__ends">
                  {{ section.settings.sale_banner_ends | default: 'Offer Ends Monday 6th April' }}
                </p>
              </div>
            {%- endif -%}

          {%- when 'sofa_type' -%}
            {%- assign mf_sofa_type = product.metafields.custom.sofa_type.value -%}
            <div {{ block.shopify_attributes }}>
              {%- render 'sd-product-link-grid',
                link_products: mf_sofa_type,
                link_label: 'Sofa Type',
                link_current: product,
                link_slug: 'sofa-type'
              -%}
            </div>

          {%- when 'sofa_range' -%}
            {%- assign mf_sofa_range = product.metafields.custom.sofa_range.value -%}
            <div {{ block.shopify_attributes }}>
              {%- render 'sd-product-link-grid',
                link_products: mf_sofa_range,
                link_label: 'Sofa Range',
                link_current: product,
                link_slug: 'sofa-range',
                link_show_price: true,
                link_show_quickadd: true
              -%}
            </div>

          {%- when 'sofa_colour' -%}
            {%- assign mf_sofa_colour = product.metafields.custom.colour_variants.value -%}
            <div {{ block.shopify_attributes }}>
              {%- render 'sd-product-link-grid',
                link_products: mf_sofa_colour,
                link_label: 'Select Colour',
                link_current: product,
                link_slug: 'sofa-colour',
                link_use_color: true
              -%}
            </div>

          {%- when 'swatch_collapse' -%}
            {%- comment -%} Swatches collapse — admin-configurable up to 8 swatches with image + label, plus optional CTA. {%- endcomment -%}
            <aside
              class="sd-pinsw is-collapsed"
              id="sd-pinsw-{{ section.id }}-{{ forloop.index }}"
              aria-label="{{ block.settings.heading | default: 'Swatches' | escape }}"
              {{ block.shopify_attributes }}
            >
              <button
                type="button"
                class="sd-pinsw__bar"
                aria-expanded="false"
                aria-controls="sd-pinsw-panel-{{ section.id }}-{{ forloop.index }}"
                data-sd-pinsw-toggle
              >
                <span class="sd-pinsw__bar-l">
                  <span class="sd-pinsw__bar-ico" aria-hidden="true">
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.9"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="12" cy="12" r="9"/>
                      <circle cx="12" cy="6.5" r="1.4" fill="currentColor"/>
                      <circle cx="17.5" cy="12" r="1.4" fill="currentColor"/>
                      <circle cx="12" cy="17.5" r="1.4" fill="currentColor"/>
                      <circle cx="6.5" cy="12" r="1.4" fill="currentColor"/>
                    </svg>
                  </span>
                  <span class="sd-pinsw__bar-txt">
                    <span class="sd-pinsw__bar-title">
                      {{- block.settings.heading | default: 'Order Free Swatches' | escape -}}
                    </span>
                    <span class="sd-pinsw__bar-sub">
                      {{- block.settings.subtitle | default: 'See &amp; feel before you buy' -}}
                    </span>
                  </span>
                </span>
                <span class="sd-pinsw__toggle" aria-hidden="true">
                  <span class="sd-pinsw__toggle-label">View</span>
                  <svg
                    class="sd-pinsw__chev"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </span>
              </button>

              <div class="sd-pinsw__panel" id="sd-pinsw-panel-{{ section.id }}-{{ forloop.index }}">
                {%- if block.settings.intro != blank -%}
                  <div class="sd-pinsw__intro rte">{{ block.settings.intro }}</div>
                {%- endif -%}
                <ul class="sd-pinsw__grid">
                  {%- for i in (1..8) -%}
                    {%- assign ikey = 'img_' | append: i -%}
                    {%- assign lkey = 'label_' | append: i -%}
                    {%- assign sw_img = block.settings[ikey] -%}
                    {%- assign sw_label = block.settings[lkey] -%}
                    {%- if sw_img != blank or sw_label != blank -%}
                      <li class="sd-pinsw__item">
                        <span class="sd-pinsw__img-wrap" aria-hidden="true">
                          {%- if sw_img != blank -%}
                            {{
                              sw_img
                              | image_url: width: 200
                              | image_tag: loading: 'lazy', widths: '80,120,160,200', sizes: '80px', alt: sw_label
                              | default: '', class: 'sd-pinsw__img'
                            }}
                          {%- endif -%}
                        </span>
                        {%- if sw_label != blank -%}
                          <span class="sd-pinsw__label">{{ sw_label | escape }}</span>
                        {%- endif -%}
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
                {%- assign sw_cta_url = block.settings.cta_url
                  | default: section.settings.swatch_page_url
                  | default: '/pages/order-free-swatches'
                -%}
                {%- assign sw_cta_label = block.settings.cta_label | default: 'Request Free Swatches' -%}
                <a class="sd-pinsw__cta" href="{{ sw_cta_url }}">
                  <span class="sd-pinsw__cta-badge">FREE</span>
                  <span class="sd-pinsw__cta-label">{{ sw_cta_label | escape }}</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>
            </aside>

            <script>
              (function () {
                var root = document.getElementById('sd-pinsw-{{ section.id }}-{{ forloop.index }}');
                if (!root) return;
                var btn = root.querySelector('[data-sd-pinsw-toggle]');
                btn.addEventListener('click', function () {
                  var open = root.classList.toggle('is-collapsed') === false;
                  btn.setAttribute('aria-expanded', open ? 'true' : 'false');
                });
              })();
            </script>

          {%- when 'generic_text' -%}
            {%- comment -%} Generic text block — content driven by block settings. Position is fully reorderable. {%- endcomment -%}
            <div class="sd-gx-text sd-gx-text--{{ block.settings.alignment }}" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                {%- case block.settings.heading_size -%}
                  {%- when 'h2' -%}
                    <h2 class="sd-gx-text__heading sd-gx-text__heading--lg">{{ block.settings.heading | escape }}</h2>
                  {%- when 'h4' -%}
                    <h4 class="sd-gx-text__heading sd-gx-text__heading--sm">{{ block.settings.heading | escape }}</h4>
                  {%- else -%}
                    <h3 class="sd-gx-text__heading sd-gx-text__heading--md">{{ block.settings.heading | escape }}</h3>
                {%- endcase -%}
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <div class="sd-gx-text__body rte">{{ block.settings.body }}</div>
              {%- endif -%}
            </div>

          {%- when 'generic_image' -%}
            {%- comment -%} Generic image block — content driven by block settings. Position is fully reorderable. {%- endcomment -%}
            {%- if block.settings.image != blank -%}
              <figure
                class="sd-gx-image"
                style="max-width: {{ block.settings.max_width }}px;"
                {{ block.shopify_attributes }}
              >
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '300,600,900,1200',
                    sizes: '(min-width: 750px) 600px, 100vw',
                    alt: block.settings.alt
                  | default: '', class: 'sd-gx-image__img'
                }}
                {%- if block.settings.caption != blank -%}
                  <figcaption class="sd-gx-image__caption">{{ block.settings.caption | escape }}</figcaption>
                {%- endif -%}
              </figure>
            {%- else -%}
              <div class="sd-gx-image sd-gx-image--placeholder" {{ block.shopify_attributes }}>
                <span>Select an image in the block settings.</span>
              </div>
            {%- endif -%}

          {%- when 'generic_icon_list' -%}
            {%- comment -%} Generic icon + label grid — up to 4 items. Position is fully reorderable. {%- endcomment -%}
            <div class="sd-gx-icons sd-gx-icons--cols-{{ block.settings.columns }}" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="sd-gx-icons__heading">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              <ul class="sd-gx-icons__list">
                {%- for i in (1..4) -%}
                  {%- assign ikey = 'icon_' | append: i -%}
                  {%- assign lkey = 'label_' | append: i -%}
                  {%- assign gx_icon = block.settings[ikey] -%}
                  {%- assign gx_label = block.settings[lkey] -%}
                  {%- if gx_icon != blank or gx_label != blank -%}
                    <li class="sd-gx-icons__item">
                      {%- if gx_icon != blank -%}
                        {{
                          gx_icon
                          | image_url: width: 80
                          | image_tag: loading: 'lazy', width: 40, height: 40, alt: gx_label
                          | default: '', class: 'sd-gx-icons__icon'
                        }}
                      {%- endif -%}
                      {%- if gx_label != blank -%}
                        <span class="sd-gx-icons__label">{{ gx_label | escape }}</span>
                      {%- endif -%}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'description_collapse' -%}
            {%- comment -%} Product Description — collapse block, drag-drop reorderable. Body renders product.description (set on the product page). {%- endcomment -%}
            <aside
              class="sd-pindesc is-collapsed"
              id="sd-pindesc-{{ section.id }}"
              aria-label="Product description"
              {{ block.shopify_attributes }}
            >
              <button
                type="button"
                class="sd-pindesc__bar"
                aria-expanded="false"
                aria-controls="sd-pindesc-panel-{{ section.id }}"
                data-sd-pindesc-toggle
              >
                <span class="sd-pindesc__bar-l">
                  <span class="sd-pindesc__bar-ico" aria-hidden="true">
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/>
                    </svg>
                  </span>
                  <span class="sd-pindesc__bar-txt">
                    <span class="sd-pindesc__bar-title">
                      {{- block.settings.heading | default: 'Product Description' -}}
                    </span>
                    {%- if block.settings.subtitle != blank -%}
                      <span class="sd-pindesc__bar-sub">{{ block.settings.subtitle }}</span>
                    {%- endif -%}
                  </span>
                </span>
                <span class="sd-pindesc__bar-toggle" aria-hidden="true">
                  <span class="sd-pindesc__bar-toggle-label">View</span>
                  <svg
                    class="sd-pindesc__bar-chev"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </span>
              </button>

              <div class="sd-pindesc__panel" id="sd-pindesc-panel-{{ section.id }}">
                <div class="sd-pindesc__body rte">
                  {%- if product.description != blank -%}
                    {{ product.description }}
                  {%- else -%}
                    <p>No description has been added for this product yet.</p>
                  {%- endif -%}
                </div>
              </div>
            </aside>

            <script>
              (function () {
                var root = document.getElementById('sd-pindesc-{{ section.id }}');
                if (!root) return;
                var btn = root.querySelector('[data-sd-pindesc-toggle]');
                btn.addEventListener('click', function () {
                  var open = root.classList.toggle('is-collapsed') === false;
                  btn.setAttribute('aria-expanded', open ? 'true' : 'false');
                });
              })();
            </script>

          {%- when 'atc_stack' -%}
            {%- comment -%} ATC + Order by Phone — moved to main block loop so admin can freely reorder its position. Uses HTML5 form="id" so the submit button still posts to the product form even though it renders outside the <form> element. {%- endcomment -%}
            <input type="hidden" name="quantity" value="1" id="sd-qty-{{ section.id }}" form="{{ product_form_id }}">
            <div class="sd-cta-stack" {{ block.shopify_attributes }}>
              <button
                type="submit"
                name="add"
                id="sd-atc-{{ section.id }}"
                form="{{ product_form_id }}"
                class="sd-atc-btn"
                {% unless current_variant.available %}
                  disabled
                {% endunless %}
                data-base-price="{{ current_variant.price }}"
                data-base-price-formatted="{{ current_variant.price | money }}"
                data-preorder="{{ sd_is_preorder }}"
              >
                                <span class="sd-atc-btn__label">
                  {%- if current_variant.available -%}
                    {%- if sd_is_preorder -%}
                      Pre Order Now — £<span class="sd-atc-total">{{ current_variant.price | money }}</span>
                    {%- else -%}
                      Add to Cart — £<span class="sd-atc-total">{{ current_variant.price | money }}</span>
                    {%- endif -%}
                  {%- else -%}
                    Out of Stock
                  {%- endif -%}
                </span>
                <span class="sd-atc-btn__spin" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
                  </svg>
                </span>
                <span class="sd-atc-btn__tick" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M20 6L9 17l-5-5"/>
                  </svg>
                </span>
              </button>
              {%- assign sd_phone = section.settings.support_phone | default: '02476581053' | replace: ' ', '' | replace: '-', '' -%}
              <a href="tel:{{ sd_phone }}" class="sd-phone-btn" aria-label="Order by phone {{ section.settings.support_phone | default: '02476 581 053' }}">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M15.05 5A5 5 0 0119 8.95M15.05 1A9 9 0 0123 8.94m-1 7.98v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
                </svg>
                Order By Phone
              </a>
            </div>

          {%- when 'addons' -%}
            {%- comment -%} Product Add-ons — 3 addon rows. Inputs use form="id" so they post to the product form even when this block renders OUTSIDE <form>. Drag-drop reorderable alongside ATC. {%- endcomment -%}
            <div class="sd-addons sd-addons--no-image" {{ block.shopify_attributes }}>
              <div class="sd-addons__list">
                {%- assign ap1 = section.settings.addon_product_1 -%}
                {%- assign ap2 = section.settings.addon_product_2 -%}
                {%- assign ap3 = section.settings.addon_product_3 -%}

                {%- comment -%} Fallback chain: selected_or_first_available_variant
                  returns nil when ALL variants are out-of-stock. Fall back to
                  variants.first so cart receives a valid variant id and Shopify
                  can return a meaningful error instead of silently dropping it. {%- endcomment -%}
                {%- assign av1 = ap1.selected_or_first_available_variant | default: ap1.variants.first -%}
                {%- assign av2 = ap2.selected_or_first_available_variant | default: ap2.variants.first -%}

                {%- comment -%} ── Auto-resolve Care-Plan PRODUCT from sofa material + price ──
                  Each price band × material has its own dedicated product
                  (verified live via Shopify Admin). Material is sniffed from
                  collection handles, band from current_variant.price. The
                  matched product replaces ap2/av2 below. Falls through to the
                  admin-set addon_product_2 if material/band can't be resolved. {%- endcomment -%}
                {%- assign _care_material = '' -%}
                {%- for _c in product.collections -%}
                  {%- assign _ch = _c.handle | downcase -%}
                  {%- if _care_material == '' -%}
                    {%- if _ch contains 'genuine-leather' -%}{%- assign _care_material = 'leather' -%}
                    {%- elsif _ch contains 'faux-leather' -%}{%- assign _care_material = 'faux' -%}
                    {%- elsif _ch contains 'fabric' -%}{%- assign _care_material = 'fabric' -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}

                {%- assign _sofa_pence = current_variant.price -%}
                {%- assign _care_handle = '' -%}

                {%- if _care_material == 'fabric' -%}
                  {%- if _sofa_pence < 50000 -%}
                    {%- assign _care_handle = 'sofa-direct-5-year-care-protection-plan-if-an-accident-happens-then-its-covered' -%}
                  {%- elsif _sofa_pence < 100000 -%}
                    {%- assign _care_handle = 'sofa-direct-5-year-care-protection-plan-if-an-accident-happens-then-its-covered-16445' -%}
                  {%- elsif _sofa_pence < 150000 -%}
                    {%- assign _care_handle = 'sofa-direct-5-year-care-protection-plan-if-an-accident-happens-then-its-covered-16446' -%}
                  {%- elsif _sofa_pence < 200000 -%}
                    {%- assign _care_handle = 'sofa-direct-5-year-care-protection-plan-if-an-accident-happens-then-its-covered-16447' -%}
                  {%- elsif _sofa_pence < 300000 -%}
                    {%- assign _care_handle = 'sofa-direct-5-year-care-protection-plan-if-an-accident-happens-then-its-covered-16448' -%}
                  {%- endif -%}
                {%- elsif _care_material == 'leather' -%}
                  {%- if _sofa_pence < 50000 -%}
                    {%- assign _care_handle = 'sofa-direct-5-year-care-protection-plan-if-an-accident-happens-then-its-covered-16449' -%}
                  {%- elsif _sofa_pence < 100000 -%}
                    {%- assign _care_handle = 'sofa-direct-5-year-care-protection-plan-if-an-accident-happens-then-its-covered-16450' -%}
                  {%- elsif _sofa_pence < 150000 -%}
                    {%- assign _care_handle = 'sofa-direct-5-year-care-protection-plan-if-an-accident-happens-then-its-covered-16451' -%}
                  {%- elsif _sofa_pence < 200000 -%}
                    {%- assign _care_handle = 'sofa-direct-5-year-care-protection-plan-if-an-accident-happens-then-its-covered-16452' -%}
                  {%- elsif _sofa_pence < 300000 -%}
                    {%- assign _care_handle = 'sofa-direct-5-year-care-protection-plan-if-an-accident-happens-then-its-covered-16453' -%}
                  {%- endif -%}
                {%- elsif _care_material == 'faux' -%}
                  {%- comment -%} Faux leather uses the £57 leather plan for 200-500 and 500-1000 bands {%- endcomment -%}
                  {%- if _sofa_pence < 100000 -%}
                    {%- assign _care_handle = 'sofa-direct-5-year-care-protection-plan-if-an-accident-happens-then-its-covered-16449' -%}
                  {%- endif -%}
                {%- endif -%}

                {%- if _care_handle != '' -%}
                  {%- assign _care_product = all_products[_care_handle] -%}
                  {%- if _care_product != blank -%}
                    {%- assign ap2 = _care_product -%}
                    {%- assign av2 = ap2.selected_or_first_available_variant | default: ap2.variants.first -%}
                  {%- endif -%}
                {%- endif -%}
                {%- assign av3 = ap3.selected_or_first_available_variant | default: ap3.variants.first -%}

                {%- comment -%} Premier Delivery {%- endcomment -%}
                <div class="sd-addon">
                  <label class="sd-addon__row">
                    <input type="checkbox" class="sd-addon__check" name="properties[Premier Delivery]" form="{{ product_form_id }}"
                      value="{% if av1 %}{{ av1.price | money_without_trailing_zeros }}{% else %}£49{% endif %}"
                      data-addon-price="{% if av1 %}{{ av1.price }}{% else %}4900{% endif %}"
                      {% if av1 %}data-addon-variant="{{ av1.id }}"{% endif %}>
                    <span class="sd-addon__icon">
                      {%- if ap1.featured_image -%}
                        {{ ap1.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', width: 60, height: 60, alt: ap1.title, class: 'sd-addon__icon-img' }}
                      {%- else -%}
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                      {%- endif -%}
                      <span class="sd-addon__check-badge" aria-hidden="true"><svg width="11" height="9" viewBox="0 0 11 9" fill="none"><path d="M1 4.5L4 7.5L10 1" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                    </span>
                    <div class="sd-addon__info">
                      <strong class="sd-addon__title">{%- if ap1 %}{{ ap1.title }}{% else %}Premier Delivery Service{% endif -%}</strong>
                      <span class="sd-addon__sub">Assembly &amp; Packaging Recycling</span>
                    </div>
                    <span class="sd-addon__price">{%- if av1 %}{{ av1.price | money_without_trailing_zeros }}{% else %}£49{% endif -%}</span>
                  </label>
                </div>

                {%- comment -%} 5 Year Care Protection {%- endcomment -%}
                <div class="sd-addon">
                  <label class="sd-addon__row">
                    <input type="checkbox" class="sd-addon__check" name="properties[Care Plan]" form="{{ product_form_id }}"
                      value="{% if av2 %}{{ av2.price | money_without_trailing_zeros }}{% else %}£91{% endif %}"
                      data-addon-price="{% if av2 %}{{ av2.price }}{% else %}9100{% endif %}"
                      {% if av2 %}data-addon-variant="{{ av2.id }}"{% endif %}>
                    <span class="sd-addon__icon">
                      {%- if ap2.featured_image -%}
                        {{ ap2.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', width: 60, height: 60, alt: ap2.title, class: 'sd-addon__icon-img' }}
                      {%- else -%}
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                      {%- endif -%}
                      <span class="sd-addon__check-badge" aria-hidden="true"><svg width="11" height="9" viewBox="0 0 11 9" fill="none"><path d="M1 4.5L4 7.5L10 1" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                    </span>
                    <div class="sd-addon__info">
                      <strong class="sd-addon__title">{%- if ap2 %}{{ ap2.title }}{% else %}5 Year Care Protection Plan{% endif -%}</strong>
                      <span class="sd-addon__sub">If an accident happens, then it's covered</span>
                    </div>
                    <span class="sd-addon__price">{%- if av2 %}{{ av2.price | money_without_trailing_zeros }}{% else %}£91{% endif -%}</span>
                  </label>
                </div>

                {%- comment -%} Sofa Removal with dynamic variant dropdown — options pulled from ap3.variants {%- endcomment -%}
                <div class="sd-addon" data-addon-slot="removal">
                  <label class="sd-addon__row">
                    <input type="checkbox" class="sd-addon__check" name="properties[Sofa Removal]" form="{{ product_form_id }}"
                      value="{% if av3 %}{{ av3.price | money_without_trailing_zeros }}{% else %}£99{% endif %}"
                      data-addon-price="{% if av3 %}{{ av3.price }}{% else %}9900{% endif %}"
                      {% if av3 %}data-addon-variant="{{ av3.id }}"{% endif %}>
                    <span class="sd-addon__icon">
                      {%- if ap3.featured_image -%}
                        {{ ap3.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', width: 60, height: 60, alt: ap3.title, class: 'sd-addon__icon-img' }}
                      {%- else -%}
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                      {%- endif -%}
                      <span class="sd-addon__check-badge" aria-hidden="true"><svg width="11" height="9" viewBox="0 0 11 9" fill="none"><path d="M1 4.5L4 7.5L10 1" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                    </span>
                    <div class="sd-addon__info">
                      <strong class="sd-addon__title">{%- if ap3 %}{{ ap3.title }}{% else %}Sofa Removal{% endif -%}</strong>
                      <span class="sd-addon__sub">(select your sofa)</span>
                    </div>
                    <div class="sd-addon__type-select">
                      <select class="sd-addon__dropdown" name="properties[Removal Type]" form="{{ product_form_id }}" data-addon-variant-select>
                        {%- if ap3 != blank and ap3.variants.size > 0 -%}
                          {%- for v in ap3.variants -%}
                            <option value="{{ v.title | escape }}"
                                    data-variant-id="{{ v.id }}"
                                    data-price="{{ v.price }}"
                                    data-price-fmt="{{ v.price | money_without_trailing_zeros | escape }}"
                                    {% unless v.available %}disabled{% endunless %}
                                    {% if v.id == av3.id %}selected{% endif %}>
                              {{- v.title -}}{% unless v.available %} (Sold out){% endunless %}
                            </option>
                          {%- endfor -%}
                        {%- else -%}
                          <option>Armchair</option><option>2 Seater</option><option>3 Seater</option><option>Corner Sofa</option>
                        {%- endif -%}
                      </select>
                      <svg class="sd-addon__dropdown-arrow" width="10" height="6" viewBox="0 0 12 6" fill="none"><path d="M1 1l5 4 5-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    </div>
                    <span class="sd-addon__price" data-addon-price-display>{%- if av3 %}{{ av3.price | money_without_trailing_zeros }}{% else %}£99{% endif -%}</span>
                  </label>
                </div>

                <script>
                  window.sdAddonData = [
                    { attr: 'Premier Delivery', variantId: {% if av1 %}{{ av1.id }}{% else %}null{% endif %}, rawPrice: {% if av1 %}{{ av1.price }}{% else %}4900{% endif %}, price: '{% if av1 %}{{ av1.price | money_without_trailing_zeros }}{% else %}£49{% endif %}', title: '{% if ap1 %}{{ ap1.title | escape }}{% else %}Premier Delivery Service{% endif %}', sub: 'Assembly & Packaging Recycling', image: '{% if ap1.featured_image %}{{ ap1.featured_image | image_url: width: 160 }}{% endif %}' },
                    { attr: 'Care Plan', variantId: {% if av2 %}{{ av2.id }}{% else %}null{% endif %}, rawPrice: {% if av2 %}{{ av2.price }}{% else %}9100{% endif %}, price: '{% if av2 %}{{ av2.price | money_without_trailing_zeros }}{% else %}£91{% endif %}', title: '{% if ap2 %}{{ ap2.title | escape }}{% else %}5 Year Care Protection Plan{% endif %}', sub: 'If an accident happens, it\'s covered', image: '{% if ap2.featured_image %}{{ ap2.featured_image | image_url: width: 160 }}{% endif %}' },
                    { attr: 'Sofa Removal', variantId: {% if av3 %}{{ av3.id }}{% else %}null{% endif %}, rawPrice: {% if av3 %}{{ av3.price }}{% else %}9900{% endif %}, price: '{% if av3 %}{{ av3.price | money_without_trailing_zeros }}{% else %}£99{% endif %}', title: '{% if ap3 %}{{ ap3.title | escape }}{% else %}Sofa Removal{% endif %}', sub: 'We\'ll remove your old sofa', image: '{% if ap3.featured_image %}{{ ap3.featured_image | image_url: width: 160 }}{% endif %}' }
                  ];

                  /* ── Sync Sofa-Removal dropdown → checkbox variant + price ──
                     When the user picks a different removal-type variant, mirror its
                     id and price onto the checkbox so cart-add posts the right SKU.
                     Also refresh the visible price + sdAddonData entry so any
                     sticky-ATC running total stays in sync. */
                  (function () {
                    var slot   = document.querySelector('[data-addon-slot="removal"]');
                    if (!slot) return;
                    var sel    = slot.querySelector('[data-addon-variant-select]');
                    var chk    = slot.querySelector('.sd-addon__check');
                    var priceEl = slot.querySelector('[data-addon-price-display]');
                    if (!sel || !chk) return;
                    function applyVariant() {
                      var opt = sel.options[sel.selectedIndex];
                      if (!opt) return;
                      var vid = opt.dataset.variantId;
                      var raw = opt.dataset.price;
                      var fmt = opt.dataset.priceFmt;
                      if (vid)  chk.dataset.addonVariant = vid;
                      if (raw)  chk.dataset.addonPrice   = raw;
                      if (fmt) { chk.value = fmt; if (priceEl) priceEl.textContent = fmt; }
                      /* Keep the sticky-ATC running-total source in sync */
                      if (window.sdAddonData && Array.isArray(window.sdAddonData)) {
                        for (var i = 0; i < window.sdAddonData.length; i++) {
                          if (window.sdAddonData[i].attr === 'Sofa Removal') {
                            if (vid) window.sdAddonData[i].variantId = parseInt(vid, 10);
                            if (raw) window.sdAddonData[i].rawPrice  = parseInt(raw, 10);
                            if (fmt) window.sdAddonData[i].price     = fmt;
                            break;
                          }
                        }
                      }
                      /* Re-fire running-total recompute if the sticky ATC listens */
                      chk.dispatchEvent(new Event('change', { bubbles: true }));
                    }
                    sel.addEventListener('change', applyVariant);
                  })();
                </script>
              </div>
            </div>

          {%- when 'trust_badges' -%}
