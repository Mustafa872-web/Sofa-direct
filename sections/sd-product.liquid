    class="sd-modal sd-modal--specs"
    id="sd-modal-specs-{{ section.id }}"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-label="Sofa Specification"
  >
    <div class="sd-modal__overlay" data-modal-close></div>
