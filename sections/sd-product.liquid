        <button class="sd-specs-panel__close" data-modal-close aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M18 6L6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <div class="sd-specs-panel__body">
        {%- if section.settings.specs_material != blank -%}
          <details class="sd-specs-acc">
            <summary class="sd-specs-acc__head">
              <span>Material</span>
              <svg
                class="sd-specs-acc__arrow"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M12 5v14M5 12l7 7 7-7"/>
              </svg>
            </summary>
            <div class="sd-specs-acc__body">{{ section.settings.specs_material }}</div>
          </details>
        {%- endif -%}
        {%- if section.settings.accordion_3_text != blank -%}
          <details class="sd-specs-acc">
            <summary class="sd-specs-acc__head">
              <span>Dimensions</span>
              <svg
                class="sd-specs-acc__arrow"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M12 5v14M5 12l7 7 7-7"/>
              </svg>
            </summary>
            <div class="sd-specs-acc__body">{{ section.settings.accordion_3_text }}</div>
          </details>
        {%- endif -%}
        {%- if section.settings.delivery_text != blank -%}
          <details class="sd-specs-acc">
            <summary class="sd-specs-acc__head">
              <span>Delivery &amp; Support</span>
              <svg
                class="sd-specs-acc__arrow"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M12 5v14M5 12l7 7 7-7"/>
              </svg>
            </summary>
            <div class="sd-specs-acc__body">{{ section.settings.delivery_text }}</div>
          </details>
        {%- endif -%}
        {%- if section.settings.specs_construction != blank -%}
          <details class="sd-specs-acc">
            <summary class="sd-specs-acc__head">
              <span>Construction &amp; Frame</span>
              <svg
                class="sd-specs-acc__arrow"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M12 5v14M5 12l7 7 7-7"/>
              </svg>
            </summary>
            <div class="sd-specs-acc__body">{{ section.settings.specs_construction }}</div>
          </details>
        {%- endif -%}
        {%- if section.settings.specs_care != blank -%}
          <details class="sd-specs-acc">
            <summary class="sd-specs-acc__head">
              <span>Care Instructions</span>
              <svg
                class="sd-specs-acc__arrow"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M12 5v14M5 12l7 7 7-7"/>
              </svg>
            </summary>
            <div class="sd-specs-acc__body">{{ section.settings.specs_care }}</div>
          </details>
        {%- endif -%}
        {%- if section.settings.specs_delivery != blank -%}
          <details class="sd-specs-acc">
            <summary class="sd-specs-acc__head">
              <span>Delivery Information</span>
              <svg
                class="sd-specs-acc__arrow"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M12 5v14M5 12l7 7 7-7"/>
              </svg>
            </summary>
            <div class="sd-specs-acc__body">{{ section.settings.specs_delivery }}</div>
          </details>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{%- comment -%}══ MODAL: 360° VIEW (opened from sticky bar "3D View" chip) ══{%- endcomment -%}
{%- if section.settings.show_3d_btn -%}
  <div
    class="sd-modal sd-modal--360"
    id="sd-modal-360-{{ section.id }}"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-label="360° View"
  >
    <div class="sd-modal__overlay" data-modal-close></div>
    <div class="sd-modal__panel sd-360-panel">
      <div class="sd-360-panel__head">
        <span class="sd-360-panel__title">
          <span class="sd-360-panel__badge">360°</span>
          Interactive View
        </span>
        <button class="sd-360-panel__close" data-modal-close aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M18 6L6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <div class="sd-360-panel__stage">
        <canvas
          class="sd-360-canvas"
          id="sd-360-canvas-modal-{{ section.id }}"
          data-frames-id="sd-360-frames-{{ section.id }}"
          data-context="modal"
        ></canvas>
        <div class="sd-360-panel__hint">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 12l-4 4 4 4"/><path d="M15 12l4 4-4 4"/><path d="M3 16h18"/>
          </svg>
          <span>Drag to rotate</span>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{%- comment -%}══ MODAL: AR / VIEW IN SPACE ══{%- endcomment -%}
{%- if has_view_in_space -%}
  {%- assign glb_url = view_in_space_url -%}
  {%- assign usdz_url = glb_url | replace: '.glb', '.usdz' -%}
  <div
    class="sd-modal sd-modal--ar"
    id="sd-modal-ar-{{ section.id }}"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
  >
    <div class="sd-modal__overlay" data-modal-close></div>
    <div class="sd-modal__panel sd-ar-panel">
      <div class="sd-ar-panel__head">
        <span class="sd-ar-panel__title">View in Your Space</span>
        <button class="sd-ar-panel__close" data-modal-close aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M18 6L6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <model-viewer
        class="sd-ar-viewer"
        id="sd-mv-{{ section.id }}"
        src="{{ glb_url }}"
        ios-src="{{ usdz_url }}"
        ar
        ar-modes="webxr scene-viewer quick-look"
        camera-controls
        shadow-intensity="1"
        exposure="0.9"
      >
        <button slot="ar-button" style="display:none;"></button>
      </model-viewer>
      <div class="sd-ar-actions">
        <button
          class="sd-ar-launch-btn"
          id="sd-ar-launch-{{ section.id }}"
          data-mv="sd-mv-{{ section.id }}"
          data-glb="{{ glb_url | escape }}"
          data-usdz="{{ usdz_url | escape }}"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 3H3v4"/><path d="M19 3h2v4"/><path d="M5 21H3v-4"/><path d="M19 21h2v-4"/><path d="M12 8l-4 2.5v5L12 18l4-2.5v-5L12 8z"/>
          </svg>
          View in Your Room
        </button>
        <p class="sd-ar-hint">Scan QR with your phone to view this sofa in 3D or place it in your room</p>
      </div>

      <!-- QR overlay inside the AR panel -->
      <div class="sd-ar-qr-overlay" id="sd-ar-qr-overlay-{{ section.id }}" style="display:none;">
        <button class="sd-ar-qr-back" id="sd-ar-qr-back-{{ section.id }}">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
          Back
        </button>
        <div class="sd-ar-qr-box" id="sd-ar-qr-box-{{ section.id }}"></div>
        <p class="sd-ar-qr-label">Point your phone camera at this code</p>
        <p class="sd-ar-qr-sub">iOS 13+ &nbsp;·&nbsp; Android with ARCore</p>
      </div>
    </div>
  </div>
  <script>
    (function () {
      var loaded = false;
      function loadMV() {
        if (loaded) return;
        loaded = true;
        var s = document.createElement('script');
        s.type = 'module';
        s.src = 'https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js';
        document.head.appendChild(s);
      }
      // Load when user clicks any 3D / AR trigger
      document.addEventListener('click', function (e) {
        var t = e.target.closest(
          '[data-open-modal*="ar"], .sd-product__3d-btn, #sd-ar-launch-{{ section.id }}, [data-modal-open="sd-modal-ar-{{ section.id }}"]'
        );
        if (t) loadMV();
      });
    })();
  </script>
{%- endif -%}

{%- comment -%}══ MODAL: SWATCHES ══{%- endcomment -%}
<div
  class="sd-modal"
  id="sd-modal-swatches-{{ section.id }}"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Order Free Swatches"
>
  <div class="sd-modal__overlay" data-modal-close></div>
  <div class="sd-modal__panel">
    <div class="sd-modal__head">
      <h3 class="sd-modal__title">Order Free Swatches</h3>
      <button class="sd-modal__close" data-modal-close aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="sd-modal__body">
      <p class="sd-swatches__intro">
        Select up to 5 free fabric swatches to be posted to you. Choose your favourites below:
      </p>
      <div class="sd-swatches__grid">
        {%- for option in product.options_with_values -%}
          {%- assign opt_d = option.name | downcase -%}
          {%- if opt_d contains 'colour' or opt_d contains 'color' or opt_d contains 'fabric' -%}
            {%- for value in option.values -%}
              <label class="sd-swatches__item">
                <input type="checkbox" name="swatches[]" value="{{ value | escape }}" class="sd-swatches__check">
                <span class="sd-swatches__dot" style="background:{{ value | handle | replace:'-','' }};"></span>
                <span class="sd-swatches__name">{{ value }}</span>
              </label>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="sd-swatches__form">
        <input type="text" class="sd-swatches__input" placeholder="Full Name" required>
        <input type="text" class="sd-swatches__input" placeholder="Address Line 1" required>
        <input type="text" class="sd-swatches__input" placeholder="Postcode" required>
        <input type="email" class="sd-swatches__input" placeholder="Email" required>
        <button type="button" class="sd-swatches__submit">Request Free Swatches</button>
      </div>
    </div>
  </div>
</div>

<script id="sd-variants-json-{{ section.id }}" type="application/json">
  {{ product.variants | json }}
</script>

{%- comment -%} 360° frame URLs — from metafield custom.view_360 (list.file_reference) {%- endcomment -%}
{%- assign frames_360 = product.metafields.custom.view_360.value -%}
<script id="sd-360-frames-{{ section.id }}" type="application/json">
  [
    {%- if frames_360 != blank -%}
      {%- for img in frames_360 -%}
        "{{ img | image_url: width: 900, format: 'webp' }}"
        {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
  ]
</script>

<script src="{{ 'sd-product.js' | asset_url }}" defer="defer"></script>

{%- comment -%} Sticky Add-to-Cart bar removed by request — do not render. {%- endcomment -%}

{% schema %}
{
  "name": "SD Product",
  "tag": "section",
  "class": "sd-product-section",
  "settings": [
    {
      "type": "header",
      "content": "Gallery Layout"
    },
    {
      "type": "checkbox",
      "id": "enable_v2_layout",
      "label": "Enable V2 layout (938×635 featured image + auto grid)",
      "default": false
    },
    {
      "type": "header",
      "content": "Add-on Products"
    },
    {
      "type": "product",
      "id": "addon_product_1",
      "label": "Add-on 1 — Premier Delivery Service"
    },
    {
      "type": "product",
      "id": "addon_product_2",
      "label": "Add-on 2 — 5 Year Care Protection Plan (fallback only)",
      "info": "Default care plan product used only when material (fabric / genuine-leather / faux-leather) or price band can't be detected from the current product's collections. The correct priced care plan is auto-selected from a hardcoded table — no per-product setup needed."
    },
    {
      "type": "product",
      "id": "addon_product_3",
      "label": "Add-on 3 — Sofa Removal"
    },
    {
      "type": "checkbox",
      "id": "addon_3_show_dropdown",
      "label": "Add-on 3 — Show sofa-type dropdown",
      "info": "Tick if Add-on 3 is a Sofa Removal service. Untick for any other product.",
      "default": false
    },
    {
      "type": "header",
      "content": "Linked Sections Order",
      "info": "Set the display order (1 = top) of Sofa Type, Sofa Range, and Make Colour."
    },
    {
      "type": "select",
      "id": "link_order_type",
      "label": "Sofa Type position",
      "options": [
        { "value": "1", "label": "1 (top)" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3 (bottom)" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "link_order_range",
      "label": "Sofa Range position",
      "options": [
        { "value": "1", "label": "1 (top)" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3 (bottom)" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "link_order_colour",
      "label": "Make Colour position",
      "options": [
