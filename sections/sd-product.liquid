                    {%- assign has_custom_icons = true -%}
                    <span class="sd-pay-chip sd-pay-chip--img">
                      {{ section.settings[pkey] | image_url: width: 160 | image_tag: class: 'sd-pay-chip__img', loading: 'lazy', width: 60, height: 60, alt: 'Payment method' }}
                    </span>
                  {%- endif -%}
                {%- endfor -%}
                {%- unless has_custom_icons -%}
                  <span class="sd-pay-chip sd-pay-chip--delta" aria-label="Debit/Credit Card"><svg viewBox="0 0 40 40" width="100%" height="100%" fill="none" aria-hidden="true"><circle cx="20" cy="20" r="20" fill="#003b7a"/><text x="50%" y="56%" text-anchor="middle" fill="#fff" font-family="Arial,sans-serif" font-weight="900" font-size="15" dominant-baseline="middle">D</text></svg></span>
                  <span class="sd-pay-chip sd-pay-chip--mint" aria-label="Pay Later"><svg viewBox="0 0 40 40" width="100%" height="100%" fill="none" aria-hidden="true"><circle cx="20" cy="20" r="20" fill="#b4f1d8"/><path d="M13 14l6 6-6 6M27 14l-6 6 6 6" stroke="#083f2b" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                  <span class="sd-pay-chip sd-pay-chip--paypal" aria-label="PayPal"><svg viewBox="0 0 40 40" width="100%" height="100%" fill="none" aria-hidden="true"><circle cx="20" cy="20" r="20" fill="#3b82f6"/><text x="50%" y="58%" text-anchor="middle" fill="#fff" font-family="Arial,sans-serif" font-weight="900" font-size="18" font-style="italic" dominant-baseline="middle">P</text></svg></span>
                  <span class="sd-pay-chip sd-pay-chip--pink" aria-label="Klarna"><svg viewBox="0 0 40 40" width="100%" height="100%" fill="none" aria-hidden="true"><circle cx="20" cy="20" r="20" fill="#ffb3c7"/><text x="50%" y="57%" text-anchor="middle" fill="#0a0a0a" font-family="Arial,sans-serif" font-weight="900" font-size="9" dominant-baseline="middle">Klarna</text></svg></span>
                {%- endunless -%}
