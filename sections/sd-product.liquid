            <script>
              (function () {
                var root = document.getElementById('sd-pidel-{{ section.id }}');
                if (!root) return;

                var toggleBtn = root.querySelector('[data-sd-pidel-toggle]');
                var form = root.querySelector('[data-sd-pidel-form]');
                var pcInput = root.querySelector('[data-sd-pidel-pc]');
                var checkBtn = root.querySelector('[data-sd-pidel-check]');
                var resultEl = root.querySelector('[data-sd-pidel-result]');
                var etaEl = root.querySelector('[data-sd-pidel-eta]');
                var etaBarEl = root.querySelector('[data-sd-pidel-eta-bar]');

                toggleBtn.addEventListener('click', function () {
                  var nowOpen = root.classList.toggle('is-collapsed') === false;
                  toggleBtn.setAttribute('aria-expanded', nowOpen ? 'true' : 'false');
                  if (nowOpen)
                    setTimeout(function () {
                      pcInput && pcInput.focus();
                    }, 250);
                });

                function workingDayFrom(daysToAdd) {
                  var d = new Date();
                  var added = 0;
                  while (added < daysToAdd) {
                    d.setDate(d.getDate() + 1);
                    var dow = d.getDay();
                    if (dow !== 0 && dow !== 6) added++;
                  }
                  return d;
                }
                function fmtDate(d) {
                  return d.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
                }

                function check() {
                  var raw = (pcInput.value || '').trim().toUpperCase().replace(/\s+/g, '');
                  if (!raw || raw.length < 2) {
                    resultEl.innerHTML =
                      '<span class="sd-pidel__pc-warn">Enter a UK postcode to see your estimate.</span>';
                    return;
                  }
                  var area = raw.replace(/[0-9].*$/, '');
                  var slow = [
                    'IV',
                    'KW',
                    'PA',
                    'PH',
                    'HS',
                    'ZE',
                    'AB',
                    'DD',
                    'BT',
                    'IM',
                    'TR',
                    'PL',
                    'EX',
                    'TQ',
                    'LL',
                    'SA',
                    'LD',
                    'HR',
                    'TD',
                    'DG',
                    'KA',
                    'KY',
                    'FK',
                    'PO30',
                    'PO31',
                    'PO32',
                    'PO33',
                    'PO34',
                    'PO35',
                    'PO36',
                    'PO37',
                    'PO38',
                    'PO39',
                    'PO40',
                    'PO41',
                  ];
                  var isSlow = slow.some(function (a) {
                    return raw.indexOf(a) === 0;
                  });
                  var minD = isSlow ? 8 : 5;
                  var maxD = isSlow ? 14 : 10;
                  var minDate = workingDayFrom(minD);
                  var maxDate = workingDayFrom(maxD);
                  var etaText = 'Between <strong>' + fmtDate(minDate) + ' – ' + fmtDate(maxDate) + '</strong>';
                  resultEl.innerHTML =
                    '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg> ' +
                    'Delivery to <strong>' +
                    raw +
                    '</strong>: ' +
                    etaText;
                  var shortText = 'Est. ' + minD + '–' + maxD + ' working days';
                  if (etaEl) etaEl.textContent = shortText;
                  if (etaBarEl) etaBarEl.textContent = shortText;
                }

                checkBtn.addEventListener('click', check);
                pcInput.addEventListener('keydown', function (e) {
                  if (e.key === 'Enter') {
                    e.preventDefault();
                    check();
                  }
                });
              })();
            </script>
