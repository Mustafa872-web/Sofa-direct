<link rel="stylesheet" href="{{ 'sd-ideas.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'sd-ideas.css' | asset_url | stylesheet_tag }}</noscript>

<section class="sd-ideas-spotlight">
  <div class="sd-ideas-spotlight__inner">
    <div class="sd-ideas-spotlight__media">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="1200" height="800">
      {%- endif -%}
    </div>
    <div class="sd-ideas-spotlight__body">
      {%- if section.settings.tag != blank -%}
        <span class="sd-ideas-spotlight__tag">{{ section.settings.tag }}</span>
      {%- endif -%}
      <h2 class="sd-ideas-spotlight__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="sd-ideas-spotlight__text">{{ section.settings.body }}</p>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="sd-ideas-spotlight__link" href="{{ section.settings.link | default: '#' }}">
          {{ section.settings.link_label }}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ideas Spotlight",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "tag", "label": "Tag", "default": "Featured Guide" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How To Choose The Perfect Sofa" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "From measuring your room to choosing the right fabric, our six-step guide walks you through every decision that matters." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the guide" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [ { "name": "Ideas Spotlight" } ]
}
{% endschema %}
