<link rel="stylesheet" href="{{ 'sd-about-story.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'sd-about-story.css' | asset_url | stylesheet_tag }}</noscript>

<section class="sd-about-story" aria-label="Our story">
  <div class="sd-about-story__inner">

    <div class="sd-about-story__text-col">
      {%- if section.settings.icon != blank -%}
        {{
          section.settings.icon
          | image_url: width: 184
          | image_tag:
            class: 'sd-about-story__icon',
            widths: '92,184',
            sizes: '92px',
            alt: 'Trustpilot rating',
            loading: 'lazy'
        }}
      {%- else -%}
        <svg class="sd-about-story__icon" viewBox="0 0 92 92" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Trustpilot">
          <rect width="92" height="92" rx="12" fill="#00b67a"/>
          <path d="M46 16l8.09 24.88H80L57.96 55.12 66.04 80 46 64.24 25.96 80l8.08-24.88L12 40.88h25.91L46 16z" fill="#fff"/>
        </svg>
      {%- endif -%}

      {%- if section.settings.body_text != blank -%}
        <p class="sd-about-story__body">{{ section.settings.body_text }}</p>
      {%- endif -%}
    </div>

    <div class="sd-about-story__image-col{% if section.settings.mobile_image != blank %} sd-about-story__image-col--has-mobile-image{% endif %}">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 960
          | image_tag:
            class: 'sd-about-story__img sd-about-story__img--desktop',
            widths: '480,720,960',
            sizes: '(min-width: 990px) 50vw, 100vw',
            alt: 'Our story',
            loading: 'lazy'
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'sd-about-story__img sd-about-story__img--desktop' }}
      {%- endif -%}

      {%- if section.settings.mobile_image != blank -%}
        {{
          section.settings.mobile_image
          | image_url: width: 900
          | image_tag:
            class: 'sd-about-story__img sd-about-story__img--mobile',
            widths: '375,550,750,900',
            sizes: '100vw',
            alt: 'Our story',
            loading: 'lazy'
        }}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "SD About Story",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Trust icon (e.g. Trustpilot)"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "We work directly with trusted manufacturers to bring you quality sofas without the traditional showroom markups. By keeping things streamlined and efficient, we're able to offer better value — without compromising on comfort or durability."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Image (mobile)"
    }
  ],
  "presets": [
    {
      "name": "SD About Story"
    }
  ]
}
{% endschema %}
