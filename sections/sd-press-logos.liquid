<link rel="stylesheet" href="{{ 'sd-press-logos.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'sd-press-logos.css' | asset_url | stylesheet_tag }}</noscript>

{%- liquid
  assign eyebrow        = section.settings.eyebrow
  assign heading        = section.settings.heading
  assign subheading     = section.settings.subheading
  assign rating_text    = section.settings.rating_text
  assign speed          = section.settings.speed | default: 50
  assign logo_blocks    = section.blocks
-%}

<section
  class="sd-press{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
  aria-label="As featured in"
  style="--sd-press-speed: {{ speed }}s;"
>
  {%- comment -%} ── Soft brand-color glow background ── {%- endcomment -%}
  <div class="sd-press__bg" aria-hidden="true">
    <span class="sd-press__glow sd-press__glow--a"></span>
    <span class="sd-press__glow sd-press__glow--b"></span>
  </div>

  <div class="sd-press__inner page-width">
    <div class="sd-press__header">
      {%- if eyebrow != blank -%}
        <div class="sd-press__eyebrow">
          <svg class="sd-press__ornament" width="44" height="10" viewBox="0 0 44 10" aria-hidden="true">
            <path d="M0 5h16M28 5h16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            <circle cx="22" cy="5" r="2.6" fill="currentColor"/>
          </svg>
          <span class="sd-press__eyebrow-text">{{ eyebrow }}</span>
          <svg class="sd-press__ornament" width="44" height="10" viewBox="0 0 44 10" aria-hidden="true">
            <path d="M0 5h16M28 5h16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            <circle cx="22" cy="5" r="2.6" fill="currentColor"/>
          </svg>
        </div>
      {%- endif -%}

      {%- if heading != blank -%}
        <h2 class="sd-press__heading">{{ heading }}</h2>
      {%- endif -%}

      {%- if subheading != blank -%}
        <p class="sd-press__subheading">{{ subheading }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ── Brand-taupe press band with floating white logo chips ── {%- endcomment -%}
  <div class="sd-press__band">
    <span class="sd-press__band-edge sd-press__band-edge--top" aria-hidden="true"></span>
    <span class="sd-press__band-edge sd-press__band-edge--bottom" aria-hidden="true"></span>

    {%- if logo_blocks.size > 0 -%}
      <div class="sd-press__track-wrap">
        <div class="sd-press__track">
          {%- for i in (1..2) -%}
            <ul class="sd-press__list" {% if i == 2 %}aria-hidden="true"{% endif %}>
              {%- for block in logo_blocks -%}
                <li class="sd-press__item" {{ block.shopify_attributes }}>
                  {%- if block.settings.logo_url != blank -%}
                    <a class="sd-press__chip" href="{{ block.settings.logo_url }}" target="_blank" rel="noopener" aria-label="{{ block.settings.logo_alt | default: 'Press logo' | escape }}">
                  {%- else -%}
                    <div class="sd-press__chip">
                  {%- endif -%}
                    <span class="sd-press__chip-tick" aria-hidden="true"></span>
                    {%- if block.settings.logo_image != blank -%}
                      {{ block.settings.logo_image | image_url: width: 400 | image_tag:
                          loading: 'lazy',
                          widths: '120,180,240,320,400',
                          sizes: '(max-width: 749px) 130px, 180px',
                          alt: block.settings.logo_alt,
                          class: 'sd-press__img' }}
                    {%- else -%}
                      <span class="sd-press__placeholder">{{ block.settings.logo_alt | default: 'Logo' }}</span>
                    {%- endif -%}
                  {%- if block.settings.logo_url != blank -%}</a>{%- else -%}</div>{%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if rating_text != blank -%}
    <div class="sd-press__footnote page-width">
      <div class="sd-press__stars" aria-hidden="true">
        {%- for i in (1..5) -%}
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
        {%- endfor -%}
      </div>
      <p class="sd-press__rating-text">{{ rating_text }}</p>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "SD Press Logos",
  "tag": "section",
  "class": "section sd-press-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "As Featured In"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by the UK's leading home & lifestyle press."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "From design editors to weekend supplements — Sofa Direct is the name UK homes turn to for comfort, craft and effortless style."
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Footnote / rating line",
      "default": "Rated 4.7 / 5 by 5,200+ verified UK customers"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll duration",
      "min": 20,
      "max": 90,
      "step": 5,
      "default": 50,
      "unit": "s",
      "info": "Higher = slower"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press logo",
      "settings": [
        { "type": "image_picker", "id": "logo_image", "label": "Logo image" },
        { "type": "text", "id": "logo_alt", "label": "Publication name / alt" },
        { "type": "url", "id": "logo_url", "label": "Link (optional)" }
      ]
    },
    {
      "type": "logo_row1",
      "name": "Press logo (legacy)",
      "settings": [
        { "type": "image_picker", "id": "logo_image", "label": "Logo image" },
        { "type": "text", "id": "logo_alt", "label": "Publication name / alt" },
        { "type": "url", "id": "logo_url", "label": "Link (optional)" }
      ]
    },
    {
      "type": "logo_row2",
      "name": "Press logo (legacy alt)",
      "settings": [
        { "type": "image_picker", "id": "logo_image", "label": "Logo image" },
        { "type": "text", "id": "logo_alt", "label": "Publication name / alt" },
        { "type": "url", "id": "logo_url", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SD Press Logos",
      "settings": {
        "eyebrow": "As Featured In",
        "heading": "Loved by the UK's leading home & lifestyle press.",
        "subheading": "From design editors to weekend supplements — Sofa Direct is the name UK homes turn to for comfort, craft and effortless style.",
        "rating_text": "Rated 4.7 / 5 by 5,200+ verified UK customers",
        "speed": 50
      },
      "blocks": [
        { "type": "logo", "settings": { "logo_alt": "Country Living" } },
        { "type": "logo", "settings": { "logo_alt": "Daily Express" } },
        { "type": "logo", "settings": { "logo_alt": "GQ" } },
        { "type": "logo", "settings": { "logo_alt": "Ideal Home" } },
        { "type": "logo", "settings": { "logo_alt": "House Beautiful" } },
        { "type": "logo", "settings": { "logo_alt": "Livingetc" } },
        { "type": "logo", "settings": { "logo_alt": "Good Homes" } },
        { "type": "logo", "settings": { "logo_alt": "The Times" } }
      ]
    }
  ]
}
{% endschema %}
