<link rel="stylesheet" href="{{ 'sd-sofa-sizer.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'sd-sofa-sizer.css' | asset_url | stylesheet_tag }}</noscript>

{%- liquid
  assign hero_heading   = section.settings.hero_heading   | default: 'Find Your Perfect Sofa Size'
  assign hero_sub       = section.settings.hero_sub       | default: 'Answer a few questions and instantly see which sofas will look stunning — and actually fit — in your space.'
  assign hero_cta       = section.settings.hero_cta_label | default: 'Start Sizing'
  assign hero_image     = section.settings.hero_image
  assign collection_h   = section.settings.collection_handle | default: 'sofas'
  assign tool_eyebrow   = section.settings.tool_eyebrow   | default: 'Interactive Tool'
  assign tool_title     = section.settings.tool_title     | default: 'Your Personalised Room Planner'
  assign benefits_title = section.settings.benefits_title | default: 'Why Use the Sofa Sizer?'
-%}

<div id="sd-sofa-sizer-{{ section.id }}" class="sd-sofa-sizer" data-collection="{{ collection_h }}">

  {%- comment -%}═══════════════════════════════════════ HERO ═{%- endcomment -%}
  <section class="sds-hero" aria-label="Sofa Sizer hero">

    <div class="sds-hero__bg"></div>

    {%- if hero_image != blank -%}
      <div class="sds-hero__bg-img"
        style="background-image: url('{{ hero_image | image_url: width: 1920 }}');"
        aria-hidden="true">
      </div>
    {%- endif -%}

    <div class="sds-hero__grid-overlay" aria-hidden="true"></div>

    <div class="sds-hero__inner">

      <div class="sds-hero__content">
        <div class="sds-hero__badge">Room Planning Tool</div>

        <h1 class="sds-hero__heading">
          {%- assign heading_parts = hero_heading | split: ' | ' -%}
          {%- for part in heading_parts -%}
            {%- if forloop.last and heading_parts.size > 1 -%}
              <em>{{ part }}</em>
            {%- else -%}
              {{ part }}
              {%- unless forloop.last -%}<br>{%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        </h1>

        <p class="sds-hero__sub">{{ hero_sub }}</p>

        <button
          class="sds-hero__cta"
          id="sds-hero-cta-{{ section.id }}"
          aria-label="{{ hero_cta }}"
        >
          {{ hero_cta }}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>

        <div class="sds-hero__stats">
          <div class="sds-hero__stat">
            <b>{{ section.settings.stat_1_val | default: '500+' }}</b>
            <span>{{ section.settings.stat_1_lbl | default: 'Sofas sized' }}</span>
          </div>
          <div class="sds-hero__stat">
            <b>{{ section.settings.stat_2_val | default: '2 min' }}</b>
            <span>{{ section.settings.stat_2_lbl | default: 'To complete' }}</span>
          </div>
          <div class="sds-hero__stat">
            <b>{{ section.settings.stat_3_val | default: '100%' }}</b>
            <span>{{ section.settings.stat_3_lbl | default: 'Free to use' }}</span>
          </div>
        </div>
      </div>

      {%- comment -%} Animated room illustration {%- endcomment -%}
      <div class="sds-hero__visual" aria-hidden="true">
        <svg class="sds-hero__room-art" viewBox="0 0 500 400" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Room floor -->
          <rect x="40" y="80" width="420" height="290" rx="16" fill="rgba(255,250,234,0.08)" stroke="rgba(165,140,112,0.4)" stroke-width="2"/>
          <!-- Floor grid -->
          <line x1="145" y1="80" x2="145" y2="370" stroke="rgba(165,140,112,0.12)" stroke-width="1"/>
          <line x1="250" y1="80" x2="250" y2="370" stroke="rgba(165,140,112,0.12)" stroke-width="1"/>
          <line x1="355" y1="80" x2="355" y2="370" stroke="rgba(165,140,112,0.12)" stroke-width="1"/>
          <line x1="40" y1="180" x2="460" y2="180" stroke="rgba(165,140,112,0.12)" stroke-width="1"/>
          <line x1="40" y1="275" x2="460" y2="275" stroke="rgba(165,140,112,0.12)" stroke-width="1"/>
          <!-- Sofa body -->
          <rect x="100" y="230" width="300" height="110" rx="14" fill="rgba(165,140,112,0.3)" stroke="rgba(165,140,112,0.6)" stroke-width="2"/>
          <!-- Sofa back -->
          <rect x="100" y="210" width="300" height="35" rx="10" fill="rgba(165,140,112,0.4)" stroke="rgba(165,140,112,0.6)" stroke-width="2"/>
          <!-- Sofa cushions -->
          <rect x="110" y="242" width="88" height="80" rx="10" fill="rgba(192,176,159,0.4)" stroke="rgba(165,140,112,0.4)" stroke-width="1.5"/>
          <rect x="206" y="242" width="88" height="80" rx="10" fill="rgba(192,176,159,0.4)" stroke="rgba(165,140,112,0.4)" stroke-width="1.5"/>
          <rect x="302" y="242" width="88" height="80" rx="10" fill="rgba(192,176,159,0.4)" stroke="rgba(165,140,112,0.4)" stroke-width="1.5"/>
          <!-- Sofa arms -->
          <rect x="78" y="220" width="28" height="90" rx="8" fill="rgba(165,140,112,0.4)" stroke="rgba(165,140,112,0.5)" stroke-width="1.5"/>
          <rect x="394" y="220" width="28" height="90" rx="8" fill="rgba(165,140,112,0.4)" stroke="rgba(165,140,112,0.5)" stroke-width="1.5"/>
          <!-- Coffee table -->
          <rect x="175" y="130" width="150" height="75" rx="10" fill="rgba(47,72,88,0.25)" stroke="rgba(47,72,88,0.5)" stroke-width="1.5"/>
          <!-- Table decor -->
          <circle cx="215" cy="167" r="12" fill="rgba(165,140,112,0.3)" stroke="rgba(165,140,112,0.5)" stroke-width="1"/>
          <circle cx="285" cy="167" r="8" fill="rgba(165,140,112,0.2)" stroke="rgba(165,140,112,0.4)" stroke-width="1"/>
          <!-- Dimension arrows -->
          <defs>
            <marker id="arr" markerWidth="6" markerHeight="6" refX="3" refY="3" orient="auto">
              <path d="M0,0 L0,6 L6,3 z" fill="rgba(165,140,112,0.7)"/>
            </marker>
          </defs>
          <line x1="40" y1="55" x2="460" y2="55" stroke="rgba(165,140,112,0.5)" stroke-width="1.5" marker-start="url(#arr)" marker-end="url(#arr)"/>
          <text x="250" y="42" font-family="Montserrat,sans-serif" font-size="13" fill="rgba(165,140,112,0.8)" text-anchor="middle" font-weight="600">420 cm</text>
          <line x1="478" y1="80" x2="478" y2="370" stroke="rgba(165,140,112,0.5)" stroke-width="1.5" marker-start="url(#arr)" marker-end="url(#arr)"/>
          <text x="494" y="228" font-family="Montserrat,sans-serif" font-size="13" fill="rgba(165,140,112,0.8)" text-anchor="middle" font-weight="600" transform="rotate(90,494,228)">290 cm</text>
        </svg>
      </div>

    </div>
  </section>

  {%- comment -%}═══════════════════════════════════════ WIZARD ═{%- endcomment -%}
  <section class="sds-wizard" id="sds-wizard-{{ section.id }}" aria-label="Sofa sizer tool">
    <div class="sds-wizard__container">

      <span class="sds-section-eyebrow">{{ tool_eyebrow }}</span>
      <span class="sds-section-title">{{ tool_title }}</span>

      {%- comment -%} Progress indicator {%- endcomment -%}
      <nav class="sds-progress" aria-label="Tool steps">
        {%- assign step_labels = 'Room,Sofa,Layout,Preview,Results' | split: ',' -%}
        {%- for lbl in step_labels -%}
          <div class="sds-progress__step{% if forloop.first %} active{% endif %}" data-step="{{ forloop.index }}" aria-label="Step {{ forloop.index }}: {{ lbl }}">
            <div class="sds-progress__circle">
              <svg class="sds-tick" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span class="sds-step-num">{{ forloop.index }}</span>
            </div>
            <span class="sds-progress__label">{{ lbl }}</span>
          </div>
          {%- unless forloop.last -%}
            <div class="sds-progress__connector"></div>
          {%- endunless -%}
        {%- endfor -%}
      </nav>

      {%- comment -%} Wizard card {%- endcomment -%}
      <div class="sds-card">

        {%- comment -%}──── STEP 1: Room Size ────{%- endcomment -%}
        <div class="sds-panel active" id="sds-panel-1">
          <p class="sds-panel__step-num">Step 1 of 5</p>
          <h2 class="sds-panel__title">Your Room Dimensions</h2>
          <p class="sds-panel__sub">Enter the width and depth of the wall where your sofa will go.</p>

          <div class="sds-unit-toggle" role="group" aria-label="Measurement unit">
            <button class="sds-unit-btn active" data-unit="cm">cm</button>
            <button class="sds-unit-btn" data-unit="in">inches</button>
          </div>

          <div class="sds-room-inputs">
            <div class="sds-input-group">
              <label for="sds-room-width">
                Room Width
                <span class="sds-val-display"><span class="sds-val-width">350</span> <span class="sds-unit-label">cm</span></span>
              </label>
              <input type="range" id="sds-room-width" class="sds-slider" min="100" max="800" value="350" step="5" aria-label="Room width">
              <input type="number" id="sds-room-width-num" class="sds-num-input" value="350" min="100" max="800" aria-label="Room width number">
            </div>
            <div class="sds-input-group">
              <label for="sds-room-depth">
                Room Depth
                <span class="sds-val-display"><span class="sds-val-depth">400</span> <span class="sds-unit-label">cm</span></span>
              </label>
              <input type="range" id="sds-room-depth" class="sds-slider" min="100" max="800" value="400" step="5" aria-label="Room depth">
              <input type="number" id="sds-room-depth-num" class="sds-num-input" value="400" min="100" max="800" aria-label="Room depth number">
            </div>
          </div>

          <div class="sds-room-canvas-wrap">
            <canvas id="sds-room-canvas" width="420" height="220" aria-label="Room size visualisation"></canvas>
          </div>

          <div class="sds-panel__footer">
            <span></span>
            <button class="sds-btn sds-btn--primary" data-sds-next>
              Next: Choose Sofa
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>

        {%- comment -%}──── STEP 2: Sofa Type ────{%- endcomment -%}
        <div class="sds-panel" id="sds-panel-2">
          <p class="sds-panel__step-num">Step 2 of 5</p>
          <h2 class="sds-panel__title">Select Your Sofa Type</h2>
          <p class="sds-panel__sub">Pick the style of sofa you're planning to buy.</p>

          <div class="sds-sofa-grid" role="group" aria-label="Sofa type selection">

            <button class="sds-choice-card" data-sofa="two-seater" aria-pressed="false">
              <div class="sds-choice-card__tick" aria-hidden="true">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <div class="sds-choice-card__icon" aria-hidden="true">
                {%- comment -%} 2-seater top-down SVG {%- endcomment -%}
                <svg viewBox="0 0 88 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="4" y="14" width="80" height="42" rx="8" fill="#e8e0d8" stroke="#A58C70" stroke-width="2"/>
                  <rect x="4" y="8" width="80" height="16" rx="6" fill="#C0B09F" stroke="#A58C70" stroke-width="1.5"/>
                  <rect x="12" y="22" width="28" height="28" rx="6" fill="#f5f0ea" stroke="#A58C70" stroke-width="1.5"/>
                  <rect x="48" y="22" width="28" height="28" rx="6" fill="#f5f0ea" stroke="#A58C70" stroke-width="1.5"/>
                  <rect x="2" y="18" width="8" height="32" rx="4" fill="#C0B09F" stroke="#A58C70" stroke-width="1.5"/>
                  <rect x="78" y="18" width="8" height="32" rx="4" fill="#C0B09F" stroke="#A58C70" stroke-width="1.5"/>
                </svg>
              </div>
              <p class="sds-choice-card__name">2-Seater</p>
              <p class="sds-choice-card__detail">140 – 160 cm wide</p>
            </button>

            <button class="sds-choice-card" data-sofa="three-seater" aria-pressed="false">
              <div class="sds-choice-card__tick" aria-hidden="true">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <div class="sds-choice-card__icon" aria-hidden="true">
                <svg viewBox="0 0 88 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="4" y="14" width="80" height="42" rx="8" fill="#e8e0d8" stroke="#A58C70" stroke-width="2"/>
                  <rect x="4" y="8" width="80" height="16" rx="6" fill="#C0B09F" stroke="#A58C70" stroke-width="1.5"/>
                  <rect x="10" y="22" width="19" height="28" rx="5" fill="#f5f0ea" stroke="#A58C70" stroke-width="1.5"/>
                  <rect x="34" y="22" width="20" height="28" rx="5" fill="#f5f0ea" stroke="#A58C70" stroke-width="1.5"/>
                  <rect x="59" y="22" width="19" height="28" rx="5" fill="#f5f0ea" stroke="#A58C70" stroke-width="1.5"/>
                  <rect x="2" y="18" width="8" height="32" rx="4" fill="#C0B09F" stroke="#A58C70" stroke-width="1.5"/>
                  <rect x="78" y="18" width="8" height="32" rx="4" fill="#C0B09F" stroke="#A58C70" stroke-width="1.5"/>
                </svg>
              </div>
              <p class="sds-choice-card__name">3-Seater</p>
              <p class="sds-choice-card__detail">190 – 220 cm wide</p>
            </button>

            <button class="sds-choice-card" data-sofa="corner" aria-pressed="false">
              <div class="sds-choice-card__tick" aria-hidden="true">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <div class="sds-choice-card__icon" aria-hidden="true">
                {%- comment -%} Corner / L-shape top-down {%- endcomment -%}
                <svg viewBox="0 0 88 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <!-- horizontal arm -->
                  <rect x="4" y="32" width="52" height="28" rx="7" fill="#e8e0d8" stroke="#A58C70" stroke-width="1.8"/>
                  <rect x="4" y="26" width="52" height="14" rx="5" fill="#C0B09F" stroke="#A58C70" stroke-width="1.5"/>
                  <rect x="10" y="40" width="20" height="16" rx="4" fill="#f5f0ea" stroke="#A58C70" stroke-width="1.3"/>
                  <rect x="34" y="40" width="18" height="16" rx="4" fill="#f5f0ea" stroke="#A58C70" stroke-width="1.3"/>
                  <!-- vertical arm -->
                  <rect x="52" y="4" width="28" height="50" rx="7" fill="#e8e0d8" stroke="#A58C70" stroke-width="1.8"/>
                  <rect x="52" y="4" width="14" height="50" rx="5" fill="#C0B09F" stroke="#A58C70" stroke-width="1.5"/>
                  <rect x="62" y="10" width="14" height="16" rx="4" fill="#f5f0ea" stroke="#A58C70" stroke-width="1.3"/>
                  <rect x="62" y="30" width="14" height="18" rx="4" fill="#f5f0ea" stroke="#A58C70" stroke-width="1.3"/>
                  <!-- corner seat -->
                  <rect x="52" y="32" width="24" height="28" rx="4" fill="#d9cec4" stroke="#A58C70" stroke-width="1.3"/>
                </svg>
              </div>
              <p class="sds-choice-card__name">Corner</p>
              <p class="sds-choice-card__detail">L-shape, 250 × 200 cm</p>
            </button>

            <button class="sds-choice-card" data-sofa="recliner" aria-pressed="false">
              <div class="sds-choice-card__tick" aria-hidden="true">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <div class="sds-choice-card__icon" aria-hidden="true">
                <svg viewBox="0 0 88 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="4" y="12" width="80" height="46" rx="8" fill="#e8e0d8" stroke="#A58C70" stroke-width="2"/>
                  <rect x="4" y="6" width="80" height="16" rx="6" fill="#C0B09F" stroke="#A58C70" stroke-width="1.5"/>
                  <rect x="12" y="22" width="28" height="30" rx="6" fill="#f5f0ea" stroke="#A58C70" stroke-width="1.5"/>
                  <rect x="48" y="22" width="28" height="30" rx="6" fill="#f5f0ea" stroke="#A58C70" stroke-width="1.5"/>
                  <!-- Footrest indication -->
                  <rect x="14" y="50" width="24" height="6" rx="3" fill="#C0B09F" stroke="#A58C70" stroke-width="1"/>
                  <rect x="50" y="50" width="24" height="6" rx="3" fill="#C0B09F" stroke="#A58C70" stroke-width="1"/>
                  <rect x="2" y="16" width="8" height="34" rx="4" fill="#C0B09F" stroke="#A58C70" stroke-width="1.5"/>
                  <rect x="78" y="16" width="8" height="34" rx="4" fill="#C0B09F" stroke="#A58C70" stroke-width="1.5"/>
                </svg>
              </div>
              <p class="sds-choice-card__name">Recliner</p>
              <p class="sds-choice-card__detail">220 – 240 cm wide</p>
            </button>

          </div>

          <div class="sds-panel__footer">
            <button class="sds-btn sds-btn--outline" data-sds-prev>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              Back
            </button>
            <button class="sds-btn sds-btn--primary" data-sds-next>
              Next: Layout
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>

        {%- comment -%}──── STEP 3: Layout ────{%- endcomment -%}
        <div class="sds-panel" id="sds-panel-3">
          <p class="sds-panel__step-num">Step 3 of 5</p>
          <h2 class="sds-panel__title">Choose Your Layout</h2>
          <p class="sds-panel__sub">How would you like the sofa to sit in your room?</p>

          <div class="sds-layout-grid" role="group" aria-label="Layout selection">

            <button class="sds-choice-card" data-layout="straight" aria-pressed="false">
              <div class="sds-choice-card__tick" aria-hidden="true">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <div class="sds-choice-card__icon" aria-hidden="true">
                <svg viewBox="0 0 80 60" fill="none">
                  <rect x="8" y="16" width="64" height="28" rx="7" fill="#e8e0d8" stroke="#A58C70" stroke-width="2"/>
                  <rect x="8" y="10" width="64" height="14" rx="5" fill="#C0B09F" stroke="#A58C70" stroke-width="1.5"/>
                </svg>
              </div>
              <p class="sds-choice-card__name">Straight</p>
              <p class="sds-choice-card__detail">Against one wall</p>
            </button>

            <button class="sds-choice-card" data-layout="lshape" aria-pressed="false">
              <div class="sds-choice-card__tick" aria-hidden="true">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <div class="sds-choice-card__icon" aria-hidden="true">
                <svg viewBox="0 0 80 60" fill="none">
                  <rect x="8" y="30" width="46" height="24" rx="6" fill="#e8e0d8" stroke="#A58C70" stroke-width="2"/>
                  <rect x="8" y="24" width="46" height="12" rx="4" fill="#C0B09F" stroke="#A58C70" stroke-width="1.5"/>
                  <rect x="50" y="8" width="24" height="44" rx="6" fill="#e8e0d8" stroke="#A58C70" stroke-width="2"/>
                  <rect x="50" y="8" width="12" height="44" rx="4" fill="#C0B09F" stroke="#A58C70" stroke-width="1.5"/>
                  <rect x="50" y="30" width="24" height="24" rx="4" fill="#d9cec4" stroke="#A58C70" stroke-width="1.5"/>
                </svg>
              </div>
              <p class="sds-choice-card__name">L-Shape</p>
              <p class="sds-choice-card__detail">Two adjoining walls</p>
            </button>

            <button class="sds-choice-card" data-layout="ushape" aria-pressed="false">
              <div class="sds-choice-card__tick" aria-hidden="true">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <div class="sds-choice-card__icon" aria-hidden="true">
                <svg viewBox="0 0 80 60" fill="none">
                  <!-- back -->
                  <rect x="8" y="8" width="64" height="14" rx="5" fill="#C0B09F" stroke="#A58C70" stroke-width="1.5"/>
                  <!-- center -->
                  <rect x="8" y="22" width="64" height="24" rx="6" fill="#e8e0d8" stroke="#A58C70" stroke-width="2"/>
                  <!-- left arm -->
                  <rect x="8" y="22" width="16" height="30" rx="5" fill="#C0B09F" stroke="#A58C70" stroke-width="1.5"/>
                  <!-- right arm -->
                  <rect x="56" y="22" width="16" height="30" rx="5" fill="#C0B09F" stroke="#A58C70" stroke-width="1.5"/>
                </svg>
              </div>
              <p class="sds-choice-card__name">U-Shape</p>
              <p class="sds-choice-card__detail">Three-sided arrangement</p>
            </button>

          </div>

          <div class="sds-panel__footer">
            <button class="sds-btn sds-btn--outline" data-sds-prev>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
