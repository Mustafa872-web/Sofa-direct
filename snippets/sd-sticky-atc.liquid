{%- comment -%}
  SD Sticky Add-to-Cart bar
  - Slides up from the bottom when the main .sd-atc-btn scrolls out of view.
  - Click delegates to the main ATC button so all variant / add-on logic is preserved.
  - Price text auto-syncs from [data-regular-price] when the user changes variant.
  - Hidden on the very first render; revealed via JS once the buy box leaves view.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign img = current_variant.featured_image | default: product.featured_image
  assign on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif
-%}

<div class="sd-sticky-atc" data-sticky-atc role="region" aria-label="Quick add to cart" aria-hidden="true">
  <div class="sd-sticky-atc__inner">

    <div class="sd-sticky-atc__product">
      {%- if img != blank -%}
        <a href="{{ product.url }}" class="sd-sticky-atc__img" aria-hidden="true" tabindex="-1">
          {{ img | image_url: width: 160 | image_tag:
            loading: 'lazy',
            widths: '80,120,160',
            sizes: '60px',
            alt: product.title
          }}
        </a>
      {%- endif -%}

      <div class="sd-sticky-atc__info">
        <p class="sd-sticky-atc__title" title="{{ product.title | escape }}">{{ product.title }}</p>
        <div class="sd-sticky-atc__price-row">
          {%- if on_sale -%}
            <span class="sd-sticky-atc__rrp" data-sticky-rrp>{{ current_variant.compare_at_price | money }}</span>
          {%- endif -%}
          <span class="sd-sticky-atc__price" data-sticky-price>{{ current_variant.price | money }}</span>
        </div>
      </div>
    </div>

    <button
      type="button"
      class="sd-sticky-atc__btn"
      data-sticky-atc-trigger
      aria-label="Add {{ product.title | escape }} to cart"
    >
      <span class="sd-sticky-atc__btn-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"/>
          <circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.6a2 2 0 0 0 2-1.6L23 6H6"/>
        </svg>
      </span>
      <span class="sd-sticky-atc__btn-label">Add to Cart</span>
    </button>

  </div>
</div>

<script>
(function () {
  var bar = document.querySelector('[data-sticky-atc]');
  if (!bar) return;

  /* Locate the real ATC button so we can delegate clicks + watch its visibility */
  var mainBtn = document.querySelector('.sd-atc-btn');
  if (!mainBtn) return;

  /* Show the bar only after the user has scrolled past the main ATC.
     IntersectionObserver fires both ways (enter/leave viewport). */
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        var pastBtn = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        bar.classList.toggle('is-visible', pastBtn);
        bar.setAttribute('aria-hidden', pastBtn ? 'false' : 'true');
      });
    }, { threshold: 0 });
    io.observe(mainBtn);
  }

  /* Forward the click to the real button (preserves variant / add-on state). */
  var trigger = bar.querySelector('[data-sticky-atc-trigger]');
  if (trigger) {
    trigger.addEventListener('click', function () {
      trigger.classList.add('is-loading');
      mainBtn.click();
      setTimeout(function () { trigger.classList.remove('is-loading'); }, 1800);
    });
  }

  /* Sync price text whenever the main price element mutates (variant change). */
  var mainPrice = document.querySelector('[data-regular-price]');
  var mainRrp   = document.querySelector('[data-compare-price]');
  var stickyPrice = bar.querySelector('[data-sticky-price]');
  var stickyRrp   = bar.querySelector('[data-sticky-rrp]');

  if (mainPrice && stickyPrice && 'MutationObserver' in window) {
    var mo = new MutationObserver(function () {
      stickyPrice.textContent = mainPrice.textContent.trim();
      if (stickyRrp && mainRrp) {
        stickyRrp.textContent = (mainRrp.textContent || '').trim();
      }
    });
    mo.observe(mainPrice, { childList: true, characterData: true, subtree: true });
    if (mainRrp) mo.observe(mainRrp, { childList: true, characterData: true, subtree: true });
  }
})();
</script>
