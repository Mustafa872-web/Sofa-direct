{% comment %}
  Renders a single Featured Product card inside the mega menu's featured column.
  Accepts:
    product — a product object (required)
{% endcomment %}
{%- if product != blank -%}
  <li>
    <a href="{{ product.url }}" class="sd-megamenu__featured-item">
      <span class="sd-megamenu__featured-img">
        {%- if product.featured_image != blank -%}
          {{-
            product.featured_image
            | image_url: width: 200
            | image_tag:
              loading: 'lazy',
              widths: '100,150,200',
              sizes: '80px',
              alt: product.featured_image.alt | default: product.title
          -}}
        {%- endif -%}
      </span>
      <span class="sd-megamenu__featured-body">
        <span class="sd-megamenu__featured-title">{{ product.title | escape }}</span>
        <span class="sd-megamenu__featured-price">
          {%- if product.price_varies -%}
            From {{ product.price_min | money }}
          {%- else -%}
            {{ product.price | money }}
          {%- endif -%}
        </span>
      </span>
    </a>
  </li>
{%- endif -%}
