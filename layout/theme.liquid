      <link rel="preload" as="style" href="{{ 'sd-hero.css' | asset_url }}">
    {%- elsif request.page_type == 'product' -%}
      <link rel="preload" as="style" href="{{ 'sd-product.css' | asset_url }}">
    {%- elsif request.page_type == 'collection' or request.page_type == 'list-collections' -%}
