<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
{% if template contains 'search' %} <meta name="robots" content="noindex, follow"> {% endif %}
    {%- comment -%} ─── Critical above-the-fold CSS — prevents ALL header/banner layout shift ─── {%- endcomment -%}
    <style>
                /* Brand vars available immediately */
                :root {
                  --sd-cream: #fffaea;
                  --sd-taupe: #c0b09f;
                  --sd-brown: #a58c70;
                  --sd-teal: #2f4858;
                  --sd-gold: #e5a41a;
                  --sd-ink: #121212;
                  --header-height: 96px; /* sensible default before JS sets exact */
                }
                /* Document-level — hide horizontal scrollbars */
                html {
                  margin: 0;
                  padding: 0;
                  max-width: 100%;
                  overflow-x: clip;
                  background: var(--sd-cream);
                }
                body {
                  margin: 0;
                  padding: 0;
                  max-width: 100%;
                  overflow-x: clip;
                  background: var(--sd-cream);
                }
                body {
                  font-family: 'Montserrat', system-ui, -apple-system, sans-serif;
                }

                /* Reserve marquee row height immediately */
                .sd-marquee {
                  min-height: 2.4rem;
                  background: var(--sd-teal);
                }
                .sd-marquee__viewport {
                  padding: 0.95rem 0;
                  min-height: 3.6rem;
                }

                /* Reserve announcement bar row height + paint background */
                .sd-ann2 {
                  min-height: 7.4rem;
                  background: #c0b09f;
                }
                .sd-ann2__inner {
                  min-height: 6rem;
                  padding: 0.9rem 2.4rem;
                }
            @media only screen and (max-width: 749px) {
                 .sd-ann2__inner {
                    min-height: unset; !important
                  }
                }
                /* Header — reserve height to prevent jump when sticky-header initializes */
                .header-wrapper {
                  min-height: 9rem;
                  background: #ffffff;
                }
                .header {
                  min-height: 9rem;
                }
                sticky-header {
                  display: block;
                }
                /* Burger menu icon — lock size before base.css loads to prevent
                   the SVG flashing at its huge intrinsic size on initial paint. */
                .header__icon--menu,
                summary.header__icon--menu,
                .header__icon--summary {
                  width: 4.4rem;
                  height: 4.4rem;
                  padding: 0;
                  display: inline-flex;
                  align-items: center;
                  justify-content: center;
                  box-sizing: border-box;
                }
                .header__icon--menu > span {
                  position: relative;
                  display: inline-block;
                  width: 2.2rem;
                  height: 2.2rem;
                }
                .header__icon--menu svg,
                .header__icon--menu .icon {
                  width: 100%;
                  height: 100%;
                  display: block;
                }
                /* Top mobile trustpilot strip — reserve */
                @media (max-width: 749px) {
                  .header-wrapper {
                    padding-top: 32px;
                    min-height: 8rem;
                  }
                  .header {
                    min-height: 6rem;
                  }
      .sd-ann2 {
          min-height: unset ;
      }
                }

                /* Page content min-height to avoid CLS while sections load */
                #MainContent {
                  min-height: 50vh;
                }

                /* content-visibility: auto was producing visible jump-ins
                   on page load — disabled. Lighthouse perf hit is small;
                   visual stability matters more. */
    </style>

    {%- comment -%}
      ─── Third-party app blocker (toggleable from Theme Editor) ───
      Controlled by Settings → Third-party Apps:
        • sd_enable_gorgias        (default OFF)
        • sd_enable_shopify_inbox  (default OFF)
        • sd_enable_klaviyo        (default ON)
        • sd_enable_cookease       (default ON)
        • sd_enable_kbite          (default ON)
      When toggled OFF in Theme Editor, a MutationObserver intercepts
      <script> / <iframe> / <link> insertions whose src/href contains
      a blocked pattern and removes them before they execute or fetch.
      CSS rules below hide any UI that slips through.
    {%- endcomment -%}
    {%- assign sd_block_gorgias  = false -%}
    {%- assign sd_block_inbox    = false -%}
    {%- assign sd_block_klaviyo  = false -%}
    {%- assign sd_block_cookease = false -%}
    {%- assign sd_block_kbite    = false -%}
    {%- unless settings.sd_enable_gorgias       -%}{%- assign sd_block_gorgias  = true -%}{%- endunless -%}
    {%- unless settings.sd_enable_shopify_inbox -%}{%- assign sd_block_inbox    = true -%}{%- endunless -%}
    {%- unless settings.sd_enable_klaviyo       -%}{%- assign sd_block_klaviyo  = true -%}{%- endunless -%}
    {%- unless settings.sd_enable_cookease      -%}{%- assign sd_block_cookease = true -%}{%- endunless -%}
    {%- unless settings.sd_enable_kbite         -%}{%- assign sd_block_kbite    = true -%}{%- endunless -%}
    {%- if sd_block_gorgias or sd_block_inbox or sd_block_klaviyo or sd_block_cookease or sd_block_kbite -%}
      <script>
        (function () {
          var patterns = [
            {%- if sd_block_gorgias  -%}'gorgias',{%- endif -%}
            {%- if sd_block_inbox    -%}'shopify-chat','inbox.shopify',{%- endif -%}
            {%- if sd_block_klaviyo  -%}'klaviyo.com','static-tracking.klaviyo','klaviyo-onsite',{%- endif -%}
            {%- if sd_block_cookease -%}'cookease','consent-manager.shopifyapps','cookieyes',{%- endif -%}
            {%- if sd_block_kbite    -%}'kbite','back-in-stock','restockrocket',{%- endif -%}
          ];
          if (!patterns.length) return;
          function isBlocked(url) {
            if (!url) return false;
            for (var i = 0; i < patterns.length; i++) {
              if (url.indexOf(patterns[i]) !== -1) return true;
            }
            return false;
          }
          /* Neutralise nodes the moment they enter the DOM */
          function scrub(node) {
            if (!node || !node.tagName) return;
            var tag = node.tagName.toLowerCase();
            var url;
            if (tag === 'script' || tag === 'iframe' || tag === 'img') {
              url = node.src || node.getAttribute('src');
            } else if (tag === 'link') {
              url = node.href || node.getAttribute('href');
            }
            if (isBlocked(url)) {
              node.type = 'javascript/blocked';
              try { node.removeAttribute('src'); } catch (e) {}
              try { node.remove(); } catch (e) {}
            }
          }
          /* Catch already-present nodes */
          document.querySelectorAll('script[src],iframe[src],link[href]')
            .forEach(scrub);
          /* Catch future insertions */
          new MutationObserver(function (muts) {
            muts.forEach(function (m) {
              m.addedNodes && m.addedNodes.forEach(scrub);
            });
          }).observe(document.documentElement, { childList: true, subtree: true });
        })();
      </script>
    

      <style>
        /* Hide any third-party UI that the script blocker didn't catch */
        {%- if sd_block_gorgias -%}
        #gorgias-chat-container,
        #chat-widget,
        iframe#chat-widget-window,
        iframe[id^="chat-widget"],
        div[id^="gorgias-chat"],
        body > div.gorgias-chat-bubble-loader { display: none !important; }
        {%- endif -%}
        {%- if sd_block_inbox -%}
        #ShopifyChat,
        iframe[id^="ShopifyChat"],
        shopify-chat,
        [data-shopify-chat] { display: none !important; }
        {%- endif -%}
        {%- if sd_block_klaviyo -%}
        .klaviyo-form,
        div[class^="kl-private-reset-css"],
        div[data-testid^="klaviyo"],
        iframe[src*="klaviyo"] { display: none !important; }
        {%- endif -%}
        {%- if sd_block_cookease -%}
        #cookease-banner,
        .cookease,
        div[id^="cookease"],
        iframe[src*="cookease"] { display: none !important; }
        {%- endif -%}
        {%- if sd_block_kbite -%}
        .kbite,
        div[id^="kbite"],
        .back-in-stock,
        iframe[src*="kbite"] { display: none !important; }
        {%- endif -%}
      </style>
    {%- endif -%}

    {%- comment -%} ─── Google Tag Manager — LAZY-LOADED on first interaction / idle to keep PageSpeed >90 ─── {%- endcomment -%}
    <link rel="dns-prefetch" href="https://www.googletagmanager.com">
    {%- comment -%}
      GA is fetched from www.google-analytics.com once GTM bootstraps,
      and from analytics.google.com for measurement-protocol calls.
      dns-prefetch costs ~0 KiB but trims the DNS step when GA actually
      fires after first user interaction.
    {%- endcomment -%}
    <link rel="dns-prefetch" href="https://www.google-analytics.com">
    <link rel="dns-prefetch" href="https://analytics.google.com">
    <script>
      (function (w, d, l, i) {
        w[l] = w[l] || [];
        var loaded = false;
        function loadGTM() {
          if (loaded) return;
          loaded = true;
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName('script')[0],
            j = d.createElement('script'),
            dl = l !== 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          f.parentNode.insertBefore(j, f);
        }
        /* Fire on FIRST user interaction OR after 4s idle — whichever comes first.
           Until then, dataLayer pushes queue up and are flushed when GTM loads. */
        ['pointerdown', 'mousemove', 'touchstart', 'keydown', 'scroll'].forEach(function (e) {
          addEventListener(e, loadGTM, { once: true, passive: true });
        });
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadGTM, { timeout: 4000 });
        } else {
          setTimeout(loadGTM, 4000);
        }
      })(window, document, 'dataLayer', 'GTM-KS9MLJ8N');
    </script>
    {%- comment -%} ─── End Google Tag Manager ─── {%- endcomment -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- comment -%} Resource hints — speed up CDN + font delivery {%- endcomment -%}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- comment -%} Early preloads for render-blocking CSS — browser discovers+fetches before the large inline style block is parsed {%- endcomment -%}
