    <link rel="preload" as="style" href="{{ 'sd-header-override.css' | asset_url }}">
    <link rel="preload" as="style" href="{{ 'sofa-direct.css' | asset_url }}">
    <link rel="preload" as="style" href="{{ 'sd-announcement-bar.css' | asset_url }}">
    {%- comment -%} Header / mega-menu CSS — preloaded so the bar paints styled, no white flash {%- endcomment -%}
    <link rel="preload" as="style" href="{{ 'component-list-menu.css' | asset_url }}">
    <link rel="preload" as="style" href="{{ 'component-search.css' | asset_url }}">
    <link rel="preload" as="style" href="{{ 'component-menu-drawer.css' | asset_url }}">
    <link rel="preload" as="style" href="{{ 'component-mega-menu.css' | asset_url }}">
    <link rel="preload" as="style" href="{{ 'sd-mega-menu.css' | asset_url }}">
